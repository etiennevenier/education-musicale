# Lu par Cloudflare (ignoré par GitHub Pages).

# Site réservé aux élèves : jamais dans les moteurs de recherche
# (complète la balise <meta name="robots"> de chaque page).
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Fichiers d'Astro dont le nom change à chaque modification : cache long.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

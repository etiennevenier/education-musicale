---
import Layout from '../../layouts/Layout.astro';

const tools = [
  {
    href: '/education-musicale/entrainement/lecture-notes',
    icon: '🎼',
    title: 'Lecture de Notes',
  },
  {
    href: '/education-musicale/entrainement/lecture-rythmique',
    icon: '🥁',
    title: 'Lecture Rythmique',
  },
  {
    href: '/education-musicale/entrainement/piano-interactif',
    icon: '🎹',
    title: 'Piano Interactif',
  },
  {
    href: '/education-musicale/entrainement/dessiner-clefs',
    icon: '✒️',
    title: 'Dessiner les Clefs',
  },
  {
    href: '/education-musicale/entrainement/clavier-notes',
    icon: '🔴',
    title: 'Identification Clavier',
  },
  {
    href: '/education-musicale/entrainement/oreille-nom',
    icon: '👂',
    title: 'Oreille — Noms',
  },
  {
    href: '/education-musicale/entrainement/oreille-clavier',
    icon: '🔔',
    title: 'Oreille — Clavier',
  },
];
---

<Layout title="Entraînement" wide backLabel="Accueil" mobileHeader="minimal">
  <div id="training-hub">
    <section class="training-header">
      <span class="training-badge">Espace autonome</span>
      <h2>Entraînement</h2>
      <p>
        Sept outils interactifs pour lire, taper, jouer, dessiner et écouter la musique à ton rythme.
      </p>
    </section>

    <div class="training-grid" id="modules">
      {tools.map((tool) => (
        <a
          href={tool.href}
          class="training-card"
          aria-label={`Ouvrir l'outil ${tool.title}`}
        >
          <span class="training-icon" aria-hidden="true">{tool.icon}</span>
          <span class="training-card-title">{tool.title}</span>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  /* Centrage global : le hub occupe toute la hauteur disponible et reste
     centré (verticalement et horizontalement), quel que soit le nombre de cartes. */
  :global(html body) {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  :global(html main.container) {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
  }

  #training-hub {
    flex: 1 1 auto;
    width: 100%;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    justify-content: safe center;
    padding: 1rem 0;
    overflow-x: hidden;
  }

  .training-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .training-badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--primary);
    background: #1e293b;
    border: 1px solid var(--border);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
  }

  .training-header h2 {
    margin: 0.75rem 0 0.4rem;
    font-size: 1.8rem;
    font-weight: 500;
    color: var(--text);
  }

  .training-header p {
    max-width: 560px;
    margin: 0 auto;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .training-grid {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 1.25rem;
  }

  .training-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    min-width: 0;
    min-height: 72px;
    padding: 1rem 1.15rem;
    text-align: left;
    text-decoration: none;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .training-card:hover {
    transform: translateY(-2px);
    border-color: var(--primary);
    box-shadow: 0 12px 24px -12px rgba(56, 189, 248, 0.55);
  }

  .training-card:active {
    transform: translateY(0);
  }

  .training-card:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .training-icon {
    font-size: 1.9rem;
    line-height: 1;
  }

  .training-card-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text);
  }

  /* Mobile et paysage bas : cartes compactes, visibles sans défilement */
  @media (max-width: 640px), (max-width: 900px) and (orientation: landscape), (max-height: 500px) {
    .training-header {
      display: none;
    }

    .training-grid {
      gap: 0.6rem;
    }

    .training-card {
      gap: 0.75rem;
      padding: 0.75rem 0.9rem;
      min-height: 56px;
    }

    .training-icon {
      font-size: 1.5rem;
    }

    .training-card-title {
      font-size: 1rem;
    }
  }
</style>

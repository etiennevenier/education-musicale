---
import Layout from '../layouts/Layout.astro';

const levels = [
  { slug: '6eme', label: '6ème' },
  { slug: '5eme', label: '5ème' },
  { slug: '4eme', label: '4ème' },
  { slug: '3eme', label: '3ème' },
];

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Choix du niveau">
  <section class="welcome">
    <h2>Sélectionnez votre niveau</h2>
  </section>

  <div class="level-grid">
    {levels.map((lvl) => (
      <a href={`${baseUrl}/${lvl.slug}`} class="level-btn">
        <span>{lvl.label}</span>
        <span class="arrow">&rarr;</span>
      </a>
    ))}
  </div>

  <section class="training-entry">
    <a href={`${baseUrl}/entrainement`} class="training-link">
      <span class="training-link-text">
        <strong>Entraînement libre</strong>
        <small>Lecture de notes, rythme, piano et tracé des clefs</small>
      </span>
      <span class="arrow" aria-hidden="true">&rarr;</span>
    </a>
  </section>
</Layout>

<style>
  .welcome {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .welcome h2 {
    font-weight: 400;
    color: var(--text-muted);
  }
  .level-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1.5rem;
  }
  .level-btn {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem 1.5rem;
    text-decoration: none;
    color: var(--text);
    font-size: 1.5rem;
    font-weight: 600;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: all 0.2s ease;
  }
  .level-btn:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
    color: var(--primary);
  }
  .arrow {
    font-size: 1.2rem;
  }
  .training-entry {
    margin-top: 2rem;
  }
  .training-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: rgba(56, 189, 248, 0.08);
    border: 1px dashed var(--primary);
    border-radius: 12px;
    color: var(--text);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .training-link:hover {
    background: rgba(56, 189, 248, 0.16);
    transform: translateY(-2px);
    color: var(--primary);
  }
  .training-link-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .training-link-text strong {
    font-size: 1.15rem;
  }
  .training-link-text small {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
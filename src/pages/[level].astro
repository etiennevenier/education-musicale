---
import Layout from '../layouts/Layout.astro';
import { siteData, getActiveSequenceIndex } from '../data/sequences';

export function getStaticPaths() {
  return [
    { params: { level: '6eme' } },
    { params: { level: '5eme' } },
    { params: { level: '4eme' } },
    { params: { level: '3eme' } },
  ];
}

const { level } = Astro.params;
const data = siteData[level];
const activeIdx = getActiveSequenceIndex(level);
const activeSeq = data.sequences[activeIdx];
---

<Layout title={data.title}>
  <div class="header">
    <h2>Classe de {data.title}</h2>
  </div>

  <div class="choices-container">
    {/* Option 1 : Séquence en cours */}
    <a href={`/${data.slug}/${activeSeq.slug}`} class="choice-card primary">
      <span class="tag">En ce moment</span>
      <span class="seq-num">Séquence {activeIdx + 1}</span>
      <h3>{activeSeq.title}</h3>
      <span class="btn-action">Accéder au cours &rarr;</span>
    </a>

    {/* Option 2 : Entraînement */}
    <a href="/autres/exercices" class="choice-card secondary">
      <span class="tag training">Espace autonome</span>
      <h3>Entraînement</h3>
      <p>Exercices, lecture de notes, vocalises & outils numériques</p>
      <span class="btn-action">&rarr;</span>
    </a>
  </div>
</Layout>

<style>
  .header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .header h2 {
    color: var(--text);
    font-weight: 500;
  }
  .choices-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .choice-card {
    border-radius: 12px;
    padding: 1.8rem;
    text-decoration: none;
    transition: all 0.2s ease;
    border: 1px solid var(--border);
    background: var(--card-bg);
    display: flex;
    flex-direction: column;
  }
  .choice-card.primary {
    background: #1e293b;
    border-color: #38bdf8;
  }
  .choice-card:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
  }
  .tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--primary);
    margin-bottom: 0.3rem;
  }
  .tag.training {
    color: var(--text-muted);
  }
  .seq-num {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .choice-card h3 {
    margin: 0.4rem 0;
    font-size: 1.5rem;
    color: #f8fafc;
  }
  .choice-card p {
    margin: 0.2rem 0 1rem 0;
    color: var(--text-muted);
  }
  .btn-action {
    margin-top: 1rem;
    font-weight: 600;
    color: var(--primary);
    align-self: flex-start;
  }
</style>
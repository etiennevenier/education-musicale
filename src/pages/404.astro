---
// Page affichée par GitHub Pages pour toute adresse inexistante (dist/404.html).
import Layout from '../layouts/Layout.astro';
import { relativeUrl } from '../utils/navigation';
---

<Layout title="Page introuvable" description="Cette page n'existe pas." noindex>
  <section class="not-found">
    <p class="note" aria-hidden="true">🎵</p>
    <h2>Oups, cette page n'existe pas</h2>
    <p class="hint">L'adresse est peut-être mal tapée, ou la page a changé de place.</p>
    <a href={relativeUrl('/')} class="home-btn">Retour aux niveaux &rarr;</a>
  </section>
</Layout>

<style>
  .not-found {
    text-align: center;
    padding: 1rem 0 2rem;
  }
  .note {
    font-size: 4rem;
    line-height: 1;
    margin: 0 0 1rem;
    color: var(--primary);
  }
  h2 {
    font-weight: 500;
    margin: 0 0 0.75rem;
  }
  .hint {
    color: var(--text-muted);
    margin: 0 0 2rem;
  }
  .home-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.75rem 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--primary);
    background: var(--card-bg);
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .home-btn:hover {
    transform: translateY(-2px);
  }
</style>

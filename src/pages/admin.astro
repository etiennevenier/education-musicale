---
import Layout from '../layouts/Layout.astro';
import { siteData } from '../data/sequences';
import { tools } from '../data/tools';
import { relativeUrl } from '../utils/navigation';
---

<Layout title="Sommaire Admin - Toutes les pages" noindex>
  <div class="admin-page">
    <h2>Sommaire technique du site</h2>
    <p class="subtitle">Page réservée au professeur pour tester toutes les URLs en un clic.</p>

    <div class="levels-grid">
      {Object.values(siteData).map((level) => (
        <section class="level-box">
          <h3>{level.title}</h3>
          <p class="level-url">
            <a href={relativeUrl(`/${level.slug}`)} target="_blank" rel="noopener noreferrer">📄 Page d'accueil du niveau (/{level.slug})</a>
          </p>
          <ul>
            {level.sequences.map((seq, idx) => (
              <li>
                <span class="num">S{idx + 1}</span>
                <a href={relativeUrl(`/${level.slug}/${seq.slug}`)} target="_blank" rel="noopener noreferrer">
                  {seq.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <section class="level-box training-box">
        <h3>Entraînement</h3>
        <p class="level-url">
          <a href={relativeUrl('/entrainement')} target="_blank" rel="noopener noreferrer">
            📄 Hub d'entraînement (/entrainement)
          </a>
        </p>
        <ul>
          {tools.map((tool) => (
            <li>
              <span class="num">{tool.icon}</span>
              <a href={relativeUrl(tool.path)} target="_blank" rel="noopener noreferrer">
                {tool.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Layout>

<style>
  .admin-page {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .subtitle {
    color: var(--text-muted);
    margin-top: -1rem;
    font-size: 0.95rem;
  }
  .levels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }
  .level-box {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.2rem;
  }
  .training-box {
    border-color: rgba(56, 189, 248, 0.45);
  }
  .level-box h3 {
    margin-top: 0;
    margin-bottom: 0.5rem;
    color: var(--primary);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
  }
  .level-url {
    margin-bottom: 1rem;
    font-size: 0.85rem;
  }
  .level-url a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .level-url a:hover {
    color: var(--primary);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
  }
  .num {
    background: #0f172a;
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }
  li a {
    color: var(--text);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  li a:hover {
    color: var(--primary);
  }
</style>
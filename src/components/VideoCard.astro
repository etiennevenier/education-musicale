---
// Standard : seuls le lecteur et le badge de catégorie sont affichés (ni titre ni description).
interface Props {
  badge?: string;
  title: string; // Libellé d'accessibilité de l'iframe uniquement
  url: string;
}

const { badge, title, url } = Astro.props;

// Transformation de l'URL standard YouTube en URL d'intégration iframe
function getEmbedUrl(youtubeUrl: string) {
  const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
  const match = youtubeUrl.match(regExp);
  return match && match[2].length === 11
    ? `https://www.youtube.com/embed/${match[2]}`
    : null;
}

const embedUrl = getEmbedUrl(url);
---

<div class="video-card">
  <div class="video-embed-container">
    {embedUrl ? (
      <iframe
        src={embedUrl}
        title={title}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
        class="video-iframe"
      ></iframe>
    ) : (
      <div class="video-placeholder">Lecteur non disponible</div>
    )}
  </div>

  <div class="video-card-content">
    {badge && <span class="video-badge">{badge}</span>}
  </div>
</div>

<style>
  .video-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s;
  }

  .video-card:hover {
    border-color: #38bdf8;
  }

  .video-embed-container {
    position: relative;
    width: 100%;
    padding-top: 56.25%; /* Ratio 16:9 */
    background: #0f172a;
  }

  .video-iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #64748b;
    font-size: 0.85rem;
  }

  .video-card-content {
    padding: 0.6rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .video-badge {
    align-self: flex-start;
    background: #0284c7;
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
  }
</style>
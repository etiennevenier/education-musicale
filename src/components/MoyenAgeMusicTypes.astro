---
import { musicTypes } from '../data/moyenAgeData';
import { relativeUrl } from '../utils/navigation';
---

<div class="music-types" id="moyen-age-music-types">
  <div class="music-tabs" role="tablist" aria-label="Les trois lieux du village médiéval">
    {musicTypes.map((musicType, index) => (
      <button
        type="button"
        role="tab"
        id={`music-tab-${musicType.id}`}
        aria-controls={`music-panel-${musicType.id}`}
        aria-selected={index === 0 ? 'true' : 'false'}
        tabindex={index === 0 ? 0 : -1}
        class:list={['music-tab', { 'is-active': index === 0 }]}
        style={`--accent: ${musicType.accent}`}
        data-tab={musicType.id}
      >
        <span class="tab-icon" aria-hidden="true">{musicType.icon}</span>
        <span class="tab-text">
          <span class="tab-place">{musicType.place}</span>
          <span class="tab-name">{musicType.name}</span>
        </span>
      </button>
    ))}
  </div>

  <div class="music-panels">
    {musicTypes.map((musicType, index) => (
      <div
        role="tabpanel"
        id={`music-panel-${musicType.id}`}
        aria-labelledby={`music-tab-${musicType.id}`}
        tabindex="0"
        class:list={['music-panel', { 'is-active': index === 0 }]}
        hidden={index !== 0}
        data-panel={musicType.id}
        style={`--accent: ${musicType.accent}`}
      >
        <div class="panel-content">
          <div class="panel-heading">
            <span class="panel-place">{musicType.icon} {musicType.place}</span>
            <h4>{musicType.name}</h4>
            <p class="panel-lead">{musicType.lead}</p>
          </div>

          <dl class="fact-grid">
            {musicType.facts.map((fact) => (
              <div class="fact-item">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>

          <div class="listening-focus">
            <span class="listening-label">🎧 À écouter</span>
            <p>{musicType.listeningFocus}</p>
          </div>

          <div
            class="audio-bar"
            data-audio-player
            data-audio-panel={musicType.id}
            data-audio-url={relativeUrl(musicType.audioUrl)}
            data-audio-title={musicType.audioTitle}
          >
            <button
              type="button"
              class="audio-toggle"
              data-audio-toggle
              aria-label={`Écouter : ${musicType.audioTitle}`}
              aria-pressed="false"
            >
              <span class="audio-icon" aria-hidden="true">▶</span>
            </button>

            <div class="audio-main">
              <span class="audio-line">
                <span class="audio-eyebrow">Écoute</span>
                <span class="audio-track">{musicType.audioTitle}</span>
              </span>
              <span
                class="audio-progress"
                data-audio-progress
                role="progressbar"
                aria-label={`Progression de l’écoute : ${musicType.audioTitle}`}
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
              >
                <span class="audio-progress-fill" data-audio-progress-fill></span>
              </span>
            </div>

            <a
              class="audio-youtube"
              href={musicType.youtubeUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Écouter l’intégralité sur YouTube ↗
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  import {
    getAudioState,
    getCurrentAudioUrl,
    onAudioEvent,
    pauseAudio,
    playAudio,
    resumeAudio,
    stopAudio,
  } from '../utils/audioManager';

  const root = document.getElementById('moyen-age-music-types');

  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    // Le composant est placé dans l'onglet principal « Les types de musique ».
    const panelContainer = root.closest<HTMLElement>('.main-panel[data-main-panel]');

    interface AudioPlayer {
      panelId: string;
      url: string;
      title: string;
      toggle: HTMLButtonElement;
      icon: HTMLElement;
      progress: HTMLElement;
      fill: HTMLElement;
    }

    const players = Array.from(root.querySelectorAll<HTMLElement>('[data-audio-player]'))
      .map((bar): AudioPlayer | null => {
        const toggle = bar.querySelector<HTMLButtonElement>('[data-audio-toggle]');
        const icon = bar.querySelector<HTMLElement>('.audio-icon');
        const progress = bar.querySelector<HTMLElement>('[data-audio-progress]');
        const fill = bar.querySelector<HTMLElement>('[data-audio-progress-fill]');
        const url = bar.dataset.audioUrl;
        const panelId = bar.dataset.audioPanel;
        const title = bar.dataset.audioTitle || '';

        if (!toggle || !icon || !progress || !fill || !url || !panelId) return null;

        return { panelId, url, title, toggle, icon, progress, fill };
      })
      .filter((player): player is AudioPlayer => player !== null);

    function sameTrack(currentUrl: string | null, expectedUrl: string): boolean {
      if (!currentUrl) return false;
      return currentUrl.normalize('NFC') === expectedUrl.normalize('NFC');
    }

    function resetProgress(player: AudioPlayer) {
      player.fill.style.width = '0%';
      player.progress.setAttribute('aria-valuenow', '0');
    }

    // Le lecteur partagé est unique : chaque panneau reflète son état réel.
    function syncPlayers() {
      const state = getAudioState();
      const currentUrl = getCurrentAudioUrl();

      players.forEach((player) => {
        const isCurrent = sameTrack(currentUrl, player.url);
        const isPlaying = isCurrent && (state === 'playing' || state === 'loading');

        player.toggle.classList.toggle('is-playing', isPlaying);
        player.toggle.setAttribute('aria-pressed', String(isPlaying));

        if (isCurrent && state === 'loading') {
          player.icon.textContent = '…';
          player.toggle.setAttribute('aria-label', `Chargement : ${player.title}`);
        } else if (isCurrent && state === 'playing') {
          player.icon.textContent = '❚❚';
          player.toggle.setAttribute('aria-label', `Mettre en pause : ${player.title}`);
        } else if (isCurrent && state === 'paused') {
          player.icon.textContent = '▶';
          player.toggle.setAttribute('aria-label', `Reprendre : ${player.title}`);
        } else {
          player.icon.textContent = '▶';
          player.toggle.setAttribute('aria-label', `Écouter : ${player.title}`);
        }

        if (!isCurrent || state === 'idle' || state === 'error') resetProgress(player);
      });
    }

    function isVisible(): boolean {
      return !panelContainer || !panelContainer.hidden;
    }

    function activePlayer(): AudioPlayer | undefined {
      const activePanel = panels.find((panel) => !panel.hidden);
      return players.find((player) => player.panelId === activePanel?.dataset.panel);
    }

    // Lance (ou reprend) la piste de l'onglet actif sans la redémarrer
    // si elle est déjà en cours de lecture.
    function startActiveTrack(force = false) {
      if (!force && !isVisible()) return;

      const player = activePlayer();
      if (!player) return;

      const state = getAudioState();
      if (sameTrack(getCurrentAudioUrl(), player.url)) {
        if (state === 'playing' || state === 'loading') return;
        if (state === 'paused') {
          void resumeAudio();
          return;
        }
      }

      void playAudio(player.url);
    }

    function activateTab(id: string, focusTab = false) {
      const currentPlayer = players.find((player) =>
        sameTrack(getCurrentAudioUrl(), player.url),
      );
      const nextPlayer = players.find((player) => player.panelId === id);

      tabs.forEach((tab) => {
        const isActive = tab.dataset.tab === id;
        tab.setAttribute('aria-selected', String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
        tab.classList.toggle('is-active', isActive);
        if (isActive && focusTab) tab.focus();
      });

      panels.forEach((panel) => {
        const isActive = panel.dataset.panel === id;
        panel.hidden = !isActive;
        panel.classList.toggle('is-active', isActive);
      });

      // Une seule piste à la fois : on coupe l'ancienne puis on lance
      // systématiquement la piste du nouvel onglet (le clic est un geste
      // utilisateur, l'autoplay est donc autorisé par le navigateur).
      if (nextPlayer && currentPlayer?.panelId !== nextPlayer.panelId) {
        if (currentPlayer) stopAudio();
        if (isVisible()) void playAudio(nextPlayer.url);
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        activateTab(tab.dataset.tab || '');
      });

      tab.addEventListener('keydown', (event) => {
        const currentIndex = tabs.indexOf(tab);
        let nextIndex: number | null = null;

        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
          nextIndex = (currentIndex + 1) % tabs.length;
        } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
          nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
        } else if (event.key === 'Home') {
          nextIndex = 0;
        } else if (event.key === 'End') {
          nextIndex = tabs.length - 1;
        }

        if (nextIndex !== null) {
          event.preventDefault();
          activateTab(tabs[nextIndex].dataset.tab || '', true);
        }
      });
    });

    players.forEach((player) => {
      player.toggle.addEventListener('click', () => {
        const state = getAudioState();
        const isCurrent = sameTrack(getCurrentAudioUrl(), player.url);

        if (isCurrent && state === 'playing') {
          pauseAudio();
          return;
        }

        if (isCurrent && state === 'paused') {
          void resumeAudio();
          return;
        }

        void playAudio(player.url);
      });
    });

    onAudioEvent('statechange', syncPlayers);

    onAudioEvent('ended', () => {
      const currentPlayer = players.find((player) =>
        sameTrack(getCurrentAudioUrl(), player.url),
      );
      if (!currentPlayer) return;

      currentPlayer.fill.style.width = '100%';
      currentPlayer.progress.setAttribute('aria-valuenow', '100');
    });

    onAudioEvent('timeupdate', ({ audio, url }) => {
      if (!audio || !url) return;

      const player = players.find((entry) => sameTrack(url, entry.url));
      if (!player) return;

      const duration = audio.duration;
      if (!Number.isFinite(duration) || duration <= 0) return;

      const percent = Math.min(100, Math.max(0, (audio.currentTime / duration) * 100));
      player.fill.style.width = `${percent}%`;
      player.progress.setAttribute('aria-valuenow', String(Math.round(percent)));
    });

    // À l'ouverture de l'onglet « Les types de musique », le clic constitue
    // le geste utilisateur qui autorise la lecture automatique.
    document
      .querySelectorAll<HTMLButtonElement>('[data-main-tab="types"]')
      .forEach((button) => {
        button.addEventListener('click', () => {
          startActiveTrack(true);
        });
      });

    // Le panneau principal peut aussi être affiché au clavier : on surveille
    // son attribut `hidden` pour lancer la piste dès qu'il devient visible,
    // et pour couper le son quand on le quitte. Si l'onglet qui s'affiche
    // propose la même piste (ex. « La notation musicale » avec ce chant
    // grégorien), la lecture se poursuit sans coupure.
    if (panelContainer) {
      const visibilityObserver = new MutationObserver(() => {
        if (panelContainer.hidden) {
          const currentPlayer = players.find((player) =>
            sameTrack(getCurrentAudioUrl(), player.url),
          );
          if (currentPlayer) {
            stopAudio();
          }
          return;
        }

        startActiveTrack();
      });

      visibilityObserver.observe(panelContainer, {
        attributes: true,
        attributeFilter: ['hidden'],
      });
    }

    syncPlayers();
  }
</script>

<style>
  .music-types {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .music-tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .music-tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border, #334155);
    border-radius: 12px;
    background: #1e293b;
    color: var(--text-muted, #94a3b8);
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .music-tab::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 1rem;
    right: 1rem;
    height: 3px;
    border-radius: 0 0 4px 4px;
    background: var(--accent);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .music-tab:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .music-tab:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .music-tab.is-active {
    border-color: var(--accent);
    background: #0f172a;
    color: var(--text, #f8fafc);
  }

  .music-tab.is-active::before {
    opacity: 1;
  }

  .tab-icon {
    font-size: 1.6rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .tab-text {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    min-width: 0;
  }

  .tab-place {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .tab-name {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text, #f8fafc);
    line-height: 1.2;
  }

  .music-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.4rem;
    border: 1px solid #334155;
    border-top: 3px solid var(--accent);
    border-radius: 14px;
    background: linear-gradient(145deg, #1e293b 0%, #0f172a 100%);
    animation: panel-in 0.25s ease;
  }

  .music-panel[hidden] {
    display: none;
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .panel-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .panel-heading {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .panel-place {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .panel-heading h4 {
    margin: 0;
    font-size: 1.45rem;
    color: var(--text, #f8fafc);
  }

  .panel-lead {
    margin: 0;
    color: #cbd5e1;
    line-height: 1.6;
  }

  .fact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
    margin: 0;
  }

  .fact-item {
    padding: 0.65rem 0.75rem;
    border: 1px solid #334155;
    border-radius: 9px;
    background: rgba(15, 23, 42, 0.6);
  }

  .fact-item dt {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.2rem;
  }

  .fact-item dd {
    margin: 0;
    color: #e2e8f0;
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .listening-focus {
    border-left: 3px solid var(--accent);
    background: rgba(15, 23, 42, 0.7);
    border-radius: 0 9px 9px 0;
    padding: 0.7rem 0.9rem;
  }

  .listening-label {
    display: block;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.2rem;
  }

  .listening-focus p {
    margin: 0;
    color: #cbd5e1;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  /* Mini-lecteur discret : une seule piste par onglet. */
  .audio-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem 0.8rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid #334155;
    border-radius: 10px;
    background: rgba(15, 23, 42, 0.7);
  }

  .audio-toggle {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--accent);
    border-radius: 50%;
    background: transparent;
    color: var(--accent);
    font-family: inherit;
    font-size: 0.7rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .audio-toggle:hover,
  .audio-toggle:focus-visible,
  .audio-toggle.is-playing {
    background: var(--accent);
    color: #0f172a;
  }

  .audio-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .audio-icon {
    font-size: 0.7rem;
    line-height: 1;
    letter-spacing: -0.08em;
  }

  .audio-main {
    display: flex;
    flex: 1 1 11rem;
    flex-direction: column;
    gap: 0.32rem;
    min-width: 0;
  }

  .audio-line {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    min-width: 0;
  }

  .audio-eyebrow {
    flex-shrink: 0;
    color: var(--accent);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .audio-track {
    overflow: hidden;
    color: #e2e8f0;
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .audio-progress {
    display: block;
    height: 3px;
    border-radius: 999px;
    background: #334155;
    overflow: hidden;
  }

  .audio-progress-fill {
    display: block;
    width: 0%;
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
    transition: width 0.15s linear;
  }

  .audio-youtube {
    /* Zone cliquable d'au moins 24 px de haut (WCAG 2.5.8), texte inchangé. */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    margin-left: auto;
    flex-shrink: 0;
    color: #94a3b8;
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: underline dotted #475569;
    text-underline-offset: 3px;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .audio-youtube:hover,
  .audio-youtube:focus-visible {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .audio-youtube:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (max-width: 760px) {
    .music-panel {
      grid-template-columns: 1fr;
    }

    .music-tabs {
      grid-template-columns: 1fr;
    }

    .fact-grid {
      grid-template-columns: 1fr;
    }

    .audio-youtube {
      margin-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .music-tab,
    .music-panel,
    .audio-toggle,
    .audio-progress-fill,
    .audio-youtube {
      transition: none;
      animation: none;
    }
  }
</style>

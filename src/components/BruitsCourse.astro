---
import VideoCard from './VideoCard.astro';
import Bruitomatic from './Bruitomatic.astro';

interface BruitsVideo {
  badge: string;
  title: string;
  youtubeId: string;
}

interface BruitsTab {
  id: string;
  label: string;
  kind?: 'videos' | 'bruitomatic';
  videos: BruitsVideo[];
}

const tabs: BruitsTab[] = [
  {
    id: 'cours',
    label: 'Cours',
    videos: [
      { badge: 'Capsule', title: 'Capsule', youtubeId: 'KtgRKIxcDqA' },
      { badge: 'Projet musical', title: 'Projet musical', youtubeId: 'cmSbXsFE3l8' },
      { badge: 'Projet musical', title: 'Projet musical', youtubeId: 'pjcOzqxu4JQ' },
      { badge: 'Écoute', title: 'Écoute', youtubeId: 'Nxgm27oWu3s' },
    ],
  },
  {
    id: 'fo-plafonds',
    label: "Les Fo'Plafonds",
    videos: [
      { badge: 'Écoute', title: "Les Fo'Plafonds", youtubeId: 'B4PSvN3VSyI' },
      { badge: 'Écoute', title: "Les Fo'Plafonds", youtubeId: '73jJLspL8o8' },
      { badge: 'Écoute', title: "Les Fo'Plafonds", youtubeId: 'g-syAK7WIXE' },
      { badge: 'Écoute', title: "Les Fo'Plafonds", youtubeId: 'X0jnvck_hr8' },
    ],
  },
  {
    id: 'stomp',
    label: 'Stomp',
    videos: [
      { badge: 'Écoute', title: 'Stomp', youtubeId: 'tZ7aYQtIldg' },
      { badge: 'Écoute', title: 'Stomp', youtubeId: '93t6bCnAvk4' },
      { badge: 'Écoute', title: 'Stomp', youtubeId: '7NhFmARAgu0' },
      { badge: 'Écoute', title: 'Stomp', youtubeId: 'lU4lVmQxHeI' },
    ],
  },
  {
    id: 'bruitomatic',
    label: 'Bruitomatic',
    kind: 'bruitomatic',
    videos: [],
  },
];
---

<div class="bruits-course">
  <div class="bruits-tabs" role="tablist" aria-label="Musique et Bruits">
    {tabs.map((tab, index) => (
      <button
        type="button"
        role="tab"
        id={`bruits-tab-${tab.id}`}
        class="bruits-tab"
        aria-controls={`bruits-panel-${tab.id}`}
        aria-selected={index === 0 ? 'true' : 'false'}
        tabindex={index === 0 ? 0 : -1}
        data-tab={tab.id}
      >
        {tab.label}
      </button>
    ))}
  </div>

  {tabs.map((tab, index) => (
    <div
      role="tabpanel"
      id={`bruits-panel-${tab.id}`}
      class="bruits-panel"
      aria-labelledby={`bruits-tab-${tab.id}`}
      hidden={index !== 0}
      data-panel={tab.id}
    >
      {tab.kind === 'bruitomatic' ? (
        <Bruitomatic />
      ) : (
        <div class="bruits-videos">
          {tab.videos.map((video) => (
            <VideoCard
              badge={video.badge}
              title={video.title}
              url={`https://www.youtube.com/watch?v=${video.youtubeId}`}
            />
          ))}
        </div>
      )}
    </div>
  ))}
</div>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.bruits-tab');

  const selectTab = (tab: HTMLButtonElement) => {
    const root = tab.closest('.bruits-course');
    if (!root) return;

    root.querySelectorAll<HTMLButtonElement>('.bruits-tab').forEach((item) => {
      const isActive = item === tab;
      item.setAttribute('aria-selected', isActive ? 'true' : 'false');
      item.tabIndex = isActive ? 0 : -1;
    });

    root.querySelectorAll<HTMLElement>('.bruits-panel').forEach((panel) => {
      panel.hidden = panel.dataset.panel !== tab.dataset.tab;
    });

    document.dispatchEvent(
      new CustomEvent('bruits:tab-change', { detail: { tab: tab.dataset.tab } }),
    );
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectTab(tab));
    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      event.preventDefault();
      const nextIndex =
        event.key === 'ArrowRight'
          ? (index + 1) % tabs.length
          : (index - 1 + tabs.length) % tabs.length;
      tabs[nextIndex].focus();
      selectTab(tabs[nextIndex]);
    });
  });
</script>

<style>
  .bruits-course {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .bruits-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .bruits-tab {
    flex: 1 1 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 1.25rem;
    border-radius: 12px;
    border: 1px solid var(--border, #334155);
    background: #1e293b;
    color: var(--text-muted, #94a3b8);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
  }

  .bruits-tab::before {
    font-size: 1.1rem;
    line-height: 1;
  }

  .bruits-tab[data-tab='cours']::before {
    content: '🎬';
  }

  .bruits-tab[data-tab='fo-plafonds']::before {
    content: '🎤';
  }

  .bruits-tab[data-tab='stomp']::before {
    content: '🥁';
  }

  .bruits-tab[data-tab='bruitomatic']::before {
    content: '🥁';
  }

  .bruits-tab:hover {
    border-color: var(--primary, #38bdf8);
    color: var(--text, #f1f5f9);
  }

  .bruits-tab[aria-selected='true'] {
    border-color: var(--primary, #38bdf8);
    color: var(--text, #f1f5f9);
    box-shadow: 0 0 0 1px var(--primary, #38bdf8), 0 0 16px rgba(56, 189, 248, 0.25);
  }

  .bruits-tab:focus-visible {
    outline: 2px solid var(--primary, #38bdf8);
    outline-offset: 2px;
  }

  .bruits-panel[hidden] {
    display: none;
  }

  .bruits-videos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
</style>

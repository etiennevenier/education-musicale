---
import { hymneQuizList } from '../data/hymnesData';
import '../styles/quiz-card.css';
---

<div class="quiz-card hymne-quiz-card">
  <div class="fuzeau-header">
    <span class="badge">Écoute &amp; Analyse</span>
    <h4>Jeu : Hymne ou Pas Hymne ?</h4>
  </div>

  <!-- Progression de la partie -->
  <div id="hqProgressBox" class="progress-box">
    <div class="progress-text">
      <span id="hqProgressLabel">Question 1 / {hymneQuizList.length}</span>
      <span id="hqScoreLabel" class="score-label">Score : 0</span>
    </div>
    <div class="progress-bar"><div id="hqProgressFill" class="progress-fill"></div></div>
  </div>

  <!-- Zone de Question Dynamique -->
  <div id="hqQuestionContainer" class="question-container"></div>

  <!-- Zone de Choix / Réponses -->
  <div id="hqOptionsContainer" class="options-binary"></div>

  <div id="hqQuizFeedback" class="feedback-msg hidden" role="status" aria-live="polite"></div>

  <!-- Validation & Suivant -->
  <div id="hqActionFooter" class="action-footer">
    <button id="hqBtnNext" class="btn-next" disabled>Question Suivante ➔</button>
  </div>

  <!-- Écran de résultat final -->
  <div id="hqResultContainer" class="result-container hidden"></div>
</div>

<script>
  import { renderNextButton, renderProgress } from '../utils/quizUi';
  import { shuffle } from '../utils/random';
  import type { ResultMessages } from '../utils/quiz';
  import { hymneQuizList } from '../data/hymnesData';
  import type { HymneQuizItem } from '../data/hymnesData';
  import { buildResultHtml, getAutoNextDelay, getResultMessage } from '../utils/quiz';

  const ANSWERS = [
    { value: true, label: "👥 C'est un Hymne (Collectif)" },
    { value: false, label: '👤 Pas un Hymne (Chanson personnelle)' },
  ];
    const RESULT_MESSAGES: ResultMessages = {
    perfect: { emoji: '🏆', text: 'Parfait ! Tu sais exactement ce qui fait un hymne !' },
    great: { emoji: '🌟', text: 'Excellent travail, tu distingues très bien les hymnes des chansons personnelles !' },
    ok: { emoji: '👍', text: 'Bien joué ! Encore un petit effort pour progresser.' },
    retry: { emoji: '💪', text: "Continue à t'entraîner, tu vas y arriver !" },
  };

  let currentQuestion: HymneQuizItem | null = null;
  let isAnswered = false;

  // État de la partie
  let queue: HymneQuizItem[] = [];
  let questionIndex = 0;
  let score = 0;

  // Passage automatique à la question suivante après une BONNE réponse uniquement
  let autoNextTimer: ReturnType<typeof setTimeout> | null = null;

  function clearAutoNext() {
    if (autoNextTimer) {
      clearTimeout(autoNextTimer);
      autoNextTimer = null;
    }
  }

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const progressBox = $<HTMLDivElement>('hqProgressBox');
  const progressLabel = $<HTMLSpanElement>('hqProgressLabel');
  const scoreLabel = $<HTMLSpanElement>('hqScoreLabel');
  const progressFill = $<HTMLDivElement>('hqProgressFill');
  const questionContainer = $<HTMLDivElement>('hqQuestionContainer');
  const optionsContainer = $<HTMLDivElement>('hqOptionsContainer');
  const quizFeedback = $<HTMLDivElement>('hqQuizFeedback');
  const actionFooter = $<HTMLDivElement>('hqActionFooter');
  const resultContainer = $<HTMLDivElement>('hqResultContainer');
  const btnNext = $<HTMLButtonElement>('hqBtnNext');

  function setFeedback(kind: 'success' | 'error' | null, text = '') {
    quizFeedback.textContent = text;
    quizFeedback.className = kind ? `feedback-msg ${kind}` : 'feedback-msg hidden';
  }

  /** Bascule entre l'écran de jeu et l'écran de résultat. */
  function showQuizScreen(visible: boolean) {
    [progressBox, questionContainer, optionsContainer, actionFooter].forEach((el) =>
      el.classList.toggle('hidden', !visible),
    );
    resultContainer.classList.toggle('hidden', visible);
  }

  // --- Progression et score ----------------------------------------------

  function updateProgress() {
    renderProgress(
      { progressLabel, scoreLabel, progressFill },
      { unit: 'question', index: questionIndex, total: queue.length, score, answered: isAnswered },
    );
  }

  function updateNextButton() {
    renderNextButton(btnNext, { unit: 'question', isLast: questionIndex >= queue.length - 1, answered: isAnswered });
  }

  // --- Boutons de réponse ------------------------------------------------

  function buildOptions() {
    ANSWERS.forEach((answer) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn-option';
      btn.dataset.value = String(answer.value);
      btn.textContent = answer.label;
      btn.addEventListener('click', () => {
        if (isAnswered || !currentQuestion) return;
        optionsContainer.querySelectorAll<HTMLButtonElement>('.btn-option').forEach((b) => (b.disabled = true));
        checkAnswer(answer.value === currentQuestion.isHymn, btn);
      });
      optionsContainer.appendChild(btn);
    });
  }

  // --- Partie : démarrage, questions, résultat ---------------------------

  function startGame() {
    clearAutoNext();
    score = 0;
    questionIndex = 0;

    queue = shuffle(hymneQuizList);

    resultContainer.innerHTML = '';
    showQuizScreen(true);

    loadQuestion();
  }

  function loadQuestion() {
    clearAutoNext();
    isAnswered = false;
    setFeedback(null);

    const q = queue[questionIndex];
    currentQuestion = q;
    updateProgress();
    updateNextButton();

    questionContainer.innerHTML = `
      <div class="situation-q-box">
        <p class="situation-label">Cette situation, est-ce un hymne ?</p>
        <p class="situation-text"></p>
      </div>
    `;
    questionContainer.querySelector('.situation-text')!.textContent = q.text;

    optionsContainer.innerHTML = '';
    optionsContainer.className = 'options-binary';
    buildOptions();
  }

  function checkAnswer(isCorrect: boolean, element: HTMLElement) {
    if (isAnswered || !currentQuestion) return;
    isAnswered = true;

    if (isCorrect) {
      score++;
      element.classList.add('correct');
      const message = `✨ Bravo ! ${currentQuestion.explanation}`;
      setFeedback('success', message);
      autoNextTimer = setTimeout(goToNext, getAutoNextDelay(message));
    } else {
      element.classList.add('incorrect');
      const good = optionsContainer.querySelector<HTMLElement>(
        `.btn-option[data-value="${String(currentQuestion.isHymn)}"]`
      );
      if (good) good.classList.add('correct');
      setFeedback('error', `❌ Dommage ! ${currentQuestion.explanation}`);
    }

    updateProgress();
    updateNextButton();
  }

    function showResult() {
    const total = queue.length;
    const { emoji, text } = getResultMessage(score, total, RESULT_MESSAGES);

    showQuizScreen(false);
    setFeedback(null);
    resultContainer.innerHTML = buildResultHtml({
      emoji,
      text,
      score,
      total,
      restartId: 'hqBtnRestart',
    });
    $<HTMLButtonElement>('hqBtnRestart').addEventListener('click', startGame);
  }

  // --- Événements ---------------------------------------------------------

  function goToNext() {
    clearAutoNext();
    if (!isAnswered) return;
    if (questionIndex >= queue.length - 1) {
      showResult();
    } else {
      questionIndex++;
      loadQuestion();
    }
  }

  btnNext.addEventListener('click', goToNext);

  startGame();
</script>

<style is:global>
  .quiz-card .situation-label {
    color: #94a3b8;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .quiz-card .question-container .situation-text {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.5;
    color: #f8fafc;
  }

  /* --- Boutons de réponse (hymne) --- */
  

  

    
</style>
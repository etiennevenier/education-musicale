---
import { hymneQuizList } from '../data/hymnesData';
import '../styles/quiz-card.css';
---

<div class="quiz-card hymne-quiz-card">
  <div class="fuzeau-header">
    <span class="badge">Écoute &amp; Analyse</span>
    <h4>Jeu : Hymne ou Pas Hymne ?</h4>
  </div>

  <!-- Progression de la partie -->
  <div id="hqProgressBox" class="progress-box">
    <div class="progress-text">
      <span id="hqProgressLabel">Question 1 / {hymneQuizList.length}</span>
      <span id="hqScoreLabel" class="score-label">Score : 0</span>
    </div>
    <div class="progress-bar"><div id="hqProgressFill" class="progress-fill"></div></div>
  </div>

  <!-- Zone de Question Dynamique -->
  <div id="hqQuestionContainer" class="question-container"></div>

  <!-- Zone de Choix / Réponses -->
  <div id="hqOptionsContainer" class="options-binary"></div>

  <div id="hqQuizFeedback" class="feedback-msg hidden"></div>

  <!-- Validation & Suivant -->
  <div id="hqActionFooter" class="action-footer">
    <button id="hqBtnNext" class="btn-next" disabled>Question Suivante ➔</button>
  </div>

  <!-- Écran de résultat final -->
  <div id="hqResultContainer" class="result-container hidden"></div>
</div>

<script>
  import { shuffle } from '../utils/random';
  import { hymneQuizList } from '../data/hymnesData';
  import type { HymneQuizItem } from '../data/hymnesData';

  const ANSWERS = [
    { value: true, label: "👥 C'est un Hymne (Collectif)" },
    { value: false, label: '👤 Pas un Hymne (Chanson personnelle)' },
  ];

  let currentQuestion: HymneQuizItem | null = null;
  let isAnswered = false;

  // État de la partie
  let queue: HymneQuizItem[] = [];
  let questionIndex = 0;
  let score = 0;

  // Passage automatique à la question suivante après une BONNE réponse uniquement
  const AUTO_NEXT_DELAY = 1200; // en millisecondes
  let autoNextTimer: ReturnType<typeof setTimeout> | null = null;

  function clearAutoNext() {
    if (autoNextTimer) {
      clearTimeout(autoNextTimer);
      autoNextTimer = null;
    }
  }

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const progressBox = $<HTMLDivElement>('hqProgressBox');
  const progressLabel = $<HTMLSpanElement>('hqProgressLabel');
  const scoreLabel = $<HTMLSpanElement>('hqScoreLabel');
  const progressFill = $<HTMLDivElement>('hqProgressFill');
  const questionContainer = $<HTMLDivElement>('hqQuestionContainer');
  const optionsContainer = $<HTMLDivElement>('hqOptionsContainer');
  const quizFeedback = $<HTMLDivElement>('hqQuizFeedback');
  const actionFooter = $<HTMLDivElement>('hqActionFooter');
  const resultContainer = $<HTMLDivElement>('hqResultContainer');
  const btnNext = $<HTMLButtonElement>('hqBtnNext');

  // --- Utilitaires -------------------------------------------------------

  // --- Progression et score ----------------------------------------------

  function updateProgress() {
    const total = queue.length;
    progressLabel.textContent = `Question ${questionIndex + 1} / ${total}`;
    scoreLabel.textContent = `Score : ${score}`;
    // La barre avance quand la question est répondue
    const done = questionIndex + (isAnswered ? 1 : 0);
    progressFill.style.width = `${(done / total) * 100}%`;
  }

  function updateNextButton() {
    const isLast = questionIndex >= queue.length - 1;
    btnNext.textContent = isLast ? '🏁 Voir mon score' : 'Question Suivante ➔';
    btnNext.disabled = !isAnswered;
  }

  // --- Boutons de réponse ------------------------------------------------

  function buildOptions() {
    ANSWERS.forEach(answer => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn-option';
      btn.dataset.value = String(answer.value);
      btn.textContent = answer.label;
      btn.addEventListener('click', () => {
        if (isAnswered || !currentQuestion) return;
        optionsContainer.querySelectorAll<HTMLButtonElement>('.btn-option').forEach(b => (b.disabled = true));
        checkAnswer(answer.value === currentQuestion.isHymn, btn);
      });
      optionsContainer.appendChild(btn);
    });
  }

  // --- Partie : démarrage, questions, résultat ---------------------------

  function startGame() {
    clearAutoNext();
    score = 0;
    questionIndex = 0;

    // Les 15 situations, chacune une seule fois, dans un ordre aléatoire
    queue = shuffle(hymneQuizList);

    resultContainer.classList.add('hidden');
    resultContainer.innerHTML = '';
    progressBox.classList.remove('hidden');
    questionContainer.classList.remove('hidden');
    optionsContainer.classList.remove('hidden');
    actionFooter.classList.remove('hidden');

    loadQuestion();
  }

  function loadQuestion() {
    clearAutoNext();
    isAnswered = false;
    quizFeedback.className = 'feedback-msg hidden';

    const q = queue[questionIndex];
    currentQuestion = q;
    updateProgress();
    updateNextButton();

    questionContainer.innerHTML = `
      <div class="situation-q-box">
        <p class="situation-label">Cette situation, est-ce un hymne ?</p>
        <p class="situation-text"></p>
      </div>
    `;
    // textContent : le texte de la situation est affiché tel quel (pas d'HTML interprété)
    questionContainer.querySelector('.situation-text')!.textContent = q.text;

    optionsContainer.innerHTML = '';
    optionsContainer.className = 'options-binary';
    buildOptions();
  }

  function checkAnswer(isCorrect: boolean, element: HTMLElement) {
    if (isAnswered || !currentQuestion) return;
    isAnswered = true;

    if (isCorrect) {
      score++;
      element.classList.add('correct');
      quizFeedback.textContent = `✨ Bravo ! ${currentQuestion.explanation}`;
      quizFeedback.className = 'feedback-msg success';
      autoNextTimer = setTimeout(goToNext, AUTO_NEXT_DELAY);
    } else {
      element.classList.add('incorrect');
      // On montre aussi la bonne réponse pour que l'élève fasse le lien avec l'explication
      const good = optionsContainer.querySelector<HTMLElement>(
        `.btn-option[data-value="${String(currentQuestion.isHymn)}"]`
      );
      if (good) good.classList.add('correct');
      quizFeedback.textContent = `❌ Dommage ! ${currentQuestion.explanation}`;
      quizFeedback.className = 'feedback-msg error';
    }

    updateProgress();
    updateNextButton();
  }

  function getResultMessage(note: number, total: number) {
    const ratio = note / total;
    if (ratio === 1) return { emoji: '🏆', text: 'Parfait ! Tu sais exactement ce qui fait un hymne !' };
    if (ratio >= 0.8) return { emoji: '🌟', text: 'Excellent travail, tu distingues très bien les hymnes des chansons personnelles !' };
    if (ratio >= 0.5) return { emoji: '👍', text: 'Bien joué ! Encore un petit effort pour progresser.' };
    return { emoji: '💪', text: "Continue à t'entraîner, tu vas y arriver !" };
  }

  function showResult() {
    const total = queue.length;
    const { emoji, text } = getResultMessage(score, total);

    progressBox.classList.add('hidden');
    questionContainer.classList.add('hidden');
    optionsContainer.classList.add('hidden');
    actionFooter.classList.add('hidden');
    quizFeedback.className = 'feedback-msg hidden';

    resultContainer.innerHTML = `
      <div class="result-emoji">${emoji}</div>
      <p class="result-title">Partie terminée !</p>
      <p class="result-score"><span class="result-note">${score}</span> / ${total}</p>
      <p class="result-text">${text}</p>
      <button id="hqBtnRestart" class="btn-restart">🔄 Recommencer</button>
    `;
    resultContainer.classList.remove('hidden');
    $<HTMLButtonElement>('hqBtnRestart').addEventListener('click', startGame);
  }

  // --- Événements ---------------------------------------------------------

  // Utilisé par le bouton « Suivant » ET par le minuteur après une bonne réponse
  function goToNext() {
    clearAutoNext();
    if (!isAnswered) return;
    if (questionIndex >= queue.length - 1) {
      showResult();
    } else {
      questionIndex++;
      loadQuestion();
    }
  }

  btnNext.addEventListener('click', goToNext);

  startGame();
</script>

<!--
  is:global est indispensable : Astro "scope" les styles avec un attribut
  data-astro-cid ajouté uniquement aux éléments du template. Les éléments créés par
  le script (boutons de réponse, texte de la situation, écran de résultat) ne l'ont pas
  et ne recevraient aucun style. Tous les sélecteurs sont préfixés par .quiz-card
  pour ne pas affecter le reste du site. Ce CSS reprend celui de TimbreQuiz /
  PlansSonoresQuiz ; seul le bloc « Boutons de réponse (hymne) » est propre à ce
  composant (classe .options-binary, distincte de .options-text de PlansSonoresQuiz
  pour éviter tout conflit si les deux composants sont sur la même page).
-->
<style is:global>
  .quiz-card {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 100%;
    overflow: hidden;
    box-sizing: border-box;
    container-type: inline-size;
  }

  .quiz-card * {
    box-sizing: border-box;
  }

  .quiz-card .hidden {
    display: none !important;
  }

  .quiz-card .fuzeau-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .quiz-card .badge {
    background: #e11d48;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .quiz-card .fuzeau-header h4 {
    margin: 0;
    color: #f1f5f9;
    font-size: 1.1rem;
  }

  /* --- Progression --- */
  .quiz-card .progress-box {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .quiz-card .progress-text {
    display: flex;
    justify-content: space-between;
    color: #cbd5e1;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .quiz-card .score-label {
    color: #38bdf8;
  }

  .quiz-card .progress-bar {
    height: 8px;
    background: #1e293b;
    border-radius: 999px;
    overflow: hidden;
  }

  .quiz-card .progress-fill {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, #0284c7, #38bdf8);
    border-radius: 999px;
    transition: width 0.3s ease;
  }

  .quiz-card .question-container {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.25rem;
    text-align: center;
    overflow: hidden;
    color: #f1f5f9;
  }

  .quiz-card .question-container p {
    margin: 0 0 0.75rem;
  }

  .quiz-card .situation-label {
    color: #94a3b8;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .quiz-card .question-container .situation-text {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.5;
    color: #f8fafc;
  }

  /* --- Boutons de réponse (hymne) : même style que les boutons de PlansSonoresQuiz --- */
  .quiz-card .options-binary {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    width: 100%;
  }

  @container (min-width: 700px) {
    .quiz-card .options-binary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .quiz-card .btn-option {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 64px;
    padding: 0.75rem 1rem;
    background: #1e293b;
    color: #f8fafc;
    border: 2px solid #475569;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 700;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s;
  }

  .quiz-card .btn-option:hover:not(:disabled) {
    border-color: #38bdf8;
    transform: scale(1.02);
  }

  .quiz-card .btn-option:disabled {
    cursor: default;
  }

  .quiz-card .btn-option.correct {
    background: #064e3b;
    border-color: #10b981;
    color: #a7f3d0;
    box-shadow: 0 0 10px #10b981;
  }

  .quiz-card .btn-option.incorrect {
    background: #881337;
    border-color: #f43f5e;
    color: #fecdd3;
    box-shadow: 0 0 10px #f43f5e;
  }

  .quiz-card .action-footer {
    display: flex;
    justify-content: flex-end;
  }

  .quiz-card .btn-next {
    background: #334155;
    color: #f1f5f9;
    border: none;
    padding: 0.6rem 1.2rem;
    border-radius: 6px;
    font-weight: 700;
    cursor: pointer;
  }

  .quiz-card .btn-next:hover:not(:disabled) {
    background: #475569;
  }

  .quiz-card .btn-next:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .quiz-card .feedback-msg {
    padding: 0.75rem;
    border-radius: 6px;
    font-weight: 700;
    text-align: center;
  }

  .quiz-card .feedback-msg.success {
    background: #064e3b;
    color: #a7f3d0;
  }

  .quiz-card .feedback-msg.error {
    background: #881337;
    color: #fecdd3;
  }

  /* --- Écran de résultat --- */
  .quiz-card .result-container {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 2rem 1.25rem;
    text-align: center;
    color: #f1f5f9;
  }

  .quiz-card .result-emoji {
    font-size: 3rem;
    line-height: 1;
  }

  .quiz-card .result-title {
    margin: 0.75rem 0 0.25rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: #cbd5e1;
  }

  .quiz-card .result-score {
    margin: 0 0 0.5rem;
    font-size: 1.6rem;
    font-weight: 800;
  }

  .quiz-card .result-note {
    font-size: 3rem;
    color: #38bdf8;
  }

  .quiz-card .result-text {
    margin: 0 0 1.25rem;
    color: #e2e8f0;
  }

  .quiz-card .btn-restart {
    background: #0284c7;
    color: #fff;
    border: none;
    padding: 0.75rem 1.75rem;
    border-radius: 6px;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
  }

  .quiz-card .btn-restart:hover {
    background: #0369a1;
  }
</style>

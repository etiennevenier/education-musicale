---
import {
  PUB_CATEGORIES,
  PUB_QUIZ_LENGTH,
  PUB_SOUNDS,
  type PubCategory,
} from '../data/pubSounds';

const categoryGroups = (
  Object.entries(PUB_CATEGORIES) as [PubCategory, { label: string; icon: string }][]
).map(([id, meta]) => ({
  id,
  ...meta,
  sounds: PUB_SOUNDS.filter((sound) => sound.category === id),
}));

const choiceLetters = ['A', 'B', 'C', 'D'] as const;
---

<div class="quiz-musique-pub" data-quiz-musique-pub>
  <header class="pub-header">
    <div class="pub-heading">
      <p class="pub-kicker">📻 Culture pub</p>
      <h3>Musique &amp; Publicité</h3>
      <p class="pub-intro">Teste ton oreille avec un quiz de {PUB_QUIZ_LENGTH} extraits.</p>
    </div>
  </header>

  <div class="pub-tabs" role="tablist" aria-label="Sections du module" style="display: none;">
    <button
      type="button"
      class="pub-tab"
      id="pub-tab-soundboard"
      role="tab"
      aria-selected="true"
      aria-controls="pub-panel-soundboard"
      tabindex="0"
      data-tab="soundboard"
    >
      <span aria-hidden="true">🎚️</span>
      Écoute &amp; Catalogue
    </button>
    <button
      type="button"
      class="pub-tab"
      id="pub-tab-quiz"
      role="tab"
      aria-selected="false"
      aria-controls="pub-panel-quiz"
      tabindex="-1"
      data-tab="quiz"
    >
      <span aria-hidden="true">🎯</span>
      Blindtest ({PUB_QUIZ_LENGTH} questions)
    </button>
  </div>

  <section
    class="pub-panel"
    id="pub-panel-soundboard"
    role="tabpanel"
    aria-labelledby="pub-tab-soundboard"
    data-panel="soundboard"
  >
    <div class="soundboard-intro">
      <p>
        Clique sur un extrait pour l'écouter. Un nouveau son coupe automatiquement le
        précédent.
      </p>
      <p class="soundboard-status" data-audio-status aria-live="polite" aria-atomic="true"></p>
    </div>

    <div class="sound-groups">
      {
        categoryGroups.map((group) => (
          <section class="sound-group" aria-labelledby={`pub-group-${group.id}`}>
            <div class="sound-group-head">
              <h4 id={`pub-group-${group.id}`}>
                <span aria-hidden="true">{group.icon}</span>
                {group.label}
              </h4>
              <span class="sound-group-count">{group.sounds.length}</span>
            </div>

            <div class="sound-grid">
              {group.sounds.map((sound) => (
                <button
                  type="button"
                  class="sound-button"
                  data-audio-trigger
                  data-audio-url={sound.audioUrl}
                  data-audio-label={sound.label}
                  aria-label={`Écouter l'extrait ${sound.label}`}
                  aria-pressed="false"
                >
                  <span class="sound-play" data-play-icon aria-hidden="true">
                    ▶
                  </span>
                  <span class="sound-text">
                    <span class="sound-name">{sound.label}</span>
                    <span class="sound-file" title={sound.file}>
                      {sound.file}
                    </span>
                  </span>
                </button>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>

  <section
    class="pub-panel"
    id="pub-panel-quiz"
    role="tabpanel"
    aria-labelledby="pub-tab-quiz"
    data-panel="quiz"
  >
    <div class="quiz-shell">
      <div class="quiz-top">
        <div class="quiz-hud">
          <span class="quiz-counter" data-question-counter>
            Question 1 / {PUB_QUIZ_LENGTH}
          </span>
          <span class="quiz-score" data-score>Score : 0</span>
        </div>
        <div class="quiz-progress" aria-hidden="true">
          <span data-quiz-progress></span>
        </div>
      </div>

      <div class="quiz-body" data-quiz-body>
        <p class="quiz-prompt">De quelle publicité s'agit-il ?</p>

        <button
          type="button"
          class="quiz-audio-button"
          data-audio-trigger
          data-quiz-play
          data-audio-label="audio de la question"
          aria-label="Écouter l'extrait audio de la question"
          aria-pressed="false"
        >
          <span class="quiz-audio-icon" data-play-icon aria-hidden="true">▶</span>
          <span data-play-label>Écouter l'extrait</span>
        </button>

        <div class="quiz-choices" data-quiz-choices>
          {
            choiceLetters.map((letter, index) => (
              <button
                type="button"
                class="quiz-choice"
                data-choice-index={index}
                data-correct="false"
                disabled
              >
                <span class="quiz-choice-letter" aria-hidden="true">
                  {letter}
                </span>
                <span class="quiz-choice-label" data-choice-label>
                  —
                </span>
              </button>
            ))
          }
        </div>

        <p
          class="quiz-feedback"
          data-quiz-feedback
          aria-live="polite"
          aria-atomic="true"
        ></p>
      </div>

      <div class="quiz-result" data-quiz-result hidden>
        <p class="quiz-result-kicker">Bilan du quiz</p>
        <p class="quiz-result-score">
          <span data-result-score>0 / {PUB_QUIZ_LENGTH}</span>
        </p>
        <p class="quiz-result-message" data-result-message></p>
        <div class="quiz-result-actions">
          <button type="button" class="quiz-action quiz-action-primary" data-quiz-replay>
            Rejouer
          </button>
        </div>
      </div>
    </div>
  </section>

  <noscript>
    <p class="pub-noscript">Ce module interactif nécessite JavaScript.</p>
  </noscript>
</div>

<script>
  import { audioManager } from '../utils/audioManager';
  import {
    PUB_QUIZ_LENGTH,
    PUB_SOUNDS,
    type PubSoundEntry,
  } from '../data/pubSounds';

  interface QuizChoice {
    label: string;
    correct: boolean;
  }

  interface QuizQuestion {
    sound: PubSoundEntry;
    choices: QuizChoice[];
  }

  function shuffle<T>(items: readonly T[]): T[] {
    const result = [...items];

    for (let index = result.length - 1; index > 0; index -= 1) {
      const randomIndex = Math.floor(Math.random() * (index + 1));
      const current = result[index];
      result[index] = result[randomIndex] as T;
      result[randomIndex] = current as T;
    }

    return result;
  }

  /**
   * Construit 10 questions. Les leurres viennent d'abord de la même catégorie
   * que la bonne réponse, puis d'autres catégories si nécessaire.
   */
  function createQuiz(): QuizQuestion[] {
    return shuffle(PUB_SOUNDS)
      .slice(0, PUB_QUIZ_LENGTH)
      .map((sound) => {
        const sameCategory = shuffle(
          PUB_SOUNDS.filter(
            (candidate) => candidate.category === sound.category && candidate.id !== sound.id,
          ),
        );
        const otherCategories = shuffle(
          PUB_SOUNDS.filter((candidate) => candidate.category !== sound.category),
        );

        const distractors = sameCategory.slice(0, 3);
        if (distractors.length < 3) {
          distractors.push(...otherCategories.slice(0, 3 - distractors.length));
        }

        return {
          sound,
          choices: shuffle([sound, ...distractors]).map((candidate) => ({
            label: candidate.label,
            correct: candidate.id === sound.id,
          })),
        };
      });
  }

  function initQuizMusiquePub(): void {
    const root = document.querySelector<HTMLElement>('[data-quiz-musique-pub]');
    if (!root) return;

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const soundboard = root.querySelector<HTMLElement>('[data-panel="soundboard"]');
    const quizBody = root.querySelector<HTMLElement>('[data-quiz-body]');
    const quizResult = root.querySelector<HTMLElement>('[data-quiz-result]');
    const questionCounter = root.querySelector<HTMLElement>('[data-question-counter]');
    const scoreLabel = root.querySelector<HTMLElement>('[data-score]');
    const progressBar = root.querySelector<HTMLElement>('[data-quiz-progress]');
    const quizPlay = root.querySelector<HTMLButtonElement>('[data-quiz-play]');
    const quizFeedback = root.querySelector<HTMLElement>('[data-quiz-feedback]');
    const replayButton = root.querySelector<HTMLButtonElement>('[data-quiz-replay]');
    const audioStatus = root.querySelector<HTMLElement>('[data-audio-status]');
    const resultScore = root.querySelector<HTMLElement>('[data-result-score]');
    const resultMessage = root.querySelector<HTMLElement>('[data-result-message]');
    const choiceButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-choice-index]'),
    );
    const triggers = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-audio-trigger]'),
    );

    if (
      !soundboard ||
      !quizBody ||
      !quizResult ||
      !questionCounter ||
      !scoreLabel ||
      !progressBar ||
      !quizPlay ||
      !quizFeedback ||
      !replayButton ||
      !audioStatus ||
      !resultScore ||
      !resultMessage ||
      choiceButtons.length !== 4 ||
      tabs.length === 0
    ) {
      return;
    }

    let quizQuestions: QuizQuestion[] = [];
    let questionIndex = 0;
    let score = 0;
    let isAnswered = false;
    let advanceTimer: number | null = null;

    const activateTab = (name: string, focusTab = false): void => {
      tabs.forEach((tab) => {
        const selected = tab.dataset.tab === name;
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.tabIndex = selected ? 0 : -1;
        if (selected && focusTab) tab.focus();
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== name;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        const name = tab.dataset.tab;
        if (name) activateTab(name);
      });

      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();

        let nextIndex = index;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = tabs.length - 1;

        const nextTab = tabs[nextIndex];
        const name = nextTab?.dataset.tab;
        if (name) activateTab(name, true);
      });
    });

    const syncPlaybackUI = (): void => {
      const state = audioManager.getState();
      const currentUrl = audioManager.getCurrentUrl();

      triggers.forEach((button) => {
        const url = button.dataset.audioUrl;
        const active = Boolean(url && currentUrl && url === currentUrl);
        const isPlaying = active && state === 'playing';
        const isLoading = active && state === 'loading';
        const isPaused = active && state === 'paused';

        button.classList.toggle('is-playing', isPlaying);
        button.classList.toggle('is-loading', isLoading);
        button.classList.toggle('is-paused', isPaused);
        button.setAttribute('aria-pressed', isPlaying ? 'true' : 'false');
        button.setAttribute('aria-busy', isLoading ? 'true' : 'false');

        const icon = button.querySelector<HTMLElement>('[data-play-icon]');
        if (icon) icon.textContent = isLoading ? '…' : isPlaying ? '⏸' : '▶';

        const label = button.querySelector<HTMLElement>('[data-play-label]');
        if (label) label.textContent = isPlaying ? 'Mettre en pause' : "Écouter l'extrait";

        const name = button.dataset.audioLabel;
        if (name) {
          button.setAttribute(
            'aria-label',
            isPlaying
              ? `Mettre en pause l'extrait ${name}`
              : `Écouter l'extrait ${name}`,
          );
        }
      });

      if (state === 'playing' && currentUrl) {
        const activeTrigger = triggers.some(
          (button) => button.dataset.audioUrl === currentUrl,
        );
        if (!activeTrigger) audioStatus.textContent = '';
      }
    };

    const toggleAudio = (url: string, label: string): void => {
      const state = audioManager.getState();
      const currentUrl = audioManager.getCurrentUrl();

      if (currentUrl === url && state === 'playing') {
        audioManager.pauseAudio();
        audioStatus.textContent = `En pause : ${label}`;
        return;
      }

      if (currentUrl === url && state === 'paused') {
        void audioManager.resumeAudio();
        audioStatus.textContent = `Lecture : ${label}`;
        return;
      }

      void audioManager.playAudio(url);
      audioStatus.textContent = `Lecture : ${label}`;
    };

    soundboard.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const button = target.closest<HTMLButtonElement>('[data-audio-trigger]');
      if (!button || !soundboard.contains(button)) return;

      const url = button.dataset.audioUrl;
      if (!url) return;

      toggleAudio(url, button.dataset.audioLabel ?? 'cet extrait');
    });

    quizPlay.addEventListener('click', () => {
      const question = quizQuestions[questionIndex];
      if (!question) return;
      toggleAudio(question.sound.audioUrl, "l'extrait de la question");
    });

    audioManager.on('statechange', ({ state }) => {
      syncPlaybackUI();
      if (state === 'idle' || state === 'ended') {
        audioStatus.textContent = '';
      }
    });

    audioManager.on('error', () => {
      audioStatus.textContent = 'Impossible de lire cet extrait audio.';
    });

    const getResultMessage = (points: number, total: number): string => {
      if (points === total) {
        return 'Sans faute ! Tu connais le catalogue sur le bout des oreilles.';
      }
      if (points >= Math.ceil(total * 0.7)) {
        return 'Excellent ! Tu reconnais presque tous les jingles du catalogue.';
      }
      if (points >= Math.ceil(total * 0.4)) {
        return 'Pas mal ! Encore quelques extraits à réécouter pour progresser.';
      }
      return "Continue à explorer le catalogue : ton oreille va vite s'affûter.";
    };

    const renderQuestion = (autoplay = false): void => {
      const question = quizQuestions[questionIndex];
      if (!question) return;

      isAnswered = false;
      quizFeedback.textContent = '';
      delete quizFeedback.dataset.state;
      questionCounter.textContent = `Question ${questionIndex + 1} / ${quizQuestions.length}`;
      scoreLabel.textContent = `Score : ${score}`;
      progressBar.style.width = `${((questionIndex + 1) / quizQuestions.length) * 100}%`;

      quizPlay.dataset.audioUrl = question.sound.audioUrl;
      quizPlay.disabled = false;

      choiceButtons.forEach((button, index) => {
        const choice = question.choices[index];
        const label = button.querySelector<HTMLElement>('[data-choice-label]');
        if (label) label.textContent = choice?.label ?? '—';

        button.dataset.correct = choice?.correct ? 'true' : 'false';
        button.classList.remove('is-correct', 'is-wrong');
        button.disabled = !choice;
        button.setAttribute('aria-disabled', choice ? 'false' : 'true');
      });

      syncPlaybackUI();

      if (autoplay) void audioManager.playAudio(question.sound.audioUrl);
    };

    const finishQuiz = (): void => {
      if (advanceTimer !== null) {
        window.clearTimeout(advanceTimer);
        advanceTimer = null;
      }

      audioManager.stopAudio();
      questionCounter.textContent = `Question ${quizQuestions.length} / ${quizQuestions.length}`;
      scoreLabel.textContent = `Score : ${score}`;
      progressBar.style.width = '100%';
      quizBody.hidden = true;
      quizResult.hidden = false;
      resultScore.textContent = `${score} / ${quizQuestions.length}`;
      resultMessage.textContent = getResultMessage(score, quizQuestions.length);
      replayButton.focus();
    };

    const handleAnswer = (choiceIndex: number): void => {
      if (isAnswered) return;

      const question = quizQuestions[questionIndex];
      const choice = question?.choices[choiceIndex];
      if (!question || !choice) return;

      isAnswered = true;
      audioManager.stopAudio();
      quizPlay.disabled = true;

      if (choice.correct) score += 1;
      scoreLabel.textContent = `Score : ${score}`;

      choiceButtons.forEach((button, index) => {
        const currentChoice = question.choices[index];
        button.disabled = true;
        button.setAttribute('aria-disabled', 'true');
        button.classList.toggle('is-correct', Boolean(currentChoice?.correct));
        button.classList.toggle('is-wrong', index === choiceIndex && !choice.correct);
      });

      quizFeedback.dataset.state = choice.correct ? 'success' : 'danger';
      quizFeedback.textContent = choice.correct
        ? '✅ Bonne réponse !'
        : `❌ Raté ! C'était ${question.sound.label}.`;

      advanceTimer = window.setTimeout(
        () => {
          advanceTimer = null;
          if (questionIndex + 1 >= quizQuestions.length) {
            finishQuiz();
            return;
          }

          questionIndex += 1;
          renderQuestion(true);
        },
        choice.correct ? 1100 : 1800,
      );
    };

    const startQuiz = (focusQuiz = false): void => {
      if (advanceTimer !== null) {
        window.clearTimeout(advanceTimer);
        advanceTimer = null;
      }

      audioManager.stopAudio();
      quizQuestions = createQuiz();
      questionIndex = 0;
      score = 0;
      isAnswered = false;
      quizBody.hidden = false;
      quizResult.hidden = true;
      renderQuestion(focusQuiz);
      if (focusQuiz) quizPlay.focus();
    };

    choiceButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const index = Number(button.dataset.choiceIndex);
        if (Number.isInteger(index)) handleAnswer(index);
      });
    });

    replayButton.addEventListener('click', () => startQuiz(true));

    syncPlaybackUI();
    startQuiz();
    activateTab('quiz');
  }

  initQuizMusiquePub();

</script>

<style>
  .quiz-musique-pub {
    --pub-accent: #f59e0b;
    --pub-accent-strong: #fbbf24;
    --pub-accent-soft: rgba(245, 158, 11, 0.14);
    --pub-green: #4ade80;
    --pub-red: #f87171;
    --pub-border: #334155;
    --pub-text: #e2e8f0;
    --pub-muted: #94a3b8;

    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    padding: 1.25rem;
    background:
      radial-gradient(circle at top left, rgba(245, 158, 11, 0.09), transparent 32rem),
      linear-gradient(180deg, rgba(30, 41, 59, 0.75), rgba(15, 23, 42, 0.96));
    border: 1px solid var(--pub-border);
    border-radius: 18px;
    color: var(--pub-text);
  }

  .quiz-musique-pub [hidden] {
    display: none !important;
  }

  .pub-noscript {
    margin: 0;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--pub-border);
    border-radius: 9px;
    background: #0b1220;
    color: var(--pub-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .pub-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .pub-heading {
    min-width: 0;
  }

  .pub-kicker {
    margin: 0;
    color: var(--pub-accent-strong);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pub-heading h3 {
    margin: 0.25rem 0 0.35rem;
    color: #f8fafc;
    font-size: clamp(1.25rem, 2.6vw, 1.55rem);
    line-height: 1.2;
  }

  .pub-intro {
    margin: 0;
    max-width: 62ch;
    color: var(--pub-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .pub-tabs {
    display: flex;
    gap: 0.35rem;
    padding: 0.3rem;
    overflow-x: auto;
    background: #0b1220;
    border: 1px solid var(--pub-border);
    border-radius: 999px;
    scrollbar-width: thin;
  }

  .pub-tab {
    flex: 1 1 0;
    min-width: max-content;
    padding: 0.65rem 0.9rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--pub-muted);
    font: inherit;
    font-size: 0.84rem;
    font-weight: 800;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
  }

  .pub-tab:hover {
    background: rgba(51, 65, 85, 0.4);
    color: #f8fafc;
  }

  .pub-tab[aria-selected='true'] {
    background: var(--pub-accent);
    color: #1c1917;
    box-shadow: 0 6px 16px rgba(245, 158, 11, 0.22);
  }

  .pub-tab:focus-visible {
    outline: 2px solid var(--pub-accent-strong);
    outline-offset: 2px;
  }

  .pub-panel {
    min-width: 0;
  }

  .soundboard-intro {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-bottom: 0.9rem;
  }

  .soundboard-intro p {
    margin: 0;
    max-width: 68ch;
    color: var(--pub-muted);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .soundboard-status {
    min-height: 1.25em;
    color: var(--pub-accent-strong);
    font-weight: 700;
  }

  .sound-groups {
    display: grid;
    gap: 0.9rem;
  }

  .sound-group {
    padding: 0.9rem;
    background: rgba(15, 23, 42, 0.52);
    border: 1px solid var(--pub-border);
    border-radius: 12px;
  }

  .sound-group-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
  }

  .sound-group-head h4 {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    color: #f1f5f9;
    font-size: 0.9rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .sound-group-count {
    flex-shrink: 0;
    min-width: 1.65rem;
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--pub-border);
    border-radius: 999px;
    color: var(--pub-muted);
    font-size: 0.7rem;
    font-weight: 800;
    text-align: center;
  }

  .sound-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.5rem;
  }

  .sound-button {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    padding: 0.55rem 0.6rem;
    border: 1px solid var(--pub-border);
    border-radius: 9px;
    background: #0b1220;
    color: #cbd5e1;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.18s ease, background 0.18s ease, color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .sound-button:hover {
    border-color: #64748b;
    color: #f8fafc;
  }

  .sound-button.is-playing {
    border-color: var(--pub-accent);
    background: var(--pub-accent-soft);
    color: #fef3c7;
    box-shadow: 0 0 0 1px var(--pub-accent) inset;
  }

  .sound-button.is-paused {
    border-color: var(--pub-accent);
  }

  .sound-button:focus-visible {
    outline: 2px solid var(--pub-accent-strong);
    outline-offset: 2px;
  }

  .sound-play {

---
import { CARDS_PER_GAME } from '../utils/recyclageEvaluation';

interface TechniqueOption {
  id: 'reprise' | 'sample' | 'remix';
  emoji: string;
  label: string;
  hint: string;
}

interface CriterionOption {
  id: 'oeuvreLibre' | 'enregistrementLibre' | 'exception' | 'accord';
  label: string;
  shortLabel: string;
}

const techniques: TechniqueOption[] = [
  { id: 'reprise', emoji: '🎤', label: 'Reprise (Cover)', hint: 'On réenregistre soi-même' },
  {
    id: 'sample',
    emoji: '🎧',
    label: 'Sample / Citation',
    hint: "Court extrait de l'enregistrement d'origine",
  },
  {
    id: 'remix',
    emoji: '🎛️',
    label: 'Remix / Adaptation',
    hint: 'On retravaille un morceau entier',
  },
];

const criteria: CriterionOption[] = [
  {
    id: 'oeuvreLibre',
    label: "L'œuvre originale est dans le domaine public (auteur mort depuis plus de 70 ans)",
    shortLabel: 'Œuvre dans le domaine public',
  },
  {
    id: 'enregistrementLibre',
    label: "L'enregistrement d'origine est libre ou réenregistré par nos soins",
    shortLabel: 'Enregistrement libre ou réenregistré',
  },
  {
    id: 'exception',
    label: "C'est une exception légale (parodie, courte citation)",
    shortLabel: 'Exception légale',
  },
  {
    id: 'accord',
    label: "L'accord des ayants droit a été obtenu",
    shortLabel: 'Accord des ayants droit',
  },
];

const slots = Array.from({ length: CARDS_PER_GAME }, (_, index) => index);
---

<div class="recycling-nuancier" data-nuancier>
  <header class="nuancier-header">
    <div class="nuancier-heading">
      <p class="nuancier-kicker">♻️ Atelier interactif</p>
      <h3>Le Nuancier du Recyclage Musical</h3>
      <p class="nuancier-intro">
        Huit situations de recyclage musical. Pour chacune, identifie la technique utilisée puis
        coche les critères juridiques qui s'appliquent : ton verdict se déduit de tes cases cochées.
      </p>
    </div>
    <button type="button" class="nuancier-reset" data-reset-session>
      🔄 Nouvelle session
    </button>
  </header>

  <div class="nuancier-status">
    <span class="status-progress" data-progress-label>Carte 1 / {CARDS_PER_GAME}</span>
    <ol class="nuancier-dots" data-dots aria-hidden="true">
      {slots.map((index) => (
        <li class="nuancier-dot" data-dot={index} data-state="pending">
          {index + 1}
        </li>
      ))}
    </ol>
    <span class="status-score" data-score-label>Analyses réussies : 0 / {CARDS_PER_GAME}</span>
  </div>

  <ol class="nuancier-deck" data-deck>
    {slots.map((index) => (
      <li class="nuancier-card" data-card={index} data-card-state="pending" tabindex="-1" hidden>
        <header class="card-head">
          <p class="card-step" data-card-step>Carte {index + 1} / {CARDS_PER_GAME}</p>
          <p class="card-kicker">Étudie la situation</p>
        </header>

        <p class="card-scenario" data-card-text></p>

        <fieldset class="card-block">
          <legend>Étape A — Technique artistique</legend>
          <div class="technique-options">
            {techniques.map((technique) => (
              <button
                type="button"
                class="technique-option"
                data-technique={technique.id}
                aria-pressed="false"
              >
                <span class="technique-emoji" aria-hidden="true">{technique.emoji}</span>
                <span class="technique-label">{technique.label}</span>
                <span class="technique-hint">{technique.hint}</span>
              </button>
            ))}
          </div>
        </fieldset>

        <fieldset class="card-block">
          <legend>Étape B — Diagnostic juridique</legend>
          <div class="criteria-list">
            {criteria.map((criterion) => (
              <label class="criterion">
                <input type="checkbox" data-criterion={criterion.id} />
                <span class="criterion-text">
                  <span class="criterion-label">{criterion.label}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="card-actions">
          <button type="button" class="validate-button" data-validate disabled>
            Valider mon analyse
          </button>
        </div>

        <div class="card-feedback" data-feedback data-state="pending" hidden>
          <p class="feedback-badge" data-feedback-badge></p>
          <p class="feedback-title" data-feedback-title></p>
          <p class="feedback-verdict" data-feedback-verdict></p>

          <ul class="feedback-diff">
            {criteria.map((criterion) => (
              <li class="diff-row" data-diff-row={criterion.id} data-state="pending">
                <span class="diff-icon" data-diff-icon aria-hidden="true">•</span>
                <span class="diff-label">{criterion.shortLabel}</span>
                <span class="diff-values" data-diff-values></span>
              </li>
            ))}
          </ul>

          <p class="feedback-error" data-feedback-error hidden></p>
          <p class="feedback-explain" data-feedback-explain></p>
          <button type="button" class="feedback-next" data-next hidden>Carte suivante →</button>
        </div>
      </li>
    ))}
  </ol>


  <section class="nuancier-summary" data-summary hidden>
    <p class="summary-kicker">🏁 Fin de la session</p>
    <h4>Bilan du Nuancier</h4>
    <p class="summary-score" data-summary-score></p>

    <ul class="summary-list">
      {slots.map((index) => (
        <li class="summary-row" data-summary-row={index} data-state="pending" hidden>
          <span class="summary-index">{index + 1}</span>
          <span class="summary-text" data-summary-text></span>
          <span class="summary-result" data-summary-result></span>
        </li>
      ))}
    </ul>

    <button type="button" class="nuancier-reset" data-restart>
      🔄 Rejouer avec un nouveau tirage
    </button>
  </section>

  <p class="sr-only" role="status" aria-live="polite" data-live></p>

  <div class="tribunal" data-tribunal hidden>
    <div class="tribunal-backdrop" data-tribunal-close></div>
    <div
      class="tribunal-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="tribunal-title"
      aria-describedby="tribunal-lead"
      data-tribunal-dialog
      tabindex="-1"
    >
      <p class="tribunal-kicker">⚖️ Alerte juridique</p>
      <h4 id="tribunal-title">Tribunal / Sanction pour Contrefaçon</h4>
      <p class="tribunal-lead" id="tribunal-lead">
        Tu as classé cette situation comme autorisée, mais elle constitue une contrefaçon.
      </p>

      <ul class="tribunal-penalties">
        <li><span aria-hidden="true">🔒</span> Jusqu'à <strong>3 ans d'emprisonnement</strong></li>
        <li><span aria-hidden="true">💸</span> Jusqu'à <strong>300 000 € d'amende</strong></li>
      </ul>
      <p class="tribunal-source">
        Peines encourues au titre de la contrefaçon (art. L335-2 du Code de la propriété
        intellectuelle).
      </p>

      <p class="tribunal-label">La situation</p>
      <p class="tribunal-case" data-tribunal-case></p>

      <p class="tribunal-label">L'erreur d'analyse</p>
      <p class="tribunal-error" data-tribunal-error></p>

      <p class="tribunal-label">Ce que dit la loi</p>
      <p class="tribunal-explain" data-tribunal-explain></p>

      <button type="button" class="tribunal-close" data-tribunal-close>
        J'ai compris, continuer
      </button>
    </div>
  </div>
</div>

<script>
  import type { Scenario } from '../data/recyclageData';
  const { estLegal, getBalancedDeck, SCENARIOS, TECHNIQUE_LABELS } = await import('../data/recyclageData');
  import {
    buildNotes,
    CARDS_PER_GAME,
    CRITERION_IDS,
    createAnswer,
    getExpectedCriteria,
    getFeedbackTitle,
    isCriterionId,
    isTechniqueId,
    validateAnswer,
    type Answer,
    type Validation,
  } from '../utils/recyclageEvaluation';

  const plural = (count: number, singular: string, pluralForm = `${singular}s`) =>
    `${count} ${count > 1 ? pluralForm : singular}`;

  const root = document.querySelector<HTMLElement>('[data-nuancier]');

  if (root) {
    const cardElements = Array.from(root.querySelectorAll<HTMLElement>('[data-card]'));
    const dotElements = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
    const summaryRows = Array.from(root.querySelectorAll<HTMLElement>('[data-summary-row]'));
    const progressLabel = root.querySelector<HTMLElement>('[data-progress-label]');
    const scoreLabel = root.querySelector<HTMLElement>('[data-score-label]');
    const summary = root.querySelector<HTMLElement>('[data-summary]');
    const summaryScore = root.querySelector<HTMLElement>('[data-summary-score]');
    const liveRegion = root.querySelector<HTMLElement>('[data-live]');
    const resetButton = root.querySelector<HTMLButtonElement>('[data-reset-session]');
    const restartButton = root.querySelector<HTMLButtonElement>('[data-restart]');
    const tribunal = root.querySelector<HTMLElement>('[data-tribunal]');
    const tribunalDialog = root.querySelector<HTMLElement>('[data-tribunal-dialog]');
    const tribunalCase = root.querySelector<HTMLElement>('[data-tribunal-case]');
    const tribunalError = root.querySelector<HTMLElement>('[data-tribunal-error]');
    const tribunalExplain = root.querySelector<HTMLElement>('[data-tribunal-explain]');
    const tribunalCloseTargets = Array.from(
      root.querySelectorAll<HTMLElement>('[data-tribunal-close]'),
    );

    let deck: Scenario[] = [];
    let answers: Answer[] = [];
    let currentIndex = 0;
    let lastFocused: HTMLElement | null = null;

    const labelFor = (technique: Scenario['technique']): string => TECHNIQUE_LABELS[technique];

    const renderFeedback = (
      card: HTMLElement,
      scenario: Scenario,
      answer: Answer,
      validation: Validation,
      notes: string[],
    ) => {
      const feedback = card.querySelector<HTMLElement>('[data-feedback]');
      if (!feedback) return;

      feedback.hidden = false;
      feedback.dataset.state = validation.success
        ? validation.criteriaOk
          ? 'success'
          : 'partial'
        : 'danger';

      const badge = feedback.querySelector<HTMLElement>('[data-feedback-badge]');
      if (badge) {
        badge.textContent = validation.success ? '✅ Recyclage validé' : '❌ Analyse à corriger';
      }

      const title = feedback.querySelector<HTMLElement>('[data-feedback-title]');
      if (title) title.textContent = getFeedbackTitle(validation);

      const verdict = feedback.querySelector<HTMLElement>('[data-feedback-verdict]');
      if (verdict) {
        const chosenTechnique = answer.technique ? labelFor(answer.technique) : 'aucune';
        const actualLabel = validation.actualLegal ? 'autorisé' : 'interdit (contrefaçon)';
        const studentLabel = validation.studentLegal ? 'autorisé' : 'interdit';
        verdict.textContent =
          `Ce cas est ${actualLabel}. Tu l'as classé comme ${studentLabel} avec la technique ` +
          `« ${chosenTechnique} » (attendue : ${labelFor(scenario.technique)}).`;
      }

      const checks = getExpectedCriteria(scenario);

      CRITERION_IDS.forEach((criterionId) => {
        const row = feedback.querySelector<HTMLElement>(`[data-diff-row="${criterionId}"]`);
        if (!row) return;

        const chosen = answer.criteria[criterionId];
        const expected = checks[criterionId];
        row.dataset.state = chosen === expected ? 'ok' : chosen ? 'wrong' : 'missed';

        const icon = row.querySelector<HTMLElement>('[data-diff-icon]');
        if (icon) icon.textContent = chosen === expected ? '✓' : chosen ? '✕' : '!';

        const values = row.querySelector<HTMLElement>('[data-diff-values]');
        if (values) {
          let expectedLabel = expected ? 'oui' : 'non';
          if (criterionId === 'exception' && scenario.exception !== null) {
            expectedLabel = `oui (${scenario.exception})`;
          }
          values.textContent = `coché : ${chosen ? 'oui' : 'non'} · attendu : ${expectedLabel}`;
        }
      });

      const errorElement = feedback.querySelector<HTMLElement>('[data-feedback-error]');
      if (errorElement) {
        errorElement.textContent = notes.join('\n');
        errorElement.hidden = notes.length === 0;
      }

      const explain = feedback.querySelector<HTMLElement>('[data-feedback-explain]');
      if (explain) {
        explain.textContent = `Ce que dit la loi : ${scenario.explication}`;
      }
    };

    const openTribunal = (scenario: Scenario, notes: string[], explanation: string) => {
      if (!tribunal || !tribunalDialog) return;

      lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      if (tribunalCase) tribunalCase.textContent = scenario.texte;
      if (tribunalError) {
        tribunalError.textContent =
          notes.length > 0
            ? notes.join('\n')
            : 'Ton diagnostic a conclu à la légalité alors que cette situation est interdite.';
      }
      if (tribunalExplain) tribunalExplain.textContent = explanation;

      tribunal.hidden = false;
      tribunalDialog.focus();
    };

    const closeTribunal = () => {
      if (!tribunal) return;
      tribunal.hidden = true;

      const card = cardElements[currentIndex];
      const next = card?.querySelector<HTMLButtonElement>('[data-next]');
      if (next) next.focus();
      else lastFocused?.focus();
      lastFocused = null;
    };

    const resetCard = (card: HTMLElement, scenario: Scenario, index: number) => {
      card.dataset.cardState = 'pending';

      const step = card.querySelector<HTMLElement>('[data-card-step]');
      if (step) step.textContent = `Carte ${index + 1} / ${deck.length}`;

      const text = card.querySelector<HTMLElement>('[data-card-text]');
      if (text) text.textContent = scenario.texte;

      card.querySelectorAll<HTMLButtonElement>('[data-technique]').forEach((button) => {
        button.disabled = false;
        button.classList.remove('is-selected');
        button.setAttribute('aria-pressed', 'false');
      });

      card.querySelectorAll<HTMLInputElement>('[data-criterion]').forEach((input) => {
        input.checked = false;
        input.disabled = false;
      });

      const validate = card.querySelector<HTMLButtonElement>('[data-validate]');
      if (validate) {
        validate.disabled = true;
        validate.hidden = false;
      }

      const feedback = card.querySelector<HTMLElement>('[data-feedback]');
      if (feedback) {
        feedback.hidden = true;
        feedback.dataset.state = 'pending';
      }

      const next = card.querySelector<HTMLButtonElement>('[data-next]');
      if (next) next.hidden = true;
    };

    const updateStatus = () => {
      const total = deck.length;
      if (progressLabel) {
        progressLabel.textContent =
          total === 0 ? 'Aucune carte' : `Carte ${Math.min(currentIndex + 1, total)} / ${total}`;
      }

      const successes = answers.filter((answer) => answer.success).length;
      if (scoreLabel) scoreLabel.textContent = `Analyses réussies : ${successes} / ${total}`;

      dotElements.forEach((dot, index) => {
        const answer = answers[index];
        dot.dataset.state = answer?.success ? 'success' : answer?.validated ? 'danger' : 'pending';
        dot.dataset.current = index === currentIndex ? 'true' : 'false';
      });
    };

    const showCard = (index: number, options: { focus?: boolean; scroll?: boolean } = {}) => {
      const { focus = true, scroll = true } = options;
      currentIndex = index;

      cardElements.forEach((card, cardIndex) => {
        card.hidden = cardIndex !== index || cardIndex >= deck.length;
      });

      updateStatus();

      const card = cardElements[index];
      if (!card || !focus) return;
      card.focus({ preventScroll: true });
      if (scroll) card.scrollIntoView({ block: 'nearest' });
    };

    const validateCard = (index: number) => {
      const scenario = deck[index];
      const answer = answers[index];
      const card = cardElements[index];
      if (!scenario || !answer || !card || answer.validated || !answer.technique) return;

      answer.validated = true;

      const validation = validateAnswer(scenario, answer);
      const { success, actualLegal, studentLegal } = validation;

      answer.success = success;
      card.dataset.cardState = success ? 'success' : 'danger';

      const notes = buildNotes(scenario, answer, validation);

      card.querySelectorAll<HTMLButtonElement>('[data-technique]').forEach((button) => {
        button.disabled = true;
      });
      card.querySelectorAll<HTMLInputElement>('[data-criterion]').forEach((input) => {
        input.disabled = true;
      });

      const validateButton = card.querySelector<HTMLButtonElement>('[data-validate]');
      if (validateButton) validateButton.hidden = true;

      renderFeedback(card, scenario, answer, validation, notes);
      updateStatus();

      const next = card.querySelector<HTMLButtonElement>('[data-next]');
      if (next) {
        next.hidden = false;
        next.textContent = index === deck.length - 1 ? 'Voir le bilan →' : 'Carte suivante →';
      }

      if (liveRegion) {
        liveRegion.textContent = success
          ? `Carte ${index + 1} validée.`
          : `Carte ${index + 1} à revoir.`;
      }

      if (!actualLegal && studentLegal) {
        openTribunal(scenario, notes, scenario.explication);
      }
    };

    const showSummary = () => {
      cardElements.forEach((card) => {
        card.hidden = true;
      });
      dotElements.forEach((dot) => {
        dot.dataset.current = 'false';
      });
      if (summary) summary.hidden = false;

      const successCount = answers.filter((answer) => answer.success).length;
      const illegalCount = deck.filter((scenario) => !estLegal(scenario)).length;
      if (summaryScore) {
        summaryScore.textContent =
          `${successCount} / ${deck.length} analyses réussies · ` +
          `${plural(illegalCount, 'situation')} de contrefaçon dans ce tirage.`;
      }

      summaryRows.forEach((row, index) => {
        const scenario = deck[index];
        const answer = answers[index];
        if (!scenario || !answer) {
          row.hidden = true;
          return;
        }

        row.hidden = false;
        row.dataset.state = answer.success ? 'success' : 'danger';

        const text = row.querySelector<HTMLElement>('[data-summary-text]');
        if (text) {
          text.textContent = `${labelFor(scenario.technique)} — ${scenario.texte}`;
        }

        const result = row.querySelector<HTMLElement>('[data-summary-result]');
        if (result) {
          result.textContent = answer.success ? '✓ Réussi' : '✗ À revoir';
        }
      });

      if (progressLabel) progressLabel.textContent = 'Session terminée';
      if (liveRegion) {
        liveRegion.textContent = `Bilan : ${successCount} analyses réussies sur ${deck.length}.`;
      }
      summary?.scrollIntoView({ block: 'nearest' });
    };

    const goNext = () => {
      if (currentIndex < deck.length - 1) {
        showCard(currentIndex + 1);
        return;
      }
      showSummary();
    };

    const startSession = () => {
      deck = getBalancedDeck(SCENARIOS, CARDS_PER_GAME);
      answers = deck.map(() => createAnswer());
      currentIndex = 0;

      if (summary) summary.hidden = true;
      if (tribunal) tribunal.hidden = true;

      dotElements.forEach((dot, index) => {
        dot.hidden = index >= deck.length;
        dot.dataset.state = 'pending';
        dot.dataset.current = 'false';
      });

      cardElements.forEach((card, index) => {
        const scenario = deck[index];
        if (!scenario) {
          card.hidden = true;
          return;
        }
        resetCard(card, scenario, index);
        card.hidden = index !== 0;
      });

      summaryRows.forEach((row, index) => {
        row.hidden = index >= deck.length;
        row.dataset.state = 'pending';
      });

      showCard(0, { focus: false, scroll: false });

      if (liveRegion) {
        liveRegion.textContent = `Nouvelle session : ${deck.length} cartes à analyser.`;
      }
    };

    const requestNewSession = () => {
      const started = answers.some((answer) => answer.validated || answer.technique !== null);
      if (started && !window.confirm(`Réinitialiser la session et tirer ${CARDS_PER_GAME} nouvelles cartes ?`)) {
        return;
      }
      startSession();
    };

    cardElements.forEach((card, index) => {
      card.querySelectorAll<HTMLButtonElement>('[data-technique]').forEach((button) => {
        button.addEventListener('click', () => {
          const answer = answers[index];
          const technique = button.dataset.technique;
          if (!answer || answer.validated) return;
          if (!isTechniqueId(technique)) return;

          answer.technique = technique;

          card.querySelectorAll<HTMLButtonElement>('[data-technique]').forEach((option) => {
            const selected = option === button;
            option.classList.toggle('is-selected', selected);
            option.setAttribute('aria-pressed', selected ? 'true' : 'false');
          });

          const validate = card.querySelector<HTMLButtonElement>('[data-validate]');
          if (validate) validate.disabled = false;
        });
      });

      card.querySelectorAll<HTMLInputElement>('[data-criterion]').forEach((input) => {
        input.addEventListener('change', () => {
          const answer = answers[index];
          const criterion = input.dataset.criterion;
          if (!answer || answer.validated || !isCriterionId(criterion)) return;
          answer.criteria[criterion] = input.checked;
        });
      });

      card.querySelector<HTMLButtonElement>('[data-validate]')?.addEventListener('click', () => {
        validateCard(index);
      });
      card.querySelector<HTMLButtonElement>('[data-next]')?.addEventListener('click', goNext);
    });

    resetButton?.addEventListener('click', requestNewSession);
    restartButton?.addEventListener('click', startSession);

    tribunalCloseTargets.forEach((target) => {
      target.addEventListener('click', closeTribunal);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && tribunal && !tribunal.hidden) {
        event.preventDefault();
        closeTribunal();
      }
    });

    tribunal?.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab' || !tribunalDialog) return;

      const focusable = Array.from(
        tribunalDialog.querySelectorAll<HTMLElement>('button:not([disabled])'),
      );
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (!first || !last) return;

      if (document.activeElement === tribunalDialog) {
        event.preventDefault();
        (event.shiftKey ? last : first).focus();
      } else if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    startSession();
  }
</script>

<style>
  .recycling-nuancier {
    --nuancier-accent: var(--primary, #38bdf8);
    --nuancier-legal: #34d399;
    --nuancier-danger: #fb7185;
    --nuancier-warn: #fbbf24;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.25rem;
    border: 1px solid var(--border, #334155);
    border-radius: 18px;
    background:
      radial-gradient(circle at top right, rgba(56, 189, 248, 0.14), transparent 45%),
      linear-gradient(160deg, #101c30 0%, #0b1120 65%);
    color: var(--text, #f8fafc);
  }

  .recycling-nuancier [hidden] {
    display: none !important;
  }

  .nuancier-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .nuancier-heading {
    flex: 1 1 320px;
    min-width: 0;
  }

  .nuancier-kicker {
    margin: 0 0 0.35rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7dd3fc;
  }

  .nuancier-heading h3 {
    margin: 0;
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    letter-spacing: -0.01em;
  }

  .nuancier-intro {

---
import VideoCard from './VideoCard.astro';
import LaboCinematique from './LaboCinematique.astro';

interface CinemaVideo {
  badge: string;
  title: string;
  youtubeId: string;
  /** Texte court affiché sous la carte (onglet « L'air de la folie » uniquement). */
  caption?: string;
}

interface CinemaTab {
  id: string;
  label: string;
  videos: CinemaVideo[];
  /** Onglet atelier interactif : affiche le Labo Musique & Image au lieu des vidéos. */
  kind?: 'videos' | 'labo';
}

const tabs: CinemaTab[] = [
  {
    id: 'air-de-la-folie',
    label: "L'air de la folie",
    videos: [
      {
        badge: 'Écoute',
        title: "L'air de la folie — Lucia di Lammermoor",
        youtubeId: 'qc3Ml_Sse7M',
        caption:
          "L'air de la folie est à l'origine tiré de l'opéra <strong>Lucia di Lammermoor</strong>, composé par <strong>Gaetano Donizetti en 1835</strong>.",
      },
      {
        badge: 'Écoute',
        title: "L'air de la folie — Le 5ème élément",
        youtubeId: 'GuvgWDlpEhw',
        caption:
          "L'air de la folie a ensuite été réutilisé puis modifié par le compositeur <strong>Éric Serra</strong> pour la bande son du film <strong>Le 5ème élément</strong> réalisé par Luc Besson.",
      },
      {
        badge: 'Analyse',
        title: "Analyse de la scène de l'opéra dans Le 5ème élément",
        youtubeId: 'pfDJS_T4wg0',
        caption: "Analyse de la scène culte de l'opéra dans Le 5ème élément.",
      },
      {
        badge: 'Fun',
        title: 'Qui peut chanter le climax de The Diva Dance ?',
        youtubeId: 'WxXq2HCQDh0',
        caption: 'Qui peut chanter le climax de The Diva Dance ?',
      },
    ],
  },
  {
    id: 'role-de-la-musique',
    label: 'Le rôle de la musique',
    videos: [
      { badge: 'Capsule 1', title: 'Le rôle de la musique — Capsule 1', youtubeId: '-ueSPopk7Nk' },
      { badge: 'Capsule 2', title: 'Le rôle de la musique — Capsule 2', youtubeId: 'fxwVFKN08II' },
      { badge: 'Mickeymousing', title: 'Le mickeymousing', youtubeId: '0_XX9c90PFQ' },
      { badge: 'Musique narrative', title: 'La musique narrative', youtubeId: 'kiV3J_e977Q' },
      { badge: 'Musique empathique', title: 'La musique empathique', youtubeId: '84Irg8xn4bg' },
      {
        badge: 'Musique anempathique',
        title: 'La musique anempathique',
        youtubeId: '7CkOdChHrDI',
      },
    ],
  },
  {
    id: 'leitmotiv',
    label: 'Le leitmotiv',
    videos: [
      { badge: 'Leitmotiv', title: 'Le leitmotiv au cinéma', youtubeId: '3ZgcyHaCdhE' },
    ],
  },
  {
    id: 'projet-musical',
    label: 'Projet musical',
    videos: [
      { badge: 'Projet musical', title: 'Projet musical', youtubeId: 'VZEtQo87n2I' },
    ],
  },
  {
    id: 'labo',
    label: 'Labo Musique & Image',
    kind: 'labo',
    videos: [],
  },
];
---

<div class="cinema-course">
  <div class="cinema-tabs" role="tablist" aria-label="Musique et Cinéma">
    {tabs.map((tab, index) => (
      <button
        type="button"
        role="tab"
        id={`cinema-tab-${tab.id}`}
        class="cinema-tab"
        aria-controls={`cinema-panel-${tab.id}`}
        aria-selected={index === 0 ? 'true' : 'false'}
        tabindex={index === 0 ? 0 : -1}
        data-tab={tab.id}
      >
        {tab.label}
      </button>
    ))}
  </div>

  {tabs.map((tab, index) => (
    <div
      role="tabpanel"
      id={`cinema-panel-${tab.id}`}
      class="cinema-panel"
      aria-labelledby={`cinema-tab-${tab.id}`}
      hidden={index !== 0}
      data-panel={tab.id}
    >
      {tab.kind === 'labo' ? (
        <LaboCinematique />
      ) : (
        <div class="cinema-videos">
          {tab.videos.map((video) => (
            <figure class="cinema-video">
              <VideoCard
                badge={video.badge}
                title={video.title}
                url={`https://www.youtube.com/watch?v=${video.youtubeId}`}
              />
              {video.caption && <figcaption class="cinema-caption" set:html={video.caption} />}
            </figure>
          ))}
        </div>
      )}
    </div>
  ))}
</div>

<script>
  import { stopAudio } from '../utils/audioManager';

  const tabs = document.querySelectorAll<HTMLButtonElement>('.cinema-tab');

  const selectTab = (tab: HTMLButtonElement) => {
    const root = tab.closest('.cinema-course');
    if (!root) return;

    // Coupe le son du Labo (et de tout autre extrait) quand on quitte son onglet.
    if (tab.dataset.tab !== 'labo') stopAudio();

    root.dispatchEvent(
      new CustomEvent('cinema:tab-change', {
        detail: { tab: tab.dataset.tab },
        bubbles: true,
      }),
    );

    root.querySelectorAll<HTMLButtonElement>('.cinema-tab').forEach((item) => {
      const isActive = item === tab;
      item.setAttribute('aria-selected', isActive ? 'true' : 'false');
      item.tabIndex = isActive ? 0 : -1;
    });

    root.querySelectorAll<HTMLElement>('.cinema-panel').forEach((panel) => {
      panel.hidden = panel.dataset.panel !== tab.dataset.tab;
    });
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectTab(tab));
    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      event.preventDefault();
      const nextIndex =
        event.key === 'ArrowRight'
          ? (index + 1) % tabs.length
          : (index - 1 + tabs.length) % tabs.length;
      tabs[nextIndex].focus();
      selectTab(tabs[nextIndex]);
    });
  });
</script>

<style>
  .cinema-course {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cinema-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cinema-tab {
    flex: 1 1 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 1.25rem;
    border-radius: 12px;
    border: 1px solid var(--border, #334155);
    background: #1e293b;
    color: var(--text-muted, #94a3b8);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
  }

  .cinema-tab::before {
    font-size: 1.1rem;
    line-height: 1;
  }

  .cinema-tab[data-tab='air-de-la-folie']::before {
    content: '🎭';
  }

  .cinema-tab[data-tab='role-de-la-musique']::before {
    content: '🎬';
  }

  .cinema-tab[data-tab='leitmotiv']::before {
    content: '🎼';
  }

  .cinema-tab[data-tab='projet-musical']::before {
    content: '🎤';
  }

  .cinema-tab[data-tab='labo']::before {
    content: '🎬';
  }

  .cinema-tab:hover {
    border-color: var(--primary, #38bdf8);
    color: var(--text, #f1f5f9);
  }

  .cinema-tab[aria-selected='true'] {
    border-color: var(--primary, #38bdf8);
    color: var(--text, #f1f5f9);
    box-shadow: 0 0 0 1px var(--primary, #38bdf8), 0 0 16px rgba(56, 189, 248, 0.25);
  }

  .cinema-tab:focus-visible {
    outline: 2px solid var(--primary, #38bdf8);
    outline-offset: 2px;
  }

  .cinema-panel[hidden] {
    display: none;
  }

  .cinema-videos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .cinema-video {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .cinema-caption {
    margin: 0.6rem 0 0;
    color: var(--text-muted, #94a3b8);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .cinema-caption :global(strong) {
    color: var(--text, #f1f5f9);
  }
</style>

---
import { relativeUrl } from '../utils/navigation';

interface StageItem {
  id: string;
  label: string;
  image: string;
  kind: 'instrument' | 'tag';
}

interface ItemGroup {
  id: string;
  title: string;
  hint: string;
  items: StageItem[];
}

interface RockStyle {
  id: string;
  name: string;
  image: string;
  signature: string;
  requirements: string[];
}

// Les visuels vivent dans public/rock/quizrock ; relativeUrl tient compte du base Astro.
const image = (file: string) => relativeUrl(`/rock/quizrock/${file}`);

const groups: ItemGroup[] = [
  {
    id: 'instruments',
    title: '🎷 Instruments',
    hint: 'Tous les instruments au même niveau : à toi de choisir.',
    items: [
      // Ordre volontairement mélangé : aucune catégorie ne révèle le rôle d'un instrument.
      { id: 'guitare', label: 'Guitare électrique', image: image('guitare.jpg'), kind: 'instrument' },
      { id: 'violon', label: 'Violon', image: image('violon.jpg'), kind: 'instrument' },
      { id: 'basse', label: 'Basse', image: image('basse.jpg'), kind: 'instrument' },
      { id: 'synthetiseur', label: 'Synthétiseur', image: image('synthetiseur.jpg'), kind: 'instrument' },
      { id: 'contrebasse', label: 'Contrebasse', image: image('contrebasse.jpg'), kind: 'instrument' },
      { id: 'batterie', label: 'Batterie', image: image('batterie.jpg'), kind: 'instrument' },
      { id: 'trompette', label: 'Trompette', image: image('trompette.jpg'), kind: 'instrument' },
      { id: 'piano', label: 'Piano', image: image('piano.jpg'), kind: 'instrument' },
      { id: 'chant', label: 'Chant', image: image('chant.jpg'), kind: 'instrument' },
      { id: 'trombone', label: 'Trombone', image: image('trombone.jpg'), kind: 'instrument' },
      { id: 'saxophone', label: 'Saxophone', image: image('saxophone.jpg'), kind: 'instrument' },
      { id: 'clarinette', label: 'Clarinette', image: image('clarinette.jpg'), kind: 'instrument' },
      { id: 'harpe', label: 'Harpe', image: image('harpe.jpg'), kind: 'instrument' },
      { id: 'fluteabec', label: 'Flûte à bec', image: image('fluteabec.jpg'), kind: 'instrument' },
      { id: 'basson', label: 'Basson', image: image('basson.jpg'), kind: 'instrument' },
    ],
  },
  {
    id: 'etiquettes',
    title: '🏷️ Étiquettes & Contexte',
    hint: 'Les ingrédients qui donnent sa couleur au morceau.',
    items: [
      { id: 'grilledeblues', label: 'Grille de blues', image: image('grilledeblues.jpg'), kind: 'tag' },
      { id: 'annees50', label: 'Années 50', image: image('annees50.jpg'), kind: 'tag' },
      { id: 'jazzinfluence', label: 'Influence du jazz', image: image('jazzinfluence.jpg'), kind: 'tag' },
      {
        id: 'ecritureinfluencedrogue',
        label: 'Écriture sous influence de drogues',
        image: image('ecritureinfluencedrogue.jpg'),
        kind: 'tag',
      },
      {
        id: 'saturation',
        label: 'Saturation poussée à l’extrême',
        image: image('saturation.jpg'),
        kind: 'tag',
      },
      { id: 'formatcourt', label: 'Format court', image: image('formatcourt.jpg'), kind: 'tag' },
      { id: '3accords', label: '3 accords', image: image('3accords.jpg'), kind: 'tag' },
      { id: 'textesrebelles', label: 'Textes rebelles', image: image('textesrebelles.jpg'), kind: 'tag' },
      {
        id: 'harmoniesvocales',
        label: 'Harmonies vocales très travaillées',
        image: image('harmoniesvocales.jpg'),
        kind: 'tag',
      },
      { id: 'sonsale', label: 'Son sale', image: image('sonsale.jpg'), kind: 'tag' },
      {
        id: 'alternancecalmeexplosion',
        label: 'Alternance calme / explosion',
        image: image('alternancecalmeexplosion.jpg'),
        kind: 'tag',
      },
      {
        id: 'paillettesmaquillage',
        label: 'Paillettes et maquillage',
        image: image('paillettesmaquillage.jpg'),
        kind: 'tag',
      },
    ],
  },
];

const items: StageItem[] = groups.flatMap((group) => group.items);

const styles: RockStyle[] = [
  {
    id: 'rocknroll',
    name: "Rock 'n' Roll",
    image: image('rocknroll.jpg'),
    signature:
      '1954 : Rock Around The Clock par Bill Haley and His Comets. La secousse qui invente le rock.',
    requirements: [
      'guitare',
      'batterie',
      'chant',
      'contrebasse',
      'saxophone',
      'grilledeblues',
      'annees50',
      'jazzinfluence',
    ],
  },
  {
    id: 'rockpsychedelique',
    name: 'Rock Psychédélique',
    image: image('rockpsychedelique.jpg'),
    signature:
      'La basse remplace la contrebasse, les morceaux s’allongent et l’écriture sous influence ouvre de nouveaux mondes sonores.',
    requirements: ['guitare', 'basse', 'batterie', 'chant', 'ecritureinfluencedrogue'],
  },
  {
    id: 'hardrock',
    name: 'Hard Rock',
    image: image('hardrock.jpg'),
    signature:
      'Le même groupe, mais avec une saturation poussée à l’extrême : plus lourd, plus fort, plus agressif.',
    requirements: ['guitare', 'basse', 'batterie', 'chant', 'saturation'],
  },
  {
    id: 'punkrock',
    name: 'Punk Rock',
    image: image('punkrock.jpg'),
    signature:
      'Trois accords, format court, textes rebelles : l’énergie brute contre les solos interminables.',
    requirements: [
      'guitare',
      'basse',
      'batterie',
      'chant',
      'formatcourt',
      '3accords',
      'textesrebelles',
    ],
  },
  {
    id: 'poprock',
    name: 'Pop-Rock',
    image: image('poprock.jpg'),
    signature:
      'Des harmonies vocales très travaillées et un format court : la mélodie passe avant la puissance.',
    requirements: ['guitare', 'basse', 'batterie', 'chant', 'harmoniesvocales', 'formatcourt'],
  },
  {
    id: 'grunge',
    name: 'Grunge',
    image: image('grunge.jpg'),
    signature:
      'Un son sale et des alternances calme / explosion : l’énergie de Seattle au début des années 90.',
    requirements: ['guitare', 'basse', 'batterie', 'chant', 'sonsale', 'alternancecalmeexplosion'],
  },
  {
    id: 'glamrock',
    name: 'Glam Rock',
    image: image('glamrock.jpg'),
    signature:
      'Paillettes et maquillage : le rock devient un spectacle total, flamboyant et théâtral.',
    requirements: ['guitare', 'basse', 'batterie', 'chant', 'paillettesmaquillage'],
  },
  {
    id: 'newwave',
    name: 'New Wave',
    image: image('newwave.jpg'),
    signature:
      'Le synthétiseur entre dans le groupe : le rock rencontre l’électronique des années 80.',
    requirements: ['guitare', 'basse', 'batterie', 'chant', 'synthetiseur'],
  },
];

const stageData = { items, styles };
---

<script
  is:inline
  type="application/json"
  id="rock-stage-data"
  set:html={JSON.stringify(stageData)}
></script>

<div class="rock-stage-builder">
  <header class="studio-intro">
    <span class="studio-kicker">Atelier interactif</span>
    <h3>🎸 Le Studio Rock</h3>
    <p>
      Compose ton groupe et empile les ingrédients sur la scène. La jauge te dit si tu chauffes…
      Réunis les bons éléments pour débloquer 8 grands styles du rock.
    </p>
  </header>

  <div class="studio-board">
    <section class="studio-stage" aria-labelledby="studio-stage-title">
      <header class="studio-stage-header">
        <h4 id="studio-stage-title">La scène</h4>
        <span class="stage-count" data-stage-count>0 élément</span>
      </header>

      <div class="stage-scene">
        <div class="stage-spot" aria-hidden="true"></div>

        <ul class="stage-items" data-stage-items>
          {items.map((item) => (
            <li class="stage-item" data-stage-item-id={item.id} data-kind={item.kind} hidden>
              <button
                type="button"
                class="stage-item-button"
                data-remove-id={item.id}
                aria-label={`Retirer ${item.label} de la scène`}
                title={`Retirer ${item.label}`}
              >
                <img src={item.image} alt="" width="96" height="96" loading="lazy" />
              </button>
            </li>
          ))}
          <li class="stage-empty" data-stage-empty>
            <span aria-hidden="true">🎛️</span>
            Clique sur des instruments et des étiquettes dans le rack pour les faire monter sur
            scène.
          </li>
        </ul>

        <div class="stage-floor" aria-hidden="true"></div>
      </div>

      <button type="button" class="stage-reset" data-reset disabled>
        Retirer tous les éléments
      </button>
    </section>

    <aside class="studio-gauge-card" aria-labelledby="studio-gauge-title">
      <h4 id="studio-gauge-title">Jauge de proximité</h4>
      <p class="gauge-headline" data-gauge-headline>Analyse en cours…</p>

      <div
        class="gauge"
        data-gauge
        data-heat="cold"
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        aria-labelledby="studio-gauge-title"
      >
        <div class="gauge-fill" data-gauge-fill></div>
      </div>

      <div class="gauge-readout">
        <span class="gauge-value" data-gauge-value>—</span>
        <span class="gauge-target" data-gauge-target
          >Style le plus proche : Il n'y a pas assez d'éléments pour juger.</span
        >
      </div>

      <p class="gauge-detail" data-gauge-detail>
        Pose au moins 3 éléments sur scène pour lancer l'évaluation.
      </p>

      <p class="gauge-intruder" data-intruder-note hidden></p>

      <p class="sr-only" role="status" aria-live="polite" data-live></p>
    </aside>
  </div>

  <section class="studio-rack" aria-labelledby="studio-rack-title">
    <header class="rack-header">
      <h4 id="studio-rack-title">Le rack</h4>
      <p>Ouvre une armoire et clique sur un visuel pour l'ajouter à la scène (ou le retirer).</p>
    </header>

    <div class="rack-groups">
      {groups.map((group) => (
        <details class="rack-group" data-group={group.id} open>
          <summary class="rack-group-summary">
            <span class="rack-group-title">{group.title}</span>
          </summary>

          <div class="rack-group-body">
            <p class="rack-group-hint">{group.hint}</p>

            <div class="rack-grid" data-rack-grid>
              {group.items.map((item) => (
                <button
                  type="button"
                  class="rack-item"
                  data-item-id={item.id}
                  data-kind={item.kind}
                  aria-pressed="false"
                  aria-label={item.label}
                  title={`Ajouter ${item.label} à la scène`}
                >
                  <span class="rack-thumb">
                    <img
                      src={item.image}
                      alt=""
                      width="120"
                      height="120"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                </button>
              ))}
            </div>
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="studio-unlock" data-unlock-panel hidden>
    <div class="unlock-card">
      <div class="unlock-media">
        <img
          data-unlock-image
          src={styles[0]?.image}
          alt=""
          width="320"
          height="240"
          loading="lazy"
        />
      </div>
      <div class="unlock-body">
        <span class="unlock-kicker">🎉 Style débloqué</span>
        <h4 data-unlock-name></h4>
        <p data-unlock-signature></p>
        <p class="unlock-note">Carte ajoutée à ta galerie de styles.</p>
      </div>
    </div>
  </section>

  <section class="studio-gallery" aria-labelledby="studio-gallery-title">
    <header class="gallery-header">
      <h4 id="studio-gallery-title">Styles découverts</h4>
      <div class="gallery-tools">
        <span class="gallery-count" data-gallery-count>Styles découverts : 0 / {styles.length}</span>
        <button
          type="button"
          class="gallery-reset"
          data-gallery-reset
          title="Réinitialiser les styles découverts"
        >
          🔄 Reset
        </button>
      </div>
    </header>

    <ul class="gallery-grid">
      {styles.map((style) => (
        <li
          class="style-card"
          data-style-card={style.id}
          data-unlocked="false"
          aria-label="Style non découvert"
        >
          <div class="style-card-media">
            <img src={style.image} alt="" width="320" height="240" loading="lazy" />
            <span class="style-card-lock" aria-hidden="true">🔒</span>
          </div>
          <div class="style-card-body">
            <span class="style-card-name style-card-name--locked">???</span>
            <span class="style-card-name style-card-name--unlocked">{style.name}</span>
            <span class="style-card-meta">{style.requirements.length} ingrédients requis</span>
          </div>
        </li>
      ))}
    </ul>

    <p class="gallery-hint">
      Chaque style se débloque quand la scène contient exactement tous ses ingrédients, sans
      élément en trop.
    </p>
  </section>
</div>


<script>
  interface StageItem {
    id: string;
    label: string;
    image: string;
    kind: 'instrument' | 'tag';
  }

  interface RockStyle {
    id: string;
    name: string;
    image: string;
    signature: string;
    requirements: string[];
  }

  interface StageData {
    items: StageItem[];
    styles: RockStyle[];
  }

  interface Evaluation {
    style: RockStyle;
    score: number;
    matched: number;
    missing: number;
    extras: number;
  }

  interface HeatLevel {
    min: number;
    heat: 'cold' | 'warm' | 'hot' | 'fire' | 'perfect';
    headline: string;
  }

  const STORAGE_KEY = 'rock-stage-builder:discovered';

  const HEAT_LEVELS: HeatLevel[] = [
    { min: 100, heat: 'perfect', headline: 'Match parfait !' },
    { min: 90, heat: 'fire', headline: 'Brûlant !' },
    { min: 60, heat: 'hot', headline: 'Ça chauffe sérieusement !' },
    { min: 1, heat: 'warm', headline: 'Tu chauffes !' },
    { min: 0, heat: 'cold', headline: 'Tu chauffes !' },
  ];

  const plural = (count: number, singular: string, pluralForm = `${singular}s`) =>
    `${count} ${count > 1 ? pluralForm : singular}`;

  const dataElement = document.getElementById('rock-stage-data');
  const root = document.querySelector<HTMLElement>('.rock-stage-builder');

  if (dataElement?.textContent && root) {
    const { items, styles } = JSON.parse(dataElement.textContent) as StageData;

    const itemById = new Map(items.map((item) => [item.id, item]));
    const styleById = new Map(styles.map((style) => [style.id, style]));

    const readDiscovered = (): string[] => {
      try {
        const raw = window.localStorage.getItem(STORAGE_KEY);
        if (!raw) return [];
        const parsed: unknown = JSON.parse(raw);
        return Array.isArray(parsed)
          ? parsed.filter((id): id is string => typeof id === 'string' && styleById.has(id))
          : [];
      } catch {
        return [];
      }
    };

    const selection = new Set<string>();
    const discovered = new Set<string>(readDiscovered());
    // Empêche un redéblocage immédiat pendant la réinitialisation de la galerie.
    let unlockSuspended = false;

    const rackButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('.rack-item[data-item-id]'),
    );
    const stageItems = Array.from(root.querySelectorAll<HTMLElement>('[data-stage-item-id]'));
    const stageList = root.querySelector<HTMLElement>('[data-stage-items]');
    const stageEmpty = root.querySelector<HTMLElement>('[data-stage-empty]');
    const stageCount = root.querySelector<HTMLElement>('[data-stage-count]');
    const resetButton = root.querySelector<HTMLButtonElement>('[data-reset]');
    const gauge = root.querySelector<HTMLElement>('[data-gauge]');
    const gaugeFill = root.querySelector<HTMLElement>('[data-gauge-fill]');
    const gaugeHeadline = root.querySelector<HTMLElement>('[data-gauge-headline]');
    const gaugeValue = root.querySelector<HTMLElement>('[data-gauge-value]');
    const gaugeTarget = root.querySelector<HTMLElement>('[data-gauge-target]');
    const gaugeDetail = root.querySelector<HTMLElement>('[data-gauge-detail]');
    const liveRegion = root.querySelector<HTMLElement>('[data-live]');
    const unlockPanel = root.querySelector<HTMLElement>('[data-unlock-panel]');
    const unlockImage = root.querySelector<HTMLImageElement>('[data-unlock-image]');
    const unlockName = root.querySelector<HTMLElement>('[data-unlock-name]');
    const unlockSignature = root.querySelector<HTMLElement>('[data-unlock-signature]');
    const galleryCount = root.querySelector<HTMLElement>('[data-gallery-count]');
    const galleryCards = Array.from(root.querySelectorAll<HTMLElement>('[data-style-card]'));
    const intruderNote = root.querySelector<HTMLElement>('[data-intruder-note]');
    const galleryReset = root.querySelector<HTMLButtonElement>('[data-gallery-reset]');

    const shuffleChildren = (container: HTMLElement) => {
      const children = Array.from(container.children);

      // Fisher-Yates : chaque carte a la même chance d'atterrir à chaque position.
      for (let i = children.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        const current = children[i];
        const random = children[j];
        if (!current || !random) continue;
        children[i] = random;
        children[j] = current;
      }

      children.forEach((child) => container.appendChild(child));
    };

    // La position des cartes change à chaque chargement de page.
    root.querySelectorAll<HTMLElement>('[data-rack-grid]').forEach(shuffleChildren);

    const evaluate = (style: RockStyle): Evaluation => {
      const required = new Set(style.requirements);
      let matched = 0;

      selection.forEach((id) => {
        if (required.has(id)) matched += 1;
      });

      const extras = selection.size - matched;

      return {
        style,
        score: matched === 0 ? 0 : Math.round((matched / (required.size + extras)) * 100),
        matched,
        missing: required.size - matched,
        extras,
      };
    };

    const evaluateAll = (): { best: Evaluation; tied: Evaluation[] } | null => {
      const evaluations = styles.map(evaluate);
      if (evaluations.length === 0) return null;

      const topScore = evaluations.reduce((max, entry) => Math.max(max, entry.score), 0);
      const contenders = evaluations
        .filter((entry) => entry.score === topScore)
        .sort((a, b) => a.missing - b.missing || a.extras - b.extras);
      const best = contenders[0];
      if (!best) return null;

      return {
        best,
        tied: contenders.filter(
          (entry) => entry.missing === best.missing && entry.extras === best.extras,
        ),
      };
    };

    const applyGauge = (
      score: number | null,
      heat: HeatLevel['heat'],
      headline: string,
    ) => {
      if (gaugeFill) gaugeFill.style.width = `${score ?? 0}%`;
      if (gauge) {
        gauge.dataset.heat = heat;
        gauge.setAttribute('aria-valuenow', String(score ?? 0));
        gauge.setAttribute(
          'aria-valuetext',
          score === null ? headline : `${score} % — ${headline}`,
        );
      }
      if (gaugeValue) gaugeValue.textContent = score === null ? '—' : `${score} %`;
      if (gaugeHeadline) gaugeHeadline.textContent = headline;
    };

    const getIntruderRemark = (extras: number): string | null => {
      if (extras === 0) return null;
      if (extras === 1) {
        return 'Il y a un passager clandestin dans ton groupe… L\'un de ces éléments n\'a rien à faire là ! 🕵️';
      }
      if (extras === 2) {
        return 'Oula ! Au moins deux éléments gâchent la synergie de ton groupe. 🥊';
      }

      return "C'est un joyeux bazar ! Plusieurs éléments n'ont absolument rien à faire ensemble. 💥";
    };

    const renderIntruderNote = (extras: number | null) => {
      if (!intruderNote) return;

      const message = extras === null ? null : getIntruderRemark(extras);
      intruderNote.textContent = message ?? '';
      intruderNote.hidden = message === null;
    };

    const renderStage = () => {
      stageItems.forEach((item) => {
        const id = item.dataset.stageItemId;
        item.hidden = !id || !selection.has(id);
      });

      if (stageEmpty) stageEmpty.hidden = selection.size > 0;
      if (stageCount) stageCount.textContent = plural(selection.size, 'élément');
      if (resetButton) resetButton.disabled = selection.size === 0;
    };

    const renderGallery = () => {
      galleryCards.forEach((card) => {
        const id = card.dataset.styleCard;
        const style = id ? styleById.get(id) : undefined;
        if (!style) return;

        const isUnlocked = discovered.has(style.id);
        card.dataset.unlocked = isUnlocked ? 'true' : 'false';
        card.setAttribute(
          'aria-label',
          isUnlocked ? `${style.name} — style découvert` : 'Style non découvert',
        );
      });

      if (galleryCount) {
        galleryCount.textContent = `Styles découverts : ${discovered.size} / ${styles.length}`;
      }
    };

    const showUnlockCard = (style: RockStyle) => {
      if (unlockPanel) unlockPanel.hidden = false;
      if (unlockImage) {
        unlockImage.src = style.image;
        unlockImage.alt = `Carte du style ${style.name}`;
      }
      if (unlockName) unlockName.textContent = style.name;
      if (unlockSignature) unlockSignature.textContent = style.signature;
    };

    const unlockStyle = (style: RockStyle) => {
      if (unlockSuspended) return;

      const isNew = !discovered.has(style.id);

      if (isNew) {
        discovered.add(style.id);
        try {
          window.localStorage.setItem(STORAGE_KEY, JSON.stringify([...discovered]));
        } catch {
          // Stockage local indisponible : la découverte reste valable pour la session.
        }
        renderGallery();

        if (liveRegion) {
          liveRegion.textContent = `Style débloqué : ${style.name}. ${discovered.size} styles découverts sur ${styles.length}.`;
        }
      }

      showUnlockCard(style);
    };

    const renderGauge = () => {
      // En dessous de 3 éléments, l'évaluation n'a pas assez de matière : on reste neutre.
      if (selection.size < 3) {
        applyGauge(null, 'cold', 'Analyse en cours…');
        if (gaugeTarget) {
          gaugeTarget.textContent =
            "Style le plus proche : Il n'y a pas assez d'éléments pour juger.";
        }
        if (gaugeDetail) {
          gaugeDetail.textContent = "Pose au moins 3 éléments sur scène pour lancer l'évaluation.";
        }
        renderIntruderNote(null);
        return;
      }

      const result = evaluateAll();

      if (!result) {
        applyGauge(null, 'cold', 'Analyse en cours…');
        if (gaugeTarget) gaugeTarget.textContent = "Style le plus proche : Aucun pour l'instant";
        renderIntruderNote(null);
        return;
      }

      const { best, tied } = result;

      if (best.score === 0) {
        applyGauge(0, 'cold', "C'est congelé !");
        if (gaugeTarget) gaugeTarget.textContent = "Style le plus proche : Aucun pour l'instant";
      } else {
        const level = HEAT_LEVELS.find((entry) => best.score >= entry.min) ?? HEAT_LEVELS[0];
        if (level) applyGauge(best.score, level.heat, level.headline);

        if (gaugeTarget) {
          const names =
            tied.length > 1
              ? `${tied
                  .slice(0, 2)
                  .map((entry) => entry.style.name)
                  .join(' ou ')}${tied.length > 2 ? ` (+${tied.length - 2} autres pistes)` : ''}`
              : best.style.name;
          gaugeTarget.textContent = `Style le plus proche : ${names}`;
        }
      }

      if (gaugeDetail) {
        if (best.score === 100) {
          gaugeDetail.textContent = 'Tous les ingrédients sont réunis, sans élément en trop.';
        } else {
          const extrasLabel =
            best.extras > 0 ? `${plural(best.extras, 'élément')} en trop` : 'sans intrus';
          gaugeDetail.textContent = `${best.matched} / ${best.style.requirements.length} ingrédients · ${extrasLabel}`;
        }
      }

      renderIntruderNote(best.extras);
      if (best.score === 100) unlockStyle(best.style);
    };

    const render = () => {
      rackButtons.forEach((button) => {
        const id = button.dataset.itemId;
        const item = id ? itemById.get(id) : undefined;
        if (!item) return;

        const isActive = selection.has(item.id);
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        button.setAttribute(
          'aria-label',
          isActive ? `Retirer ${item.label} de la scène` : `Ajouter ${item.label} à la scène`,
        );
        button.title = isActive
          ? `Retirer ${item.label} de la scène`
          : `Ajouter ${item.label} à la scène`;
      });

      renderStage();
      renderGauge();
    };

    rackButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const id = button.dataset.itemId;
        if (!id) return;

        if (selection.has(id)) selection.delete(id);
        else selection.add(id);

        render();
      });
    });

    stageList?.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const button = target.closest<HTMLButtonElement>('[data-remove-id]');
      const id = button?.dataset.removeId;
      if (!id) return;

      selection.delete(id);
      render();
    });

    resetButton?.addEventListener('click', () => {
      selection.clear();
      render();
    });

    galleryReset?.addEventListener('click', () => {
      const confirmed = window.confirm(
        'Veux-tu vraiment réinitialiser tous les styles découverts ?',
      );
      if (!confirmed) return;

      discovered.clear();
      try {
        window.localStorage.removeItem(STORAGE_KEY);
      } catch {
        // Stockage local indisponible : rien à supprimer.
      }

      if (unlockPanel) unlockPanel.hidden = true;

      // La scène peut déjà correspondre à un style : on évite qu'il soit redébloqué aussitôt.
      unlockSuspended = true;
      render();
      unlockSuspended = false;

      renderGallery();

      if (liveRegion) {
        liveRegion.textContent = 'Galerie réinitialisée : aucun style découvert.';
      }
    });

    renderGallery();
    render();
  }
</script>


---
import CourseTabs from './CourseTabs.astro';
import VideoCard from './VideoCard.astro';
import QuizMusiquePub from './QuizMusiquePub.astro';

interface PubVideo {
  badge: string;
  title: string;
  youtubeId: string;
}

interface PubTab {
  id: string;
  icon: string;
  label: string;
  videos: PubVideo[];
}

const tabs: PubTab[] = [
  {
    id: 'cours',
    icon: '📢',
    label: 'Cours',
    videos: [
      {
        badge: 'Capsule pédagogique',
        title: 'Capsule pédagogique — Musique et Publicité',
        youtubeId: 'lNpTQ6Hycg0',
      },
      {
        badge: 'Projet musical',
        title: 'Projet musical — Musique et Publicité',
        youtubeId: 'HP-5fvykK78',
      },
      {
        badge: 'Publicité Toyota',
        title: 'Publicité Toyota',
        youtubeId: 'J91VaDSQ6ow',
      },
      {
        badge: 'Publicité Loto',
        title: 'Publicité Loto',
        youtubeId: 'UD8raZfrA8E',
      },
      {
        badge: 'Comparaisons',
        title: 'Comparaisons — Musique et Publicité',
        youtubeId: 'r72Vl9MWjog',
      },
    ],
  },
  {
    id: 'quiz',
    icon: '🎧',
    label: 'Blindtest',
    videos: [],
  },
];
---

<div class="pub-course">
  <CourseTabs tabs={tabs} ariaLabel="Musique et Publicité" />

  {tabs.map((tab, index) => (
    <div
      role="tabpanel"
      id={`main-panel-${tab.id}`}
      class="pub-panel"
      aria-labelledby={`main-tab-${tab.id}`}
      hidden={index !== 0 || tab.id === 'quiz'}
      data-panel={tab.id}
    >
      {tab.id === 'quiz' ? <QuizMusiquePub /> : (
        <div class="pub-videos">
          {tab.videos.map((video) => (
            <VideoCard
              badge={video.badge}
              title={video.title}
              url={`https://www.youtube.com/watch?v=${video.youtubeId}`}
            />
          ))}
        </div>
      )}
    </div>
  ))}
</div>

<script>
  const pubRoot = document.querySelector<HTMLElement>('.pub-course');

  if (pubRoot) {
    const tabs = pubRoot.querySelectorAll<HTMLButtonElement>('.main-tab');

    const selectTab = (tab: HTMLButtonElement) => {
      pubRoot.querySelectorAll<HTMLButtonElement>('.main-tab').forEach((item) => {
        const isActive = item === tab;
        item.setAttribute('aria-selected', isActive ? 'true' : 'false');
        item.tabIndex = isActive ? 0 : -1;
        item.classList.toggle('is-active', isActive);
      });

      pubRoot.querySelectorAll<HTMLElement>('.pub-panel').forEach((panel) => {
        panel.hidden = panel.dataset.panel !== tab.dataset.mainTab;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const nextIndex =
          event.key === 'Home' ? 0
          : event.key === 'End' ? tabs.length - 1
          : event.key === 'ArrowRight' ? (index + 1) % tabs.length
          : (index - 1 + tabs.length) % tabs.length;
        tabs[nextIndex].focus();
        selectTab(tabs[nextIndex]);
      });
    });
  }
</script>

<style>
  .pub-course {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .pub-panel[hidden] {
    display: none;
  }

  .pub-videos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
</style>


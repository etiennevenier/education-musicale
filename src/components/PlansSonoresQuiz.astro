---
import { plansSonoresList } from '../data/plansSonoresData';
import '../styles/quiz-card.css';
---

<div class="quiz-card plans-sonores-card">
  <div class="fuzeau-header">
    <span class="badge">Écoute &amp; Analyse</span>
    <h4>Jeu : Reconnaître les Plans Sonores</h4>
  </div>

  <!-- Barre de filtres (Type de question) -->
  <div class="filters-bar">
    <div class="filter-group">
      <label for="psTypeSelect">Type de questions :</label>
      <select id="psTypeSelect" class="quiz-select">
        <option value="all">🎲 Toutes les questions mélangées</option>
        <option value="theme-instrument">🎼 Qui joue le thème ?</option>
        <option value="plan-sonore">🎧 Quel plan sonore ?</option>
      </select>
    </div>
  </div>

  <!-- Progression de la partie -->
  <div id="psProgressBox" class="progress-box">
    <div class="progress-text">
      <span id="psProgressLabel">Question 1 / {plansSonoresList.length}</span>
      <span id="psScoreLabel" class="score-label">Score : 0</span>
    </div>
    <div class="progress-bar"><div id="psProgressFill" class="progress-fill"></div></div>
  </div>

  <!-- Zone de Question Dynamique -->
  <div id="psQuestionContainer" class="question-container"></div>

  <!-- Zone de Choix / Réponses -->
  <div id="psOptionsContainer" class="options-search"></div>

  <div id="psQuizFeedback" class="feedback-msg hidden"></div>

  <!-- Validation & Suivant -->
  <div id="psActionFooter" class="action-footer">
    <button id="psBtnNext" class="btn-next" disabled>Question Suivante ➔</button>
  </div>

  <!-- Écran de résultat final -->
  <div id="psResultContainer" class="result-container hidden"></div>
</div>

<script>
  import { shuffle } from '../utils/random';
  import { showQuizResult } from '../utils/quizUi';
  import { createAudioQuestionBox, createInstrumentSearchBox, h } from '../utils/dom';
  import { QuizSession } from '../utils/quizSession';
  const { plansSonoresList, allInstrumentsList } = await import('../data/plansSonoresData');
  import type { PlansSonoresItem } from '../data/plansSonoresData';
  import { relativeUrl } from '../utils/navigation';
  import {
    getAudioState,
    getCurrentAudioUrl,
    onAudioEvent,
    pauseAudio,
    playAudio,
    resumeAudio,
    stopAudio,
  } from '../utils/audioManager';

  type QuestionFilter = 'all' | PlansSonoresItem['type'];
  type PlayState = 'idle' | 'playing' | 'paused' | 'ended';

  const PLAN_OPTIONS = [
    'Un thème seul',
    'Un accompagnement seul',
    'Un thème et un accompagnement',
  ];

  let currentQuestion: PlansSonoresItem | null = null;
  let currentFilter: QuestionFilter = 'all';
  let btnPlay: HTMLButtonElement | null = null;

  // État de la partie
  let queue: PlansSonoresItem[] = [];

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const typeSelect = $<HTMLSelectElement>('psTypeSelect');
  const progressBox = $<HTMLDivElement>('psProgressBox');
  const progressLabel = $<HTMLSpanElement>('psProgressLabel');
  const scoreLabel = $<HTMLSpanElement>('psScoreLabel');
  const progressFill = $<HTMLDivElement>('psProgressFill');
  const questionContainer = $<HTMLDivElement>('psQuestionContainer');
  const optionsContainer = $<HTMLDivElement>('psOptionsContainer');
  const quizFeedback = $<HTMLDivElement>('psQuizFeedback');
  const actionFooter = $<HTMLDivElement>('psActionFooter');
  const resultContainer = $<HTMLDivElement>('psResultContainer');
  const btnNext = $<HTMLButtonElement>('psBtnNext');

  // --- Utilitaires -------------------------------------------------------

  // Minuscules + suppression des accents ("Flûte" -> "flute")
  function normalize(str: string): string {
    return str
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');
  }

  // Normalisation pour la comparaison de réponses libres :
  // sans accents, sans article, sans ponctuation ni espaces
  function normalizeAnswer(str: string): string {
    return normalize(str)
      .trim()
      .replace(/’/g, "'")
      .replace(/^(l'|d')\s*/, '')
      .replace(/^(les|le|la|une|un|des|du|de la|de l')\s+/, '')
      .replace(/[^a-z0-9]/g, '');
  }

  function levenshtein(a: string, b: string): number {
    const dp: number[][] = Array.from({ length: a.length + 1 }, (_, i) => [i]);
    for (let j = 1; j <= b.length; j++) dp[0][j] = j;
    for (let i = 1; i <= a.length; i++) {
      for (let j = 1; j <= b.length; j++) {
        dp[i][j] = Math.min(
          dp[i - 1][j] + 1,
          dp[i][j - 1] + 1,
          dp[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1)
        );
      }
    }
    return dp[a.length][b.length];
  }

  // Réponse libre correcte ? (tolère 1 faute de frappe sur les noms de 5 lettres et +)
  function isTypedAnswerCorrect(typed: string, expectedName: string): boolean {
    const t = normalizeAnswer(typed);
    const e = normalizeAnswer(expectedName);
    if (!t) return false;
    if (t === e) return true;
    return e.length >= 5 && levenshtein(t, e) <= 1;
  }

  function getFilteredQuestions(): PlansSonoresItem[] {
    if (currentFilter === 'all') return plansSonoresList;
    return plansSonoresList.filter(q => q.type === currentFilter);
  }

  // --- Lecture audio -----------------------------------------------------
  // Le gestionnaire centralisé coupe l'extrait précédent, applique le volume
  // master et expose l'état réel du lecteur (lecture / pause / fin).

  const PLAY_LABELS: Record<PlayState, string> = {
    idle: "🔊 Écouter l'extrait",
    playing: '⏸ Mettre en pause',
    paused: '▶️ Reprendre',
    ended: '🔁 Réécouter',
  };

  function setPlayState(state: PlayState) {
    if (btnPlay) btnPlay.textContent = PLAY_LABELS[state];
  }

  // Le libellé du bouton suit l'état réel du lecteur (lecture / pause / fin)
  onAudioEvent('statechange', ({ state }) => {
    if (state === 'playing') setPlayState('playing');
    else if (state === 'paused') setPlayState('paused');
    else if (state === 'ended') setPlayState('ended');
    else if (state === 'idle' || state === 'error') setPlayState('idle');
  });

  // Les MP3 sont dans /public : on ajoute le BASE_URL d'Astro (GitHub Pages).
  function playSound(url: string) {
    void playAudio(relativeUrl(url));
  }

  function stopSound() {
    stopAudio();
  }

  // Bouton unique : écouter -> pause -> reprendre -> réécouter
  function togglePlay() {
    if (!currentQuestion) return;

    const url = relativeUrl(currentQuestion.audioUrl);
    const state = getAudioState();

    if (state === 'playing') {
      pauseAudio();
      return;
    }
    if (state === 'paused' && getCurrentAudioUrl() === url) {
      void resumeAudio();
      return;
    }
    playSound(currentQuestion.audioUrl);
  }

  // --- Saisie avec suggestions (questions « instrument du thème ») -------
  // La liste n'apparaît que lorsque l'élève a tapé au moins une lettre.

  function buildSearchBox(): HTMLDivElement {
    const pool = [...allInstrumentsList].sort((a, b) => a.localeCompare(b, 'fr'));

    const wrapper = createInstrumentSearchBox();

    const input = wrapper.querySelector('.search-input') as HTMLInputElement;
    const list = wrapper.querySelector('.search-list') as HTMLUListElement;
    const btnValidate = wrapper.querySelector('.btn-validate') as HTMLButtonElement;
    let matches: string[] = [];
    let activeIndex = -1; // -1 = aucune suggestion sélectionnée au clavier

    function finish(isCorrect: boolean) {
      input.disabled = true;
      btnValidate.disabled = true;
      list.classList.add('hidden');
      checkAnswer(isCorrect, input);
    }

    function computeMatches() {
      const q = normalize(input.value.trim());
      if (!q) {
        matches = [];
        return;
      }
      // Un mot du nom doit commencer par ce qui est tapé
      // ("trav" trouve "Flûte traversière", "vio" trouve Violon et Violoncelle)
      matches = pool.filter(name =>
        normalize(name)
          .split(/[\s-]+/)
          .some(word => word.startsWith(q))
      );
    }

    function renderList() {
      computeMatches();
      list.replaceChildren();

      // Rien de tapé : aucune liste affichée
      if (!input.value.trim()) {
        list.classList.add('hidden');
        return;
      }

      list.classList.remove('hidden');

      if (matches.length === 0) {
        const empty = document.createElement('li');
        empty.className = 'search-empty';
        empty.textContent = 'Aucun instrument ne correspond…';
        list.appendChild(empty);
        return;
      }

      if (activeIndex >= matches.length) activeIndex = -1;

      matches.forEach((name, idx) => {
        const li = document.createElement('li');
        li.className = 'search-item' + (idx === activeIndex ? ' active' : '');
        li.setAttribute('role', 'option');
        li.textContent = name;
        li.addEventListener('click', () => choose(name));
        list.appendChild(li);
      });

      const active = list.querySelector('.search-item.active');
      if (active) active.scrollIntoView({ block: 'nearest' });
    }

    // Clic sur une suggestion : validation immédiate
    function choose(name: string) {
      if (session.isAnswered || !currentQuestion) return;
      input.value = name;
      finish(normalizeAnswer(name) === normalizeAnswer(currentQuestion.correctAnswer));
    }

    // Validation du texte tel qu'il est écrit
    function submitTyped() {
      if (session.isAnswered || !currentQuestion) return;
      if (!input.value.trim()) return;
      finish(isTypedAnswerCorrect(input.value, currentQuestion.correctAnswer));
    }

    input.addEventListener('input', () => {
      activeIndex = -1;
      renderList();
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (matches.length) activeIndex = (activeIndex + 1) % matches.length;
        renderList();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (matches.length) activeIndex = activeIndex <= 0 ? matches.length - 1 : activeIndex - 1;
        renderList();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (activeIndex >= 0 && matches[activeIndex]) {
          choose(matches[activeIndex]);
        } else {
          submitTyped();
        }
      }
    });

    btnValidate.addEventListener('click', submitTyped);

    return wrapper;
  }

  // --- Boutons de réponse (questions « plan sonore ») ---------------------

  function buildPlanOptions() {
    PLAN_OPTIONS.forEach(label => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn-option';
      btn.textContent = label;
      btn.addEventListener('click', () => {
        if (session.isAnswered || !currentQuestion) return;
        optionsContainer.querySelectorAll<HTMLButtonElement>('.btn-option').forEach(b => (b.disabled = true));
        checkAnswer(label === currentQuestion.correctAnswer, btn);
      });
      optionsContainer.appendChild(btn);
    });
  }

  // --- Partie : démarrage, questions, résultat ---------------------------

  // autoPlay = true : le son démarre tout de suite
  function checkAnswer(isCorrect: boolean, element: HTMLElement) {
    if (session.isAnswered || !currentQuestion) return;

    if (isCorrect) {
      element.classList.add('correct');
    } else {
      element.classList.add('incorrect');
    }

    session.answer(isCorrect, '');
  }

  const session = new QuizSession({
    unit: 'question',
    progress: { progressLabel, scoreLabel, progressFill },
    nextBtn: btnNext,
    feedback: quizFeedback,
    result: {
      hide: [progressBox, questionContainer, optionsContainer, actionFooter],
      container: resultContainer,
      restartId: 'psBtnRestart',
    },
    game: [progressBox, questionContainer, optionsContainer, actionFooter],
    renderQuestion: (index, autoplay) => {
      stopSound();
      const q = queue[index];
      currentQuestion = q;

      questionContainer.replaceChildren();
      optionsContainer.replaceChildren();

      const isInstrumentQuestion = q.type === 'theme-instrument';
      const prompt: Array<Node | string> = isInstrumentQuestion
        ? ["Écoute l'extrait : quel instrument joue le ", h('strong', {}, 'thème'), ' (la mélodie principale) ?']
        : ["Écoute l'extrait : qu'entends-tu ?"];

      questionContainer.replaceChildren(createAudioQuestionBox(prompt, PLAY_LABELS.idle, 'psBtnPlay', 'button'));
      btnPlay = $<HTMLButtonElement>('psBtnPlay');
      btnPlay.addEventListener('click', togglePlay);
      if (autoplay) playSound(q.audioUrl);

      if (isInstrumentQuestion) {
        // Saisie libre, suggestions seulement pendant la frappe
        optionsContainer.className = 'options-search';
        optionsContainer.appendChild(buildSearchBox());
      } else {
        // 3 boutons : thème seul / accompagnement seul / thème + accompagnement
        optionsContainer.className = 'options-text';
        buildPlanOptions();
      }
    },
    showResult: (score, total) => {
      stopSound();
      showQuizResult({
        hide: [progressBox, questionContainer, optionsContainer, actionFooter],
        feedback: quizFeedback,
        container: resultContainer,
        score,
        total,
        restartId: 'psBtnRestart',
        onRestart: () => startGame(true),
      });
    },
    onRestart: () => startGame(true),
  });

  function startGame(autoPlay = false) {
    stopSound();
    // Tous les extraits du type choisi, chacun une seule fois, dans un ordre aléatoire
    queue = shuffle(getFilteredQuestions());
    session.start(queue.length, autoPlay);
  }

  // --- Événements ---------------------------------------------------------

  // Changer le type de questions relance une nouvelle partie
  typeSelect.addEventListener('change', () => {
    currentFilter = typeSelect.value as QuestionFilter;
    startGame();
  });

  btnNext.addEventListener('click', () => session.next());

  startGame();
</script>

<!--
  is:global est indispensable : Astro "scope" les styles avec un attribut
  data-astro-cid ajouté uniquement aux éléments du template. Les éléments créés par
  le script (boutons, champ de saisie, liste de suggestions) ne l'ont pas et ne
  recevraient aucun style. Tous les sélecteurs sont préfixés par .quiz-card pour
  ne pas affecter le reste du site. Ce CSS est identique à celui de TimbreQuiz.astro,
  seul le bloc « Boutons de réponse (plan sonore) » est propre à ce composant.
-->
<style is:global>
  

  

  

  

  /* --- Progression --- */
  

  

  /* --- Saisie / recherche (questions « instrument du thème ») --- */
  

  

  

  

  

  

  

  

  

  

  

  

  

  

  

  

  

  /* --- Boutons de réponse (plan sonore) : même style que les cartes de TimbreQuiz --- */
  

  

  

  /* --- Écran de résultat --- */
  </style>

---
import { plansSonoresList } from '../data/plansSonoresData';
---

<div class="fuzeau-card plans-sonores-card">
  <div class="fuzeau-header">
    <span class="badge">Écoute &amp; Analyse</span>
    <h4>Jeu : Reconnaître les Plans Sonores</h4>
  </div>

  <!-- Barre de filtres (Type de question) -->
  <div class="filters-bar">
    <div class="filter-group">
      <label for="psTypeSelect">Type de questions :</label>
      <select id="psTypeSelect" class="quiz-select">
        <option value="all">🎲 Toutes les questions mélangées</option>
        <option value="theme-instrument">🎼 Qui joue le thème ?</option>
        <option value="plan-sonore">🎧 Quel plan sonore ?</option>
      </select>
    </div>
  </div>

  <!-- Progression de la partie -->
  <div id="psProgressBox" class="progress-box">
    <div class="progress-text">
      <span id="psProgressLabel">Question 1 / {plansSonoresList.length}</span>
      <span id="psScoreLabel" class="score-label">Score : 0</span>
    </div>
    <div class="progress-bar"><div id="psProgressFill" class="progress-fill"></div></div>
  </div>

  <!-- Zone de Question Dynamique -->
  <div id="psQuestionContainer" class="question-container"></div>

  <!-- Zone de Choix / Réponses -->
  <div id="psOptionsContainer" class="options-grid"></div>

  <div id="psQuizFeedback" class="feedback-msg hidden"></div>

  <!-- Validation & Suivant -->
  <div id="psActionFooter" class="action-footer">
    <button id="psBtnNext" class="btn-next" disabled>Question Suivante ➔</button>
  </div>

  <!-- Écran de résultat final -->
  <div id="psResultContainer" class="result-container hidden"></div>
</div>

<script>
  import { shuffle } from '../utils/random';
  import { plansSonoresList, allInstrumentsList } from '../data/plansSonoresData';
  import type { PlansSonoresItem } from '../data/plansSonoresData';
  import { relativeUrl } from '../utils/navigation';
  import {
    getAudioState,
    getCurrentAudioUrl,
    onAudioEvent,
    pauseAudio,
    playAudio,
    resumeAudio,
    stopAudio,
  } from '../utils/audioManager';

  type QuestionFilter = 'all' | PlansSonoresItem['type'];
  type PlayState = 'idle' | 'playing' | 'paused' | 'ended';

  const PLAN_OPTIONS = [
    'Un thème seul',
    'Un accompagnement seul',
    'Un thème et un accompagnement',
  ];

  let currentQuestion: PlansSonoresItem | null = null;
  let currentFilter: QuestionFilter = 'all';
  let isAnswered = false;
  let btnPlay: HTMLButtonElement | null = null;

  // État de la partie
  let queue: PlansSonoresItem[] = [];
  let questionIndex = 0;
  let score = 0;

  // Passage automatique à la question suivante après une BONNE réponse uniquement
  const AUTO_NEXT_DELAY = 1200; // en millisecondes
  let autoNextTimer: ReturnType<typeof setTimeout> | null = null;

  function clearAutoNext() {
    if (autoNextTimer) {
      clearTimeout(autoNextTimer);
      autoNextTimer = null;
    }
  }

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const typeSelect = $<HTMLSelectElement>('psTypeSelect');
  const progressBox = $<HTMLDivElement>('psProgressBox');
  const progressLabel = $<HTMLSpanElement>('psProgressLabel');
  const scoreLabel = $<HTMLSpanElement>('psScoreLabel');
  const progressFill = $<HTMLDivElement>('psProgressFill');
  const questionContainer = $<HTMLDivElement>('psQuestionContainer');
  const optionsContainer = $<HTMLDivElement>('psOptionsContainer');
  const quizFeedback = $<HTMLDivElement>('psQuizFeedback');
  const actionFooter = $<HTMLDivElement>('psActionFooter');
  const resultContainer = $<HTMLDivElement>('psResultContainer');
  const btnNext = $<HTMLButtonElement>('psBtnNext');

  // --- Utilitaires -------------------------------------------------------

  // Minuscules + suppression des accents ("Flûte" -> "flute")
  function normalize(str: string): string {
    return str
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');
  }

  // Normalisation pour la comparaison de réponses libres :
  // sans accents, sans article, sans ponctuation ni espaces
  function normalizeAnswer(str: string): string {
    return normalize(str)
      .trim()
      .replace(/’/g, "'")
      .replace(/^(l'|d')\s*/, '')
      .replace(/^(les|le|la|une|un|des|du|de la|de l')\s+/, '')
      .replace(/[^a-z0-9]/g, '');
  }

  function levenshtein(a: string, b: string): number {
    const dp: number[][] = Array.from({ length: a.length + 1 }, (_, i) => [i]);
    for (let j = 1; j <= b.length; j++) dp[0][j] = j;
    for (let i = 1; i <= a.length; i++) {
      for (let j = 1; j <= b.length; j++) {
        dp[i][j] = Math.min(
          dp[i - 1][j] + 1,
          dp[i][j - 1] + 1,
          dp[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1)
        );
      }
    }
    return dp[a.length][b.length];
  }

  // Réponse libre correcte ? (tolère 1 faute de frappe sur les noms de 5 lettres et +)
  function isTypedAnswerCorrect(typed: string, expectedName: string): boolean {
    const t = normalizeAnswer(typed);
    const e = normalizeAnswer(expectedName);
    if (!t) return false;
    if (t === e) return true;
    return e.length >= 5 && levenshtein(t, e) <= 1;
  }

  function getFilteredQuestions(): PlansSonoresItem[] {
    if (currentFilter === 'all') return plansSonoresList;
    return plansSonoresList.filter(q => q.type === currentFilter);
  }

  // --- Article devant le nom d'un instrument -----------------------------
  // Voyelle ou « h » muet  -> l'   (l'accordéon, l'alto, l'orgue)
  // Nom féminin            -> la   (la flûte, la clarinette, la batterie)
  // Sinon                  -> le   (le violon, le saxophone, le trombone)
  // Attention : « harpe » et « hautbois » ont un « h » aspiré (la harpe, le hautbois),
  // ils ne font donc PAS d'élision. Seuls les « h » muets sont listés ci-dessous.

  const SILENT_H_WORDS = new Set(['harmonica', 'harmonium']);

  // Premier mot (sans accent) des instruments féminins
  const FEMININE_WORDS = new Set([
    'flute', 'clarinette', 'guitare', 'batterie', 'harpe', 'basse',
    'contrebasse', 'trompette', 'timbale', 'viole', 'mandoline',
    'cornemuse', 'lyre', 'cithare', 'vielle',
  ]);

  function withArticle(instrumentName: string): string {
    const lower = instrumentName.trim().toLowerCase();
    const firstWord = normalize(lower).split(/[\s-]+/)[0];

    if (/^[aeiou]/.test(firstWord) || SILENT_H_WORDS.has(firstWord)) return `l'${lower}`;
    if (FEMININE_WORDS.has(firstWord)) return `la ${lower}`;
    return `le ${lower}`;
  }

  // « Un thème seul » -> « un thème seul » (pour l'inclure dans une phrase)
  function lowerFirst(text: string): string {
    return text.charAt(0).toLowerCase() + text.slice(1);
  }

  // --- Lecture audio -----------------------------------------------------
  // Le gestionnaire centralisé coupe l'extrait précédent, applique le volume
  // master et expose l'état réel du lecteur (lecture / pause / fin).

  const PLAY_LABELS: Record<PlayState, string> = {
    idle: "🔊 Écouter l'extrait",
    playing: '⏸ Mettre en pause',
    paused: '▶️ Reprendre',
    ended: '🔁 Réécouter',
  };

  function setPlayState(state: PlayState) {
    if (btnPlay) btnPlay.textContent = PLAY_LABELS[state];
  }

  // Le libellé du bouton suit l'état réel du lecteur (lecture / pause / fin)
  onAudioEvent('statechange', ({ state }) => {
    if (state === 'playing') setPlayState('playing');
    else if (state === 'paused') setPlayState('paused');
    else if (state === 'ended') setPlayState('ended');
    else if (state === 'idle' || state === 'error') setPlayState('idle');
  });

  // Les MP3 sont dans /public : on ajoute le BASE_URL d'Astro (GitHub Pages).
  function playSound(url: string) {
    void playAudio(relativeUrl(url));
  }

  function stopSound() {
    stopAudio();
  }

  // Bouton unique : écouter -> pause -> reprendre -> réécouter
  function togglePlay() {
    if (!currentQuestion) return;

    const url = relativeUrl(currentQuestion.audioUrl);
    const state = getAudioState();

    if (state === 'playing') {
      pauseAudio();
      return;
    }
    if (state === 'paused' && getCurrentAudioUrl() === url) {
      void resumeAudio();
      return;
    }
    playSound(currentQuestion.audioUrl);
  }

  // --- Progression et score ----------------------------------------------

  function updateProgress() {
    const total = queue.length;
    progressLabel.textContent = `Question ${questionIndex + 1} / ${total}`;
    scoreLabel.textContent = `Score : ${score}`;
    // La barre avance quand la question est répondue
    const done = questionIndex + (isAnswered ? 1 : 0);
    progressFill.style.width = `${(done / total) * 100}%`;
  }

  function updateNextButton() {
    const isLast = questionIndex >= queue.length - 1;
    btnNext.textContent = isLast ? '🏁 Voir mon score' : 'Question Suivante ➔';
    btnNext.disabled = !isAnswered;
  }

  // --- Saisie avec suggestions (questions « instrument du thème ») -------
  // La liste n'apparaît que lorsque l'élève a tapé au moins une lettre.

  function buildSearchBox(): HTMLDivElement {
    const pool = [...allInstrumentsList].sort((a, b) => a.localeCompare(b, 'fr'));

    const wrapper = document.createElement('div');
    wrapper.className = 'search-box';
    wrapper.innerHTML = `
      <div class="search-row">
        <input
          type="text"
          class="search-input"
          placeholder="Écris le nom de l'instrument…"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          aria-label="Nom de l'instrument"
        />
        <button type="button" class="btn-validate">Valider</button>
      </div>
      <ul class="search-list hidden" role="listbox"></ul>
    `;

    const input = wrapper.querySelector('.search-input') as HTMLInputElement;
    const list = wrapper.querySelector('.search-list') as HTMLUListElement;
    const btnValidate = wrapper.querySelector('.btn-validate') as HTMLButtonElement;
    let matches: string[] = [];
    let activeIndex = -1; // -1 = aucune suggestion sélectionnée au clavier

    function finish(isCorrect: boolean) {
      input.disabled = true;
      btnValidate.disabled = true;
      list.classList.add('hidden');
      checkAnswer(isCorrect, input);
    }

    function computeMatches() {
      const q = normalize(input.value.trim());
      if (!q) {
        matches = [];
        return;
      }
      // Un mot du nom doit commencer par ce qui est tapé
      // ("trav" trouve "Flûte traversière", "vio" trouve Violon et Violoncelle)
      matches = pool.filter(name =>
        normalize(name)
          .split(/[\s-]+/)
          .some(word => word.startsWith(q))
      );
    }

    function renderList() {
      computeMatches();
      list.innerHTML = '';

      // Rien de tapé : aucune liste affichée
      if (!input.value.trim()) {
        list.classList.add('hidden');
        return;
      }

      list.classList.remove('hidden');

      if (matches.length === 0) {
        const empty = document.createElement('li');
        empty.className = 'search-empty';
        empty.textContent = 'Aucun instrument ne correspond…';
        list.appendChild(empty);
        return;
      }

      if (activeIndex >= matches.length) activeIndex = -1;

      matches.forEach((name, idx) => {
        const li = document.createElement('li');
        li.className = 'search-item' + (idx === activeIndex ? ' active' : '');
        li.setAttribute('role', 'option');
        li.textContent = name;
        li.addEventListener('click', () => choose(name));
        list.appendChild(li);
      });

      const active = list.querySelector('.search-item.active');
      if (active) active.scrollIntoView({ block: 'nearest' });
    }

    // Clic sur une suggestion : validation immédiate
    function choose(name: string) {
      if (isAnswered || !currentQuestion) return;
      input.value = name;
      finish(normalizeAnswer(name) === normalizeAnswer(currentQuestion.correctAnswer));
    }

    // Validation du texte tel qu'il est écrit
    function submitTyped() {
      if (isAnswered || !currentQuestion) return;
      if (!input.value.trim()) return;
      finish(isTypedAnswerCorrect(input.value, currentQuestion.correctAnswer));
    }

    input.addEventListener('input', () => {
      activeIndex = -1;
      renderList();
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (matches.length) activeIndex = (activeIndex + 1) % matches.length;
        renderList();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (matches.length) activeIndex = activeIndex <= 0 ? matches.length - 1 : activeIndex - 1;
        renderList();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (activeIndex >= 0 && matches[activeIndex]) {
          choose(matches[activeIndex]);
        } else {
          submitTyped();
        }
      }
    });

    btnValidate.addEventListener('click', submitTyped);

    return wrapper;
  }

  // --- Boutons de réponse (questions « plan sonore ») ---------------------

  function buildPlanOptions() {
    PLAN_OPTIONS.forEach(label => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn-option';
      btn.textContent = label;
      btn.addEventListener('click', () => {
        if (isAnswered || !currentQuestion) return;
        optionsContainer.querySelectorAll<HTMLButtonElement>('.btn-option').forEach(b => (b.disabled = true));
        checkAnswer(label === currentQuestion.correctAnswer, btn);
      });
      optionsContainer.appendChild(btn);
    });
  }

  // --- Partie : démarrage, questions, résultat ---------------------------

  // autoPlay = true : le son démarre tout de suite
  function startGame(autoPlay = false) {
    clearAutoNext();
    stopSound();
    score = 0;
    questionIndex = 0;

    // Tous les extraits du type choisi, chacun une seule fois, dans un ordre aléatoire
    queue = shuffle(getFilteredQuestions());

    resultContainer.classList.add('hidden');
    resultContainer.innerHTML = '';
    progressBox.classList.remove('hidden');
    questionContainer.classList.remove('hidden');
    optionsContainer.classList.remove('hidden');
    actionFooter.classList.remove('hidden');

    loadQuestion(autoPlay);
  }

  // autoPlay = false par défaut : à la toute première question (chargement de
  // la page) le son ne se lance pas. Il se lance seulement après un clic
  // « Question Suivante » ou « Recommencer ».
  function loadQuestion(autoPlay = false) {
    clearAutoNext();
    isAnswered = false;
    quizFeedback.className = 'feedback-msg hidden';
    stopSound();

    const q = queue[questionIndex];
    currentQuestion = q;
    updateProgress();
    updateNextButton();

    questionContainer.innerHTML = '';
    optionsContainer.innerHTML = '';

    const isInstrumentQuestion = q.type === 'theme-instrument';
    const prompt = isInstrumentQuestion
      ? "Écoute l'extrait : quel instrument joue le <strong>thème</strong> (la mélodie principale) ?"
      : "Écoute l'extrait : qu'entends-tu ?";

    questionContainer.innerHTML = `
      <div class="audio-q-box">
        <p>${prompt}</p>
        <button type="button" id="psBtnPlay" class="btn-play-sound">${PLAY_LABELS.idle}</button>
      </div>
    `;
    btnPlay = $<HTMLButtonElement>('psBtnPlay');
    btnPlay.addEventListener('click', togglePlay);
    if (autoPlay) playSound(q.audioUrl);

    if (isInstrumentQuestion) {
      // Saisie libre, suggestions seulement pendant la frappe
      optionsContainer.className = 'options-search';
      optionsContainer.appendChild(buildSearchBox());
    } else {
      // 3 boutons : thème seul / accompagnement seul / thème + accompagnement
      optionsContainer.className = 'options-text';
      buildPlanOptions();
    }
  }

  function checkAnswer(isCorrect: boolean, element: HTMLElement) {
    if (isAnswered || !currentQuestion) return;
    isAnswered = true;

    // Instrument -> « la clarinette », « l'accordéon », « le violon »
    // Plan sonore -> « un thème seul »
    const answer = currentQuestion.type === 'theme-instrument'
      ? withArticle(currentQuestion.correctAnswer)
      : lowerFirst(currentQuestion.correctAnswer);

    if (isCorrect) {
      score++;
      element.classList.add('correct');
      quizFeedback.textContent = currentQuestion.type === 'theme-instrument'
        ? `✨ Bravo ! C'est bien ${answer}.`
        : `✨ Bravo ! C'est bien : ${answer}.`;
      quizFeedback.className = 'feedback-msg success';
      autoNextTimer = setTimeout(goToNext, AUTO_NEXT_DELAY);
    } else {
      element.classList.add('incorrect');
      quizFeedback.textContent = `❌ Dommage ! La bonne réponse était : ${answer}.`;
      quizFeedback.className = 'feedback-msg error';
    }

    updateProgress();
    updateNextButton();
  }

  function getResultMessage(note: number, total: number) {
    const ratio = note / total;
    if (ratio === 1) return { emoji: '🏆', text: "Parfait ! Tu as l'oreille d'un musicien d'orchestre !" };
    if (ratio >= 0.8) return { emoji: '🌟', text: 'Excellent travail, tu distingues très bien les plans sonores !' };
    if (ratio >= 0.5) return { emoji: '👍', text: 'Bien joué ! Encore un petit effort pour progresser.' };
    return { emoji: '💪', text: "Continue à t'entraîner, tu vas y arriver !" };
  }

  function showResult() {
    stopSound();
    const total = queue.length;
    const { emoji, text } = getResultMessage(score, total);

    progressBox.classList.add('hidden');
    questionContainer.classList.add('hidden');
    optionsContainer.classList.add('hidden');
    actionFooter.classList.add('hidden');
    quizFeedback.className = 'feedback-msg hidden';

    resultContainer.innerHTML = `
      <div class="result-emoji">${emoji}</div>
      <p class="result-title">Partie terminée !</p>
      <p class="result-score"><span class="result-note">${score}</span> / ${total}</p>
      <p class="result-text">${text}</p>
      <button id="psBtnRestart" class="btn-restart">🔄 Recommencer</button>
    `;
    resultContainer.classList.remove('hidden');
    $<HTMLButtonElement>('psBtnRestart').addEventListener('click', () => startGame(true));
  }

  // --- Événements ---------------------------------------------------------

  // Changer le type de questions relance une nouvelle partie
  typeSelect.addEventListener('change', () => {
    currentFilter = typeSelect.value as QuestionFilter;
    startGame();
  });

  // Utilisé par le bouton « Suivant » ET par le minuteur après une bonne réponse
  function goToNext() {
    clearAutoNext();
    if (!isAnswered) return;
    if (questionIndex >= queue.length - 1) {
      showResult();
    } else {
      questionIndex++;
      loadQuestion(true);
    }
  }

  btnNext.addEventListener('click', goToNext);

  startGame();
</script>

<!--
  is:global est indispensable : Astro "scope" les styles avec un attribut
  data-astro-cid ajouté uniquement aux éléments du template. Les éléments créés par
  le script (boutons, champ de saisie, liste de suggestions) ne l'ont pas et ne
  recevraient aucun style. Tous les sélecteurs sont préfixés par .fuzeau-card pour
  ne pas affecter le reste du site. Ce CSS est identique à celui de FuzeauQuiz.astro,
  seul le bloc « Boutons de réponse (plan sonore) » est propre à ce composant.
-->
<style is:global>
  .fuzeau-card {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 100%;
    overflow: hidden;
    box-sizing: border-box;
    container-type: inline-size;
  }

  .fuzeau-card * {
    box-sizing: border-box;
  }

  .fuzeau-card .hidden {
    display: none !important;
  }

  .fuzeau-card .fuzeau-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .fuzeau-card .badge {
    background: #e11d48;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .fuzeau-card .fuzeau-header h4 {
    margin: 0;
    color: #f1f5f9;
    font-size: 1.1rem;
  }

  .fuzeau-card .filters-bar {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    background: #1e293b;
    padding: 0.8rem;
    border-radius: 8px;
  }

  .fuzeau-card .filter-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
  }

  .fuzeau-card .filter-group label {
    font-size: 0.85rem;
    color: #cbd5e1;
    font-weight: 600;
  }

  .fuzeau-card .quiz-select {
    background: #0f172a;
    color: #f8fafc;
    border: 1px solid #475569;
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    font-size: 0.85rem;
    min-width: 0;
    max-width: 100%;
    text-overflow: ellipsis;
  }

  /* --- Progression --- */
  .fuzeau-card .progress-box {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .fuzeau-card .progress-text {
    display: flex;
    justify-content: space-between;
    color: #cbd5e1;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .fuzeau-card .score-label {
    color: #38bdf8;
  }

  .fuzeau-card .progress-bar {
    height: 8px;
    background: #1e293b;
    border-radius: 999px;
    overflow: hidden;
  }

  .fuzeau-card .progress-fill {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, #0284c7, #38bdf8);
    border-radius: 999px;
    transition: width 0.3s ease;
  }

  .fuzeau-card .question-container {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.25rem;
    text-align: center;
    overflow: hidden;
    color: #f1f5f9;
  }

  .fuzeau-card .question-container p {
    margin: 0 0 0.75rem;
  }

  .fuzeau-card .btn-play-sound {
    background: #0284c7;
    color: #fff;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
  }

  .fuzeau-card .btn-play-sound:hover {
    background: #0369a1;
  }

  /* --- Saisie / recherche (questions « instrument du thème ») --- */
  .fuzeau-card .options-search {
    display: block;
    width: 100%;
  }

  .fuzeau-card .search-box {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  .fuzeau-card .search-row {
    display: flex;
    gap: 0.5rem;
    width: 100%;
  }

  .fuzeau-card .search-input {
    flex: 1;
    min-width: 0;
    background: #1e293b;
    color: #f8fafc;
    border: 2px solid #475569;
    border-radius: 6px;
    padding: 0.75rem 0.9rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .fuzeau-card .search-input:focus {
    outline: none;
    border-color: #38bdf8;
  }

  .fuzeau-card .search-input::placeholder {
    color: #94a3b8;
    font-weight: 400;
  }

  .fuzeau-card .search-input:disabled {
    opacity: 1;
    cursor: default;
  }

  .fuzeau-card .search-input.correct {
    background: #064e3b;
    border-color: #10b981;
    color: #a7f3d0;
  }

  .fuzeau-card .search-input.incorrect {
    background: #881337;
    border-color: #f43f5e;

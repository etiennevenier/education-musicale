---
import VideoCard from './VideoCard.astro';
import { relativeUrl } from '../utils/navigation';

interface MetissageVideo {
  badge: string;
  title: string;
  youtubeId: string;
}

interface MetissageTab {
  id: string;
  label: string;
  videos: MetissageVideo[];
}

const tabs: MetissageTab[] = [
  {
    id: 'lennon',
    label: 'Lennon',
    videos: [
      { badge: 'Original', title: 'Original — John Lennon', youtubeId: 'VOgFZfRVaww' },
      { badge: 'Reprise', title: 'Reprise — John Lennon', youtubeId: 'TdcoenxiDd8' },
    ],
  },
  {
    id: 'vivaldi',
    label: 'Vivaldi',
    videos: [
      { badge: 'Original', title: 'Original — Antonio Vivaldi', youtubeId: 'VBezMA7PL7c' },
      { badge: 'Reprise', title: 'Reprise — Antonio Vivaldi', youtubeId: 'DIGfO2Dgc9Y' },
    ],
  },
  {
    id: 'brel',
    label: 'Brel',
    videos: [
      { badge: 'Original', title: 'Original — Jacques Brel', youtubeId: 'i2wmKcBm4Ik' },
      { badge: 'Salsa', title: 'Version salsa — Jacques Brel', youtubeId: 's26JOW3x674' },
      { badge: 'Raï', title: 'Version raï — Jacques Brel', youtubeId: 'dcWDaN0nwO8' },
      { badge: 'Flamenco - Rumba Catalane', title: 'Version flamenco et rumba catalane — Jacques Brel', youtubeId: '2f93bd6Tb2s' },
      { badge: 'Jazz', title: 'Version jazz — Jacques Brel', youtubeId: 'P_mpmKJ_ORo' },
      { badge: 'Tango', title: 'Version tango — Jacques Brel', youtubeId: '4qxgLh8YwMU' },
      { badge: 'Ska - Reggae', title: 'Version ska et reggae — Jacques Brel', youtubeId: 'XBxZVn7TBh4' },
      { badge: 'Sketch', title: 'Sketch — Jacques Brel', youtubeId: 'GBmycYD_24M' },
    ],
  },
  {
    id: 'peinture',
    label: 'Peinture',
    videos: [],
  },
];

const pairOne = {
  base: relativeUrl('/metissage/Doc2FernandLeger.png'),
  top: relativeUrl('/metissage/Doc1JocondeLHOOQ.png'),
};

const pairTwo = {
  base: relativeUrl('/metissage/Doc3LesmeninesDiegoVelaz.jpg'),
  top: relativeUrl('/metissage/Doc4LesmeninesPicasso.jpg'),
};
---

<div class="metissage-course">
  <div class="metissage-tabs" role="tablist" aria-label="Musique et Métissage">
    {tabs.map((tab, index) => (
      <button
        type="button"
        role="tab"
        id={`metissage-tab-${tab.id}`}
        class="metissage-tab"
        aria-controls={`metissage-panel-${tab.id}`}
        aria-selected={index === 0 ? 'true' : 'false'}
        tabindex={index === 0 ? 0 : -1}
        data-tab={tab.id}
      >
        {tab.label}
      </button>
    ))}
  </div>

  {tabs.map((tab, index) => (
    <div
      role="tabpanel"
      id={`metissage-panel-${tab.id}`}
      class="metissage-panel"
      aria-labelledby={`metissage-tab-${tab.id}`}
      hidden={index !== 0}
      data-panel={tab.id}
    >
      {tab.videos.length > 0 && (
        <div class="metissage-videos">
          {tab.videos.map((video) => (
            <VideoCard
              badge={video.badge}
              title={video.title}
              url={`https://www.youtube.com/watch?v=${video.youtubeId}`}
            />
          ))}
        </div>
      )}

      {tab.id === 'peinture' && (
        <div class="metissage-paintings">
          <p class="metissage-hint">Faites glisser le curseur pour comparer les deux œuvres.</p>
          <figure class="metissage-pair">
            <div
              class="metissage-compare"
              data-compare
              data-title-a="Fernand Léger — La Joconde aux clés"
              data-title-b="Marcel Duchamp — L.H.O.O.Q."
              style="--pos: 50%;"
            >
              <div class="metissage-layers">
                <img
                  class="metissage-img metissage-img-base"
                  src={pairOne.base}
                  alt="Fernand Léger — La Joconde aux clés"
                  loading="lazy"
                />
                <img
                  class="metissage-img metissage-img-top"
                  src={pairOne.top}
                  alt="Marcel Duchamp — L.H.O.O.Q., la Joconde affublée d'une moustache"
                  loading="lazy"
                />
              </div>
              <div class="metissage-divider" aria-hidden="true">
                <span class="metissage-handle">↔</span>
              </div>
              <input
                type="range"
                class="metissage-range"
                min="0"
                max="100"
                value="50"
                step="1"
                aria-label="Comparer Fernand Léger et Marcel Duchamp"
              />
            </div>
            <figcaption class="metissage-title" data-title aria-live="polite" aria-atomic="true"></figcaption>
          </figure>

          <figure class="metissage-pair">
            <div
              class="metissage-compare"
              data-compare
              data-title-a="Diego Vélasquez — Les Ménines"
              data-title-b="Pablo Picasso — Les Ménines"
              style="--pos: 50%;"
            >
              <div class="metissage-layers">
                <img
                  class="metissage-img metissage-img-base"
                  src={pairTwo.base}
                  alt="Diego Vélasquez — Les Ménines"
                  loading="lazy"
                />
                <img
                  class="metissage-img metissage-img-top"
                  src={pairTwo.top}
                  alt="Pablo Picasso — Les Ménines, d'après Vélasquez"
                  loading="lazy"
                />
              </div>
              <div class="metissage-divider" aria-hidden="true">
                <span class="metissage-handle">↔</span>
              </div>
              <input
                type="range"
                class="metissage-range"
                min="0"
                max="100"
                value="50"
                step="1"
                aria-label="Comparer Diego Vélasquez et Pablo Picasso"
              />
            </div>
            <figcaption class="metissage-title" data-title aria-live="polite" aria-atomic="true"></figcaption>
          </figure>
        </div>
      )}
    </div>
  ))}
</div>

<script>
  const metissageRoot = document.querySelector<HTMLElement>('.metissage-course');

  if (metissageRoot) {
    const tabs = Array.from(metissageRoot.querySelectorAll<HTMLButtonElement>('.metissage-tab'));
    const panels = Array.from(metissageRoot.querySelectorAll<HTMLElement>('.metissage-panel'));

    const activateTab = (activeIndex: number, moveFocus = false) => {
      tabs.forEach((tab, index) => {
        const isActive = index === activeIndex;
        tab.setAttribute('aria-selected', String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
        if (isActive && moveFocus) {
          tab.focus();
        }
      });

      panels.forEach((panel, index) => {
        panel.hidden = index !== activeIndex;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activateTab(index));

      tab.addEventListener('keydown', (event) => {
        let nextIndex: number | null = null;

        if (event.key === 'ArrowRight') {
          nextIndex = (index + 1) % tabs.length;
        } else if (event.key === 'ArrowLeft') {
          nextIndex = (index - 1 + tabs.length) % tabs.length;
        } else if (event.key === 'Home') {
          nextIndex = 0;
        } else if (event.key === 'End') {
          nextIndex = tabs.length - 1;
        }

        if (nextIndex !== null) {
          event.preventDefault();
          activateTab(nextIndex, true);
        }
      });
    });

    metissageRoot.querySelectorAll<HTMLElement>('[data-compare]').forEach((comparison) => {
      const range = comparison.querySelector<HTMLInputElement>('.metissage-range');

      if (!range) {
        return;
      }

      const figure = comparison.closest('.metissage-pair');
      const title = figure?.querySelector<HTMLElement>('[data-title]');
      const titleA = comparison.dataset.titleA ?? '';
      const titleB = comparison.dataset.titleB ?? '';

      const updatePosition = () => {
        const value = Number(range.value);
        comparison.style.setProperty('--pos', `${value}%`);

        if (!title) {
          return;
        }

        if (value <= 10) {
          title.textContent = titleA;
        } else if (value >= 90) {
          title.textContent = titleB;
        } else {
          title.textContent = '';
        }
      };

      range.addEventListener('input', updatePosition);
      updatePosition();
    });
  }
</script>

<style>
  .metissage-course {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .metissage-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .metissage-tab {
    flex: 1 1 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 1.25rem;
    border-radius: 12px;
    border: 1px solid var(--border, #334155);
    background: #1e293b;
    color: var(--text-muted, #94a3b8);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
  }

  .metissage-tab::before {
    font-size: 1.1rem;
    line-height: 1;
  }

  .metissage-tab[data-tab='lennon']::before {
    content: '🎸';
  }

  .metissage-tab[data-tab='vivaldi']::before {
    content: '🎻';
  }

  .metissage-tab[data-tab='brel']::before {
    content: '🎤';
  }

  .metissage-tab[data-tab='peinture']::before {
    content: '🎨';
  }

  .metissage-tab:hover {
    border-color: var(--primary, #38bdf8);
    color: var(--text, #f1f5f9);
  }

  .metissage-tab[aria-selected='true'] {
    border-color: var(--primary, #38bdf8);
    color: var(--text, #f1f5f9);
    box-shadow: 0 0 0 1px var(--primary, #38bdf8), 0 0 16px rgba(56, 189, 248, 0.25);
  }

  .metissage-tab:focus-visible {
    outline: 2px solid var(--primary, #38bdf8);
    outline-offset: 2px;
  }

  .metissage-panel[hidden] {
    display: none;
  }

  .metissage-videos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .metissage-paintings {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  .metissage-hint {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--text-muted, #94a3b8);
    font-size: 0.9rem;
    line-height: 1.5;
    text-align: center;
  }

  .metissage-pair {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
  }

  .metissage-compare {
    --pos: 50%;
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--border, #334155);
    border-radius: 16px;
    background: #0f172a;
    box-shadow: 0 18px 40px rgba(2, 6, 23, 0.35);
    isolation: isolate;
    user-select: none;
    -webkit-user-select: none;
  }

  .metissage-layers {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 40%, rgba(56, 189, 248, 0.08), transparent 60%),
      #0f172a;
  }

  .metissage-img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .metissage-img-base {
    z-index: 0;
  }

  .metissage-img-top {
    z-index: 1;
    background: #0f172a;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .metissage-divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    z-index: 3;
    width: 2px;
    transform: translateX(-50%);
    background: linear-gradient(#38bdf8, #f8fafc, #38bdf8);
    box-shadow: 0 0 12px rgba(2, 6, 23, 0.8);
    pointer-events: none;
  }

  .metissage-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 2px solid #f8fafc;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.9);
    color: #f8fafc;
    font-size: 1.1rem;
    line-height: 1;
    box-shadow: 0 8px 20px rgba(2, 6, 23, 0.45);
    backdrop-filter: blur(6px);
    transform: translate(-50%, -50%);
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .metissage-compare:hover .metissage-handle {
    border-color: var(--primary, #38bdf8);
    color: var(--primary, #38bdf8);
    transform: translate(-50%, -50%) scale(1.06);
  }

  .metissage-compare:focus-within .metissage-handle {
    outline: 2px solid var(--primary, #38bdf8);
    outline-offset: 3px;
  }

  .metissage-range {
    position: absolute;
    inset: 0;
    z-index: 4;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    opacity: 0;
    cursor: ew-resize;
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    touch-action: pan-y;
  }

  .metissage-title {
    min-height: 1.5em;
    margin: 0;
    color: var(--text, #f1f5f9);
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.5;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .metissage-tab,
    .metissage-handle {
      transition: none;
    }

    .metissage-compare:hover .metissage-handle {
      transform: translate(-50%, -50%);
    }
  }
</style>

<style is:global>
  [data-panel='brel'] .video-badge {
    opacity: 0.05;
    transition: opacity 0.2s ease;
  }

  [data-panel='brel'] .video-card:hover .video-badge,
  [data-panel='brel'] .video-badge:hover {
    opacity: 1;
  }
</style>



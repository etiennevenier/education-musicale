---
import CourseTabs from './CourseTabs.astro';
import VideoCard from './VideoCard.astro';
import { relativeUrl } from '../utils/navigation';
import { geoNaturalEarth1, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import worldTopo from 'world-atlas/countries-110m.json';

const world: any = worldTopo;
const countries: any = feature(world, world.objects.countries);
countries.features = countries.features.filter((f: any) => f.id !== '010');
const projection = geoNaturalEarth1().fitExtent([[10, 10], [990, 490]], countries);
const countriesPath = geoPath(projection)(countries) ?? '';

interface MetissageVideo {
  badge: string;
  title: string;
  youtubeId: string;
}

interface MetissageTab {
  id: string;
  icon: string;
  label: string;
  videos: MetissageVideo[];
}

const tabs: MetissageTab[] = [
  {
    id: 'lennon',
    icon: '🎸',
    label: 'Lennon',
    videos: [
      { badge: 'Original', title: 'Original — John Lennon', youtubeId: 'VOgFZfRVaww' },
      { badge: 'Reprise', title: 'Reprise — John Lennon', youtubeId: 'TdcoenxiDd8' },
    ],
  },
  {
    id: 'vivaldi',
    icon: '🎻',
    label: 'Vivaldi',
    videos: [
      { badge: 'Original', title: 'Original — Antonio Vivaldi', youtubeId: 'VBezMA7PL7c' },
      { badge: 'Reprise', title: 'Reprise — Antonio Vivaldi', youtubeId: 'DIGfO2Dgc9Y' },
    ],
  },
  {
    id: 'brel',
    icon: '🎤',
    label: 'Brel',
    videos: [
      { badge: 'Original', title: 'Original — Jacques Brel', youtubeId: 'i2wmKcBm4Ik' },
      { badge: 'Salsa', title: 'Version salsa — Jacques Brel', youtubeId: 's26JOW3x674' },
      { badge: 'Raï', title: 'Version raï — Jacques Brel', youtubeId: 'dcWDaN0nwO8' },
      { badge: 'Flamenco - Rumba Catalane', title: 'Version flamenco et rumba catalane — Jacques Brel', youtubeId: '2f93bd6Tb2s' },
      { badge: 'Jazz', title: 'Version jazz — Jacques Brel', youtubeId: 'P_mpmKJ_ORo' },
      { badge: 'Tango', title: 'Version tango — Jacques Brel', youtubeId: '4qxgLh8YwMU' },
      { badge: 'Ska - Reggae', title: 'Version ska et reggae — Jacques Brel', youtubeId: 'XBxZVn7TBh4' },
      { badge: 'Sketch', title: 'Sketch — Jacques Brel', youtubeId: 'GBmycYD_24M' },
    ],
  },
  {
    id: 'voyage',
    icon: '🗺️',
    label: 'Voyage',
    videos: [],
  },
];

type Stop = { label: string; artist: string; year: string; details: string; lonLat: [number, number] };

interface VoyageData {
  num: number;
  title: string;
  from: Stop;
  to: Stop[];
}

const voyagesData: VoyageData[] = [
  {
    num: 1,
    title: '1. Misirlou',
    from: { label: 'Empire Ottoman (Izmir)', artist: 'Chanson traditionnelle Rebetiko', year: 'Début XXe', details: 'Air traditionnel partagé par les musiciens grecs, turcs et juifs', lonLat: [27.14, 38.42] },
    to: [
      { label: 'Californie (USA)', artist: 'Dick Dale / Pulp Fiction', year: '1962 / 1994', details: 'Accélération en Surf Rock puis réutilisé dans Pulp Fiction & Black Eyed Peas', lonLat: [-118.24, 34.05] }
    ],
  },
  {
    num: 2,
    title: '2. The Lion Sleeps Tonight (Mbube)',
    from: { label: 'Afrique du Sud (Johannesburg)', artist: 'Solomon Linda & Evening Birds', year: '1939', details: 'Création originale zoulou intitulée Mbube dans les townships', lonLat: [28.04, -26.20] },
    to: [
      { label: 'États-Unis (New York)', artist: 'The Tokens / Le Roi Lion', year: '1961', details: 'Réécrit sous le titre The Lion Sleeps Tonight, devenant l\'hymne du Roi Lion', lonLat: [-74.00, 40.71] }
    ],
  },
  {
    num: 3,
    title: '3. Bambino (Guaglione)',
    from: { label: 'Italie (Naples)', artist: 'Chanson napolitaine', year: '1956', details: 'Titre folklore italien Guaglione', lonLat: [14.26, 40.85] },
    to: [
      { label: 'Égypte (Le Caire)', artist: 'Dalida (Enfance)', year: '1956', details: 'Découvert et écouté par Dalida lors de sa jeunesse au Caire', lonLat: [31.23, 30.04] },
      { label: 'France (Paris)', artist: 'Dalida', year: '1956', details: 'Enregistré en français sous le nom Bambino à Paris, 1er grand tube', lonLat: [2.35, 48.86] }
    ],
  },
  {
    num: 4,
    title: '4. Comme d\'habitude ➔ My Way',
    from: { label: 'France (Paris)', artist: 'Claude François / Jacques Revaux', year: '1967', details: 'Chanson originale française sur la routine d\'un couple', lonLat: [2.35, 48.86] },
    to: [
      { label: 'États-Unis (New York)', artist: 'Paul Anka & Frank Sinatra', year: '1969', details: 'Droits rachetés par Paul Anka et réécrits pour Frank Sinatra (My Way)', lonLat: [-74.00, 40.71] }
    ],
  },
  {
    num: 5,
    title: '5. Mambo No. 5',
    from: { label: 'Mexique / Cuba', artist: 'Pérez Prado', year: '1949', details: 'Morceau Mambo instrumental latino original', lonLat: [-99.13, 19.43] },
    to: [
      { label: 'Allemagne (Munich)', artist: 'Lou Bega', year: '1999', details: 'Repris avec paroles pop et synthés, hit n°1 mondial', lonLat: [11.58, 48.14] }
    ],
  },
  {
    num: 6,
    title: '6. The Tide Is High',
    from: { label: 'Jamaïque (Kingston)', artist: 'The Paragons / John Holt', year: '1967', details: 'Chanson originale Rocksteady / Reggae jamaïcaine', lonLat: [-76.79, 17.97] },
    to: [
      { label: 'Royaume-Uni (Londres)', artist: 'Blondie', year: '1980', details: 'Reprise New Wave / Pop par le groupe britannique Blondie', lonLat: [-0.12, 51.50] }
    ],
  },
  {
    num: 7,
    title: '7. Mas que Nada',
    from: { label: 'Brésil (Rio de Janeiro)', artist: 'Jorge Ben / Sergio Mendes', year: '1963', details: 'Samba / Bossa Nova brésilienne légendaire', lonLat: [-43.17, -22.91] },
    to: [
      { label: 'États-Unis (Los Angeles)', artist: 'The Black Eyed Peas', year: '2006', details: 'Fusion Bossa Nova et Hip-Hop américain avec Sergio Mendes', lonLat: [-118.24, 34.05] }
    ],
  },
  {
    num: 8,
    title: '8. Lambada (Llorando se fue)',
    from: { label: 'Bolivie (La Paz)', artist: 'Los Kjarkas', year: '1981', details: 'Musique andine traditionnelle "Llorando se fue"', lonLat: [-68.11, -16.49] },
    to: [
      { label: 'France (Paris)', artist: 'Kaoma', year: '1989', details: 'Adaptation en Lambada brésilienne / pop produite en France, tube de l\'été mondial', lonLat: [2.35, 48.86] }
    ],
  },
  {
    num: 9,
    title: '9. Habanera (Carmen)',
    from: { label: 'Cuba (La Havane)', artist: 'Danse Habanera traditionnelle', year: 'XIXe s.', details: 'Rythme créole traditionnel originaire de La Havane', lonLat: [-82.36, 23.11] },
    to: [
      { label: 'Espagne (Madrid)', artist: 'Sebastián Iradier', year: '1860', details: 'Mélodie transcrite par le compositeur espagnol Iradier (El Arreglito)', lonLat: [-3.70, 40.41] },
      { label: 'France (Paris)', artist: 'Georges Bizet', year: '1875', details: 'Intégré dans l\'Opéra Carmen de Bizet à Paris', lonLat: [2.35, 48.86] },
      { label: 'Belgique (Bruxelles)', artist: 'Stromae', year: '2013', details: 'Réinterprété et modernisé par Stromae dans sa chanson Carmen', lonLat: [4.35, 50.85] }
    ],
  },
  {
    num: 10,
    title: '10. Tainted Love',
    from: { label: 'États-Unis (Los Angeles)', artist: 'Gloria Jones', year: '1964', details: 'Chanson Soul américaine passée inaperçue à sa sortie', lonLat: [-118.24, 34.05] },
    to: [
      { label: 'Royaume-Uni (Northern Soul)', artist: 'Soft Cell', year: '1981', details: 'Découvert dans les clubs underground anglais et transformé en tube Synthpop', lonLat: [-2.24, 53.48] }
    ],
  }
];

const project = (s: Stop) => {
  const [x, y] = projection(s.lonLat) as [number, number];
  return { 
    label: s.label, 
    artist: s.artist, 
    year: s.year, 
    details: s.details, 
    x: Math.round(x * 10) / 10, 
    y: Math.round(y * 10) / 10 
  };
};

const voyages = voyagesData.map((v) => ({
  num: v.num,
  title: v.title,
  from: project(v.from),
  to: v.to.map(project),
}));

const pairOne = {
  base: relativeUrl('/metissage/Doc2FernandLeger.png'),
  top: relativeUrl('/metissage/Doc1JocondeLHOOQ.png'),
};

const pairTwo = {
  base: relativeUrl('/metissage/Doc3LesmeninesDiegoVelaz.jpg'),
  top: relativeUrl('/metissage/Doc4LesmeninesPicasso.jpg'),
};
---

<div class="metissage-course">
  <CourseTabs tabs={tabs} ariaLabel="Musique et Métissage" />

  {tabs.map((tab, index) => (
    <div
      role="tabpanel"
      id={`main-panel-${tab.id}`}
      class="metissage-panel"
      aria-labelledby={`main-tab-${tab.id}`}
      hidden={index !== 0}
      data-panel={tab.id}
    >
      {tab.videos.length > 0 && (
        <div class="metissage-videos">
          {tab.videos.map((video) => (
            <VideoCard
              badge={video.badge}
              title={video.title}
              url={`https://www.youtube.com/watch?v=${video.youtubeId}`}
            />
          ))}
        </div>
      )}

      {tab.id === 'voyage' && (
        <div class="metissage-voyage-content" style="display: flex; flex-direction: column; gap: 2rem;">
          <!-- Carte interactive -->
          <div class="metissage-carte-section">
            <header class="carte-header">
              <h3>🌍 La Carte du Métissage Musical</h3>
              <p>Sélectionnez un numéro ci-dessous puis cliquez sur les marqueurs colorés pour découvrir l'histoire complète du morceau.</p>
            </header>

            <div class="voyages-numbers-bar">
              <span class="bar-title">Voyages :</span>
              {voyages.map((v, idx) => (
                <button 
                  type="button" 
                  class={`num-pill ${idx === 0 ? 'active' : ''}`} 
                  data-voyage-index={idx}
                  title={v.title}
                >
                  {v.num}
                </button>
              ))}
            </div>

            <div class="map-container">
              <svg viewBox="0 0 1000 500" id="world-map" class="world-map-svg" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Carte du monde montrant le trajet des musiques métissées">
                <path d={countriesPath} class="land" />

                <g id="map-title-overlay" transform="translate(20, 35)">
                  <rect id="map-title-bg" class="title-bg" x="-10" y="-22" width="220" height="34" rx="8" />
                  <text id="map-song-title" class="title-text" x="0" y="0">1. Misirlou</text>
                </g>

                <g id="map-dynamic-layer"></g>
              </svg>
            </div>
          </div>

          <!-- Sliders de Peinture rétablis -->
          <div class="metissage-paintings">
            <p class="metissage-hint">Faites glisser le curseur pour comparer les deux œuvres.</p>
            <figure class="metissage-pair">
              <div
                class="metissage-compare"
                data-compare
                data-title-a="Fernand Léger — La Joconde aux clés"
                data-title-b="Marcel Duchamp — L.H.O.O.Q."
                style="--pos: 50%;"
              >
                <div class="metissage-layers">
                  <img
                    class="metissage-img metissage-img-base"
                    src={pairOne.base}
                    alt="Fernand Léger — La Joconde aux clés"
                    loading="lazy"
                  />
                  <img
                    class="metissage-img metissage-img-top"
                    src={pairOne.top}
                    alt="Marcel Duchamp — L.H.O.O.Q., la Joconde affublée d'une moustache"
                    loading="lazy"
                  />
                </div>
                <div class="metissage-divider" aria-hidden="true">
                  <span class="metissage-handle">↔</span>
                </div>
                <input
                  type="range"
                  class="metissage-range"
                  min="0"
                  max="100"
                  value="50"
                  step="1"
                  aria-label="Comparer Fernand Léger et Marcel Duchamp"
                />
              </div>
              <figcaption class="metissage-title" data-title aria-live="polite" aria-atomic="true"></figcaption>
            </figure>

            <figure class="metissage-pair">
              <div
                class="metissage-compare"
                data-compare
                data-title-a="Diego Vélasquez — Les Ménines"
                data-title-b="Pablo Picasso — Les Ménines"
                style="--pos: 50%;"
              >
                <div class="metissage-layers">
                  <img
                    class="metissage-img metissage-img-base"
                    src={pairTwo.base}
                    alt="Diego Vélasquez — Les Ménines"
                    loading="lazy"
                  />
                  <img
                    class="metissage-img metissage-img-top"
                    src={pairTwo.top}
                    alt="Pablo Picasso — Les Ménines, d'après Vélasquez"
                    loading="lazy"
                  />
                </div>
                <div class="metissage-divider" aria-hidden="true">
                  <span class="metissage-handle">↔</span>
                </div>
                <input
                  type="range"
                  class="metissage-range"
                  min="0"
                  max="100"
                  value="50"
                  step="1"
                  aria-label="Comparer Diego Vélasquez et Pablo Picasso"
                />
              </div>
              <figcaption class="metissage-title" data-title aria-live="polite" aria-atomic="true"></figcaption>
            </figure>
          </div>
        </div>
      )}
    </div>
  ))}
</div>

<script is:inline define:vars={{ voyages }}>
  const metissageRoot = document.querySelector('.metissage-course');

  if (metissageRoot) {
    const tabs = Array.from(metissageRoot.querySelectorAll('.main-tab'));
    const panels = Array.from(metissageRoot.querySelectorAll('.metissage-panel'));

    const activateTab = (activeIndex, moveFocus = false) => {
      tabs.forEach((tab, index) => {
        const isActive = index === activeIndex;
        tab.setAttribute('aria-selected', String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
        tab.classList.toggle('is-active', isActive);
        if (isActive && moveFocus) {
          tab.focus();
        }
      });

      panels.forEach((panel, index) => {
        panel.hidden = index !== activeIndex;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activateTab(index));

      tab.addEventListener('keydown', (event) => {
        let nextIndex = null;

        if (event.key === 'ArrowRight') {
          nextIndex = (index + 1) % tabs.length;
        } else if (event.key === 'ArrowLeft') {
          nextIndex = (index - 1 + tabs.length) % tabs.length;
        } else if (event.key === 'Home') {
          nextIndex = 0;
        } else if (event.key === 'End') {
          nextIndex = tabs.length - 1;
        }

        if (nextIndex !== null) {
          event.preventDefault();
          activateTab(nextIndex, true);
        }
      });
    });

    const pillBtns = metissageRoot.querySelectorAll('.num-pill');
    const svg = metissageRoot.querySelector('#world-map');
    const layer = metissageRoot.querySelector('#map-dynamic-layer');
    const songTitleEl = metissageRoot.querySelector('#map-song-title');
    const titleBgEl = metissageRoot.querySelector('#map-title-bg');
    const titleOverlayGroup = metissageRoot.querySelector('#map-title-overlay');
    const NS = 'http://www.w3.org/2000/svg';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let currentView = { x: 0, y: 0, w: 1000, h: 500 };
    let rafId = 0;
    let targetView = { x: 0, y: 0, w: 1000, h: 500 };

    const setView = (v) => {
      if (!svg) return;
      svg.setAttribute('viewBox', `${v.x} ${v.y} ${v.w} ${v.h}`);
      const k = v.w / 1000;
      
      if (layer) {
        layer.querySelectorAll('.marker').forEach((m) => {
          m.setAttribute('transform', `translate(${m.dataset.x} ${m.dataset.y}) scale(${k})`);
        });
      }

      if (titleOverlayGroup) {
        titleOverlayGroup.setAttribute('transform', `translate(${v.x + 15 * k}, ${v.y + 30 * k}) scale(${k})`);
      }
    };

    const animateTo = (target) => {
      cancelAnimationFrame(rafId);
      if (reduceMotion) {
        currentView = target;
        setView(currentView);
        return;
      }
      const start = { ...currentView };
      const t0 = performance.now();
      const duration = 750;
      const ease = (t) => 1 - Math.pow(1 - t, 3);
      const step = (now) => {
        const t = Math.min((now - t0) / duration, 1);
        const e = ease(t);
        currentView = {
          x: start.x + (target.x - start.x) * e,
          y: start.y + (target.y - start.y) * e,
          w: start.w + (target.w - start.w) * e,
          h: start.h + (target.h - start.h) * e,
        };
        setView(currentView);
        if (t < 1) rafId = requestAnimationFrame(step);
      };
      rafId = requestAnimationFrame(step);
    };

    const computeView = (points) => {
      const xs = points.map((p) => p.x);
      const ys = points.map((p) => p.y);
      const minX = Math.min(...xs), maxX = Math.max(...xs);
      const minY = Math.min(...ys), maxY = Math.max(...ys);
      let w = Math.max((maxX - minX) * 1.8, 350);
      let h = Math.max((maxY - minY) * 2.2, 180);
      w = Math.min(Math.max(w, h * 2), 1000);
      h = w / 2;
      const cx = (minX + maxX) / 2;
      const cy = (minY + maxY) / 2;
      const x = Math.min(Math.max(cx - w / 2, 0), 1000 - w);
      const y = Math.min(Math.max(cy - h / 2, 0), 500 - h);
      return { x, y, w, h };
    };

    const arcPath = (a, b) => {
      const dx = b.x - a.x;
      const dy = b.y - a.y;
      const dist = Math.hypot(dx, dy) || 1;
      let nx = -dy / dist;
      let ny = dx / dist;
      if (ny > 0) { nx = -nx; ny = -ny; }
      const off = dist * 0.22;
      const cx = (a.x + b.x) / 2 + nx * off;
      const cy = (a.y + b.y) / 2 + ny * off;
      return `M ${a.x} ${a.y} Q ${cx} ${cy} ${b.x} ${b.y}`;
    };

    const wrapText = (text, maxChars) => {
      const words = text.split(' ');
      const lines = [];
      let currentLine = '';
      words.forEach((word) => {
        if ((currentLine + ' ' + word).trim().length <= maxChars) {
          currentLine = (currentLine + ' ' + word).trim();
        } else {
          if (currentLine) lines.push(currentLine);
          currentLine = word;
        }
      });
      if (currentLine) lines.push(currentLine);
      return lines;
    };

    const addMarker = (p, kind, refX) => {
      if (!layer) return;
      const left = p.x > refX;
      const g = document.createElementNS(NS, 'g');
      g.setAttribute('class', `marker marker-${kind}`);
      g.setAttribute('tabindex', '0');
      g.dataset.x = p.x;
      g.dataset.y = p.y;

      const halo = document.createElementNS(NS, 'circle');
      halo.setAttribute('class', 'marker-halo');
      halo.setAttribute('r', '12');

      const dot = document.createElementNS(NS, 'circle');
      dot.setAttribute('class', 'marker-dot');
      dot.setAttribute('r', '6');

      const text = document.createElementNS(NS, 'text');
      text.setAttribute('class', 'map-label');
      text.setAttribute('x', left ? '-14' : '14');
      text.setAttribute('y', '5');
      text.setAttribute('text-anchor', left ? 'end' : 'start');
      text.textContent = p.label;

      const popover = document.createElementNS(NS, 'g');
      popover.setAttribute('class', 'marker-popover');
      
      const titleTextStr = `${p.artist} (${p.year})`;
      const lines = wrapText(p.details, 44);
      const measureCtx = document.createElement('canvas').getContext('2d');
      const fontFamily = svg ? (getComputedStyle(svg).fontFamily || 'sans-serif') : 'sans-serif';
      const measure = (str, weight, size) => {
        if (!measureCtx) return str.length * size * 0.6;
        measureCtx.font = `${weight} ${size}px ${fontFamily}`;
        return measureCtx.measureText(str).width;
      };
      const PAD_X = 26;
      const textW = Math.max(
        measure(titleTextStr, 900, 20),
        ...lines.map((l) => measure(l, 600, 18))
      );
      const popWidth = Math.ceil(textW + PAD_X * 2);
      const popHeight = 76 + (lines.length - 1) * 26 + 28;

      const SAFE = 45;
      const k = targetView.w / 1000;

      const minX = (targetView.x - p.x) / k + SAFE;
      const maxX = (targetView.x + targetView.w - p.x) / k - SAFE;
      const minY = (targetView.y - p.y) / k + SAFE;
      const maxY = (targetView.y + targetView.h - p.y) / k - SAFE;

      let boxX = -popWidth / 2;
      let boxY = -popHeight - 20;

      if (boxY < minY) boxY = 20;

      boxX = Math.max(minX, Math.min(boxX, maxX - popWidth));
      boxY = Math.max(minY, Math.min(boxY, maxY - popHeight));

      const popBg = document.createElementNS(NS, 'rect');
      popBg.setAttribute('class', 'popover-bg');
      popBg.setAttribute('x', String(boxX));
      popBg.setAttribute('y', String(boxY));
      popBg.setAttribute('width', String(popWidth));
      popBg.setAttribute('height', String(popHeight));
      popBg.setAttribute('rx', '14');

      const titleX = boxX + popWidth / 2;
      const descX = boxX + popWidth / 2;

      const popTitle = document.createElementNS(NS, 'text');
      popTitle.setAttribute('class', 'popover-title');
      popTitle.setAttribute('x', String(titleX));
      popTitle.setAttribute('y', String(boxY + 38));
      popTitle.setAttribute('text-anchor', 'middle');
      popTitle.textContent = titleTextStr;

      const popoverText = document.createElementNS(NS, 'text');
      popoverText.setAttribute('class', 'popover-desc');
      popoverText.setAttribute('x', String(descX));
      popoverText.setAttribute('y', String(boxY + 76));
      popoverText.setAttribute('text-anchor', 'middle');

      lines.forEach((line, i) => {
        const tspan = document.createElementNS(NS, 'tspan');
        tspan.setAttribute('x', String(descX));
        tspan.setAttribute('dy', i === 0 ? '0' : '26');
        tspan.textContent = line;
        popoverText.appendChild(tspan);
      });

      popover.append(popBg, popTitle, popoverText);
      g.append(halo, dot, text, popover);

      g.addEventListener('click', (e) => {
        e.stopPropagation();
        const wasActive = g.classList.contains('popover-open');
        layer.querySelectorAll('.marker').forEach((m) => m.classList.remove('popover-open'));
        if (!wasActive) {
          g.classList.add('popover-open');
          layer.appendChild(g); 
        }
      });

      layer.appendChild(g);
    };

    if (svg) {
      svg.addEventListener('click', () => {
        if (layer) layer.querySelectorAll('.marker').forEach((m) => m.classList.remove('popover-open'));
      });
    }

    const selectVoyage = (index) => {
      const data = voyages[index];
      if (!data || !layer) return;

      pillBtns.forEach((btn, idx) => btn.classList.toggle('active', idx === index));

      if (songTitleEl && titleBgEl) {
        songTitleEl.textContent = data.title;
        const textLength = songTitleEl.getComputedTextLength ? songTitleEl.getComputedTextLength() : data.title.length * 9;
        titleBgEl.setAttribute('width', Math.max(textLength + 30, 100));
      }

      layer.replaceChildren();

      let previousPoint = data.from;
      const allPoints = [data.from];

      data.to.forEach((dest) => {
        const path = document.createElementNS(NS, 'path');
        path.setAttribute('class', 'flight-path');
        path.setAttribute('d', arcPath(previousPoint, dest));
        layer.appendChild(path);
        
        allPoints.push(dest);
        previousPoint = dest;
      });

      targetView = computeView(allPoints);
      const avgToX = data.to.reduce((s, d) => s + d.x, 0) / data.to.length;
      addMarker(data.from, 'from', avgToX);
      data.to.forEach((dest) => addMarker(dest, 'to', data.from.x));

      animateTo(targetView);
    };

    pillBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.dataset.voyageIndex || '0', 10);
        selectVoyage(idx);
      });
    });

    if (svg && layer) selectVoyage(0);

    metissageRoot.querySelectorAll('[data-compare]').forEach((comparison) => {
      const range = comparison.querySelector('.metissage-range');
      if (!range) return;

      const figure = comparison.closest('.metissage-pair');
      const title = figure?.querySelector('[data-title]');
      const titleA = comparison.dataset.titleA ?? '';
      const titleB = comparison.dataset.titleB ?? '';

      const updatePosition = () => {
        const value = Number(range.value);
        comparison.style.setProperty('--pos', `${value}%`);
        if (!title) return;

        if (value <= 10) title.textContent = titleA;
        else if (value >= 90) title.textContent = titleB;
        else title.textContent = '';
      };

      range.addEventListener('input', updatePosition);
      updatePosition();
    });
  }
</script>


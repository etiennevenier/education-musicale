---
import '../../styles/tools-shared.css';
// Outil « Identification Clavier » — un point rouge apparaît sur une touche,
// l'élève clique sur le nom de la note correspondante.
import { buildKeyboard } from '../../utils/musicNotes';
import { relativeUrl } from '../../utils/navigation';

const keyboard = buildKeyboard(60, 72);
const whiteKeyCount = keyboard.filter((key) => key.type === 'white').length;
---

<section id="tool-clavier-notes">
  <a id="cn-back" class="hub-back tool-back" href={relativeUrl('/entrainement')} aria-label="Retour à l'entraînement">
    <span aria-hidden="true">←</span>
    <span class="hub-back-text">Retour à l'entraînement</span>
    <span class="hub-back-text-short" aria-hidden="true">Entraînement</span>
  </a>

  <header class="cn-header">
    <h1>Identification Clavier</h1>
  </header>

  <!-- MENU DES NIVEAUX -->
  <div id="cn-menu" class="cn-menu">
    <div class="cn-levels">
      <button type="button" class="cn-level-btn" data-level="1">
        <span class="cn-level-title">Niveau 1</span>
        <span class="cn-level-desc">Notes naturelles (Do à Si)</span>
      </button>
      <button type="button" class="cn-level-btn" data-level="2">
        <span class="cn-level-title">Niveau 2</span>
        <span class="cn-level-desc">Notes naturelles + dièses (Do♯, Ré♯, Fa♯, Sol♯, La♯)</span>
      </button>
      <button type="button" class="cn-level-btn" data-level="3">
        <span class="cn-level-title">Niveau 3</span>
        <span class="cn-level-desc">Notes naturelles + bémols (Ré♭, Mi♭, Sol♭, La♭, Si♭)</span>
      </button>
      <button type="button" class="cn-level-btn" data-level="4">
        <span class="cn-level-title">Niveau 4</span>
        <span class="cn-level-desc">Mélange complet (naturelles, dièses et bémols)</span>
      </button>
    </div>
  </div>

  <!-- CHALLENGE -->
  <div id="cn-game" class="cn-game hidden">
    <div class="cn-hud">
      <span class="cn-hud-item">Niveau <strong id="cn-level-label">1</strong></span>
      <span class="cn-hud-item">Question <strong id="cn-progress">1 / 10</strong></span>
      <span class="cn-hud-item">Score <strong id="cn-score">0 / 10</strong></span>
      <span class="cn-hud-item cn-hud-time">⏱ <strong id="cn-timer">1:00</strong></span>
    </div>

    <div class="cn-piano" style={`--white-count: ${whiteKeyCount};`} aria-hidden="true">
      {keyboard.map((key) => (
        <div
          class:list={['cn-key', `cn-key--${key.type}`]}
          data-midi={key.midi}
          style={`--offset: ${key.whiteOffset};`}
        >
          <span class="cn-key-marker"></span>
        </div>
      ))}
    </div>
    <p class="cn-caption">Le point rouge indique la touche à identifier.</p>

    <p id="cn-feedback" class="cn-feedback" aria-live="polite"></p>

    <div id="cn-answers" class="cn-answers" aria-label="Noms de notes possibles"></div>
  </div>

  <!-- BILAN -->
  <div id="cn-result" class="cn-result hidden" role="status" aria-live="polite" tabindex="-1">
    <h2>Challenge Over !</h2>
    <p id="cn-result-reason" class="cn-result-reason"></p>

    <div class="cn-stats">
      <div class="cn-stat">
        <span id="cn-result-score" class="cn-stat-value">0 / 10</span>
        <span class="cn-stat-label">Score</span>
      </div>
      <div class="cn-stat">
        <span id="cn-result-percent" class="cn-stat-value">0 %</span>
        <span class="cn-stat-label">Réussite</span>
      </div>
      <div class="cn-stat">
        <span id="cn-result-time" class="cn-stat-value">0:00</span>
        <span class="cn-stat-label">Temps</span>
      </div>
    </div>

    <div class="cn-result-actions">
      <button type="button" id="cn-restart" class="cn-primary-btn">Recommencer le challenge</button>
    </div>
  </div>
</section>

<style is:global>

  #tool-clavier-notes .cn-levels {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  @media (min-width: 560px) {
    #tool-clavier-notes .cn-levels { grid-template-columns: 1fr 1fr; }
  }

  #tool-clavier-notes .cn-level-btn {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-height: 64px;
    padding: 0.9rem 1rem;
    text-align: left;
    border: 2px solid #e2e8f0;
    border-radius: 16px;
    background: #ffffff;
    color: #334155;
    font: inherit;
    cursor: pointer;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
    touch-action: manipulation;
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.1s ease;
  }

  #tool-clavier-notes .cn-level-title {
    color: var(--accent);
    font-size: 1.15rem;
    font-weight: 800;
  }

  #tool-clavier-notes .cn-level-desc {
    color: #64748b;
    font-size: 0.95rem;
    font-weight: 500;
  }

  /* --- Clavier --- */
  #tool-clavier-notes .cn-piano {
    --black-width: 8.4%;
    position: relative;
    display: flex;
    width: 100%;
    height: clamp(150px, 32vh, 220px);
    background: #1e293b;
    border-radius: 14px 14px 10px 10px;
    box-shadow: 0 8px 18px -8px rgba(15, 23, 42, 0.5);
    overflow: hidden;
    user-select: none;
  }

  #tool-clavier-notes .cn-key--white {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    background: linear-gradient(#ffffff, #f1f5f9);
    border: 1px solid #cbd5e1;
    border-top: 0;
    border-radius: 0 0 8px 8px;
  }

  #tool-clavier-notes .cn-key--black {
    position: absolute;
    top: 0;
    left: calc(var(--offset) * 100% / var(--white-count) - var(--black-width) / 2);
    width: var(--black-width);
    height: 62%;
    z-index: 2;
    background: linear-gradient(#334155, #0f172a);
    border-radius: 0 0 6px 6px;
    box-shadow: 0 4px 8px rgba(15, 23, 42, 0.45);
  }

  #tool-clavier-notes .cn-key-marker {
    position: absolute;
    bottom: 24%;
    left: 50%;
    width: clamp(14px, 2.8vw, 22px);
    aspect-ratio: 1;
    border: 2px solid #ffffff;
    border-radius: 50%;
    background: #ef4444;
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.35), 0 2px 6px rgba(15, 23, 42, 0.35);
    transform: translateX(-50%) scale(0);
    transition: transform 0.18s ease;
    pointer-events: none;
  }

  #tool-clavier-notes .cn-key--black .cn-key-marker {
    bottom: 10%;
    width: clamp(12px, 2.4vw, 18px);
  }

  #tool-clavier-notes .cn-key.is-target .cn-key-marker {
    transform: translateX(-50%) scale(1);
    animation: cn-pulse 1.4s ease-in-out infinite;
  }

  @keyframes cn-pulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.35); }
    50% { box-shadow: 0 0 0 8px rgba(239, 68, 68, 0.12); }
  }

  #tool-clavier-notes .cn-answers {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  #tool-clavier-notes .cn-answer-row {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.5rem;
    align-items: stretch;
  }

  #tool-clavier-notes .cn-answer-row--natural {
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }

  #tool-clavier-notes .cn-answer-btn {
    min-height: 56px;
    padding: 0.7rem 0.35rem;
    border: 2px solid #e2e8f0;
    border-radius: 14px;
    background: #ffffff;
    color: #334155;
    font: inherit;
    font-size: 1.15rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
    touch-action: manipulation;
    user-select: none;
    transition: border-color 0.15s ease, background-color 0.15s ease, transform 0.1s ease;
  }

  /* --- Bilan --- */

  @media (max-width: 640px) {
    #tool-clavier-notes .cn-answer-btn { font-size: 1rem; padding: 0.55rem 0.2rem; }
  }

  /* Portrait smartphone : menu et jeu occupent exactement la hauteur visible. */
  @media (max-width: 640px) and (orientation: portrait) {

    #tool-clavier-notes #cn-menu,
    #tool-clavier-notes #cn-game,
    #tool-clavier-notes #cn-result {
      flex: 1 1 auto;
      min-height: 0;
      gap: 0.45rem;
    }

    #tool-clavier-notes #cn-menu {
      display: flex;
      flex-direction: column;
    }

    #tool-clavier-notes .cn-levels {
      flex: 1 1 auto;
      min-height: 0;
      grid-template-columns: 1fr;
      grid-auto-rows: minmax(0, 1fr);
      gap: 0.5rem;
    }

    #tool-clavier-notes .cn-level-btn {
      justify-content: center;
      min-height: 0;
      padding: 0.65rem 0.9rem;
      overflow: hidden;
    }

    #tool-clavier-notes .cn-level-title { font-size: 1.05rem; line-height: 1.2; }
    #tool-clavier-notes .cn-level-desc { font-size: 0.82rem; line-height: 1.25; }

    #tool-clavier-notes #cn-game {
      justify-content: flex-start !important;
      gap: 0.85rem !important;
      margin-bottom: 0;
    }

    #tool-clavier-notes .cn-piano {
      flex: 0 0 auto !important;
      height: clamp(120px, 25dvh, 160px) !important;
      margin: 0.25rem 0 !important;
    }

    #tool-clavier-notes .cn-answers {
      flex: 0 0 auto;
      gap: 0.4rem;
    }

    #tool-clavier-notes .cn-answer-row {
      gap: 0.4rem;
    }

    /* 7 notes naturelles sur une seule ligne. */
    #tool-clavier-notes .cn-answer-row--natural {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }

    /* 5 altérations sur une seule ligne. */
    #tool-clavier-notes .cn-answer-row--sharp,
    #tool-clavier-notes .cn-answer-row--flat {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    #tool-clavier-notes .cn-answer-btn {
      min-height: 48px;
      padding: 0.55rem 0.25rem;
      border-radius: 12px;
      font-size: 1.05rem;
    }

    #tool-clavier-notes #cn-result {
      justify-content: center;
      padding: 0;
    }

    /* Cartes empilées : libellé à gauche, valeur à droite, sans compression. */
  }

  /* Paysage compact : le bouton de retour reste prioritaire, tout tient
     dans la zone visible sans défilement vertical parasite. */
  @media (max-height: 500px) and (orientation: landscape) {

    #tool-clavier-notes .cn-piano {
      height: clamp(84px, 24dvh, 120px);
    }

    #tool-clavier-notes .cn-answers {
      gap: 0.25rem;
    }

    #tool-clavier-notes .cn-answer-row {
      gap: 0.3rem;
    }

    /* 7 notes naturelles et 5 altérations sur une seule ligne. */
    #tool-clavier-notes .cn-answer-row--natural {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }

    #tool-clavier-notes .cn-answer-row--sharp,
    #tool-clavier-notes .cn-answer-row--flat {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    #tool-clavier-notes .cn-answer-btn {
      min-height: 38px;
      padding: 0.3rem 0.25rem;
      font-size: 0.95rem;
      border-radius: 10px;
    }
  }

  /* Paysage mobile : la page ne défile pas, seul le contenu utile reste visible. */
  @media (pointer: coarse) and (orientation: landscape) and (max-height: 550px) {

    #tool-clavier-notes .cn-piano { flex: 0 0 auto; }

    /* Grilles sur une ligne également sur les écrans paysage un peu plus hauts. */
    #tool-clavier-notes .cn-answer-row--natural {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }

    #tool-clavier-notes .cn-answer-row--sharp,
    #tool-clavier-notes .cn-answer-row--flat {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>

<script>
  import { shuffle } from '../../utils/random';
  import {
    ChallengeSession,
    CHALLENGE_QUESTION_COUNT,
    formatCountdown,
    type ChallengeResult,
  } from '../../utils/challenge';
  import {
    isBlackKey,
    noteName,
    spokenNoteName,
    type NoteSpelling,
  } from '../../utils/musicNotes';
  import { isHubBackInLevelMode, setHubBackMode } from '../../utils/navigation';

  /** Notes naturelles de l'octave (Do4 → Si4). */
  const NATURAL_TARGETS = [60, 62, 64, 65, 67, 69, 71];
  /** Touches noires de l'octave (Do♯4 → La♯4). */
  const BLACK_TARGETS = [61, 63, 66, 68, 70];

  interface AnswerRow {
    spelling: NoteSpelling;
    midis: number[];
  }

  interface LevelConfig {
    /** Notes MIDI pouvant être désignées par le point rouge. */
    targets: number[];
    /** Rangées de boutons, du haut vers le bas. */
    rows: AnswerRow[];
    /** Graphies acceptées pour les touches noires. */
    blackSpellings: NoteSpelling[];
  }

  const SHARP_ROW: AnswerRow = { spelling: 'sharp', midis: BLACK_TARGETS };
  const NATURAL_ROW: AnswerRow = { spelling: 'natural', midis: NATURAL_TARGETS };
  const FLAT_ROW: AnswerRow = { spelling: 'flat', midis: BLACK_TARGETS };

  const LEVELS: Record<number, LevelConfig> = {
    1: {
      targets: NATURAL_TARGETS,
      rows: [NATURAL_ROW],
      blackSpellings: [],
    },
    2: {
      targets: [...NATURAL_TARGETS, ...BLACK_TARGETS],
      rows: [NATURAL_ROW, SHARP_ROW],
      blackSpellings: ['sharp'],
    },
    3: {
      targets: [...NATURAL_TARGETS, ...BLACK_TARGETS],
      rows: [NATURAL_ROW, FLAT_ROW],
      blackSpellings: ['flat'],
    },
    4: {
      targets: [...NATURAL_TARGETS, ...BLACK_TARGETS],
      rows: [SHARP_ROW, NATURAL_ROW, FLAT_ROW],
      blackSpellings: ['sharp', 'flat'],
    },
  };

  /** Toutes les appellations acceptées pour une note cible. */
  const acceptedNamesFor = (midi: number, level: LevelConfig): string[] => {
    if (!isBlackKey(midi)) return [noteName(midi, 'natural')];
    return level.blackSpellings.map((spelling) => noteName(midi, spelling));
  };

  (() => {
    const root = document.getElementById('tool-clavier-notes');
    if (!root) return;

    const menuEl = root.querySelector<HTMLElement>('#cn-menu');
    const gameEl = root.querySelector<HTMLElement>('#cn-game');
    const resultEl = root.querySelector<HTMLElement>('#cn-result');
    const levelLabelEl = root.querySelector<HTMLElement>('#cn-level-label');
    const progressEl = root.querySelector<HTMLElement>('#cn-progress');
    const scoreEl = root.querySelector<HTMLElement>('#cn-score');
    const timerEl = root.querySelector<HTMLElement>('#cn-timer');
    const feedbackEl = root.querySelector<HTMLElement>('#cn-feedback');
    const answersEl = root.querySelector<HTMLElement>('#cn-answers');
    const resultScoreEl = root.querySelector<HTMLElement>('#cn-result-score');
    const resultPercentEl = root.querySelector<HTMLElement>('#cn-result-percent');
    const resultTimeEl = root.querySelector<HTMLElement>('#cn-result-time');
    const resultReasonEl = root.querySelector<HTMLElement>('#cn-result-reason');
    const restartBtn = root.querySelector<HTMLButtonElement>('#cn-restart');
    const backLink = root.querySelector<HTMLAnchorElement>('#cn-back');
    const levelButtons = root.querySelectorAll<HTMLButtonElement>('[data-level]');

    if (
      !menuEl || !gameEl || !resultEl || !levelLabelEl || !progressEl || !scoreEl ||
      !timerEl || !feedbackEl || !answersEl || !resultScoreEl || !resultPercentEl ||
      !resultTimeEl || !resultReasonEl || !restartBtn
    ) {
      return;
    }

    let session: ChallengeSession | null = null;
    let currentLevel = 1;
    let currentTarget: number | null = null;
    let currentAnswerNames: string[] = [];
    let answered = false;
    let nextQuestionTimer: number | null = null;
    let targetBag: number[] = [];
    let lastTarget: number | null = null;

    const clearTargetMarkers = (): void => {
      root.querySelectorAll('.cn-key.is-target').forEach((key) => {
        key.classList.remove('is-target');
      });
    };

    const clearNextTimer = (): void => {
      if (nextQuestionTimer !== null) {
        window.clearTimeout(nextQuestionTimer);
        nextQuestionTimer = null;
      }
    };

    /** Pioche sans répétition immédiate : le sac est mélangé à chaque tour. */
    const pickTarget = (level: LevelConfig): number => {
      if (targetBag.length === 0) {
        targetBag = shuffle(level.targets);
        if (targetBag.length > 1 && targetBag[0] === lastTarget) {
          const first = targetBag[0];
          const second = targetBag[1];
          if (first !== undefined && second !== undefined) {
            targetBag[0] = second;
            targetBag[1] = first;
          }
        }
      }

      const target = targetBag.shift();
      if (target === undefined) return level.targets[0] ?? 60;
      lastTarget = target;
      return target;
    };

    const renderAnswers = (level: LevelConfig): void => {
      answersEl.replaceChildren();

      level.rows.forEach((row) => {
        const rowEl = document.createElement('div');
        rowEl.className = `cn-answer-row cn-answer-row--${row.spelling}`;
        rowEl.setAttribute(
          'aria-label',
          row.spelling === 'sharp'
            ? 'Notes diésées'
            : row.spelling === 'flat'
              ? 'Notes bémolisées'
              : 'Notes naturelles',
        );

        row.midis.forEach((midi) => {
          const name = noteName(midi, row.spelling);
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'cn-answer-btn';
          button.dataset.name = name;
          button.textContent = name;
          button.setAttribute('aria-label', `Répondre ${spokenNoteName(name)}`);
          rowEl.appendChild(button);
        });

        answersEl.appendChild(rowEl);
      });
    };

    const showQuestion = (): void => {
      const level = LEVELS[currentLevel];
      if (!level || !session?.isRunning) return;

      answered = false;
      feedbackEl.textContent = '';
      feedbackEl.className = 'cn-feedback';
      answersEl.classList.remove('is-locked');
      answersEl.querySelectorAll('.cn-answer-btn').forEach((button) => {
        button.classList.remove('is-correct', 'is-wrong');
      });

      clearTargetMarkers();
      const target = pickTarget(level);
      currentTarget = target;
      currentAnswerNames = acceptedNamesFor(target, level);

      const key = root.querySelector<HTMLElement>(`.cn-key[data-midi="${target}"]`);
      key?.classList.add('is-target');

      progressEl.textContent = `${session.answered + 1} / ${CHALLENGE_QUESTION_COUNT}`;
      scoreEl.textContent = `${session.score} / ${CHALLENGE_QUESTION_COUNT}`;
    };

    const handleAnswer = (button: HTMLButtonElement): void => {
      if (!session?.isRunning || answered || currentTarget === null) return;
      answered = true;
      clearNextTimer();

      const chosen = button.dataset.name ?? '';
      const isCorrect = currentAnswerNames.includes(chosen);

      if (isCorrect) {
        feedbackEl.textContent = '✅ Bravo !';
        feedbackEl.className = 'cn-feedback correct';
        button.classList.add('is-correct');
      } else {
        feedbackEl.textContent = `❌ C'était ${currentAnswerNames.join(' ou ')}`;
        feedbackEl.className = 'cn-feedback incorrect';
        button.classList.add('is-wrong');
        answersEl.querySelectorAll<HTMLButtonElement>('.cn-answer-btn').forEach((answer) => {
          if (currentAnswerNames.includes(answer.dataset.name ?? '')) {
            answer.classList.add('is-correct');
          }
        });
      }

      answersEl.classList.add('is-locked');

      const continues = session.recordAnswer(isCorrect);
      if (!continues) return;

      nextQuestionTimer = window.setTimeout(() => {
        nextQuestionTimer = null;
        showQuestion();
      }, 800);
    };

    const startLevel = (levelNumber: number): void => {
      const level = LEVELS[levelNumber];
      if (!level) return;

      clearNextTimer();
      session?.cancel();
      session = null;

      currentLevel = levelNumber;
      currentTarget = null;
      currentAnswerNames = [];
      answered = false;
      targetBag = [];
      lastTarget = null;
      setHubBackMode(backLink, 'level');

      levelButtons.forEach((button) => {
        button.classList.toggle('is-active', Number(button.dataset.level) === levelNumber);
      });

      menuEl.classList.add('hidden');
      resultEl.classList.add('hidden');
      gameEl.classList.remove('hidden');

      levelLabelEl.textContent = String(levelNumber);
      progressEl.textContent = `1 / ${CHALLENGE_QUESTION_COUNT}`;
      scoreEl.textContent = `0 / ${CHALLENGE_QUESTION_COUNT}`;
      timerEl.textContent = '1:00';
      feedbackEl.textContent = '';
      feedbackEl.className = 'cn-feedback';

      clearTargetMarkers();
      renderAnswers(level);

      session = new ChallengeSession({
        onTick: ({ remainingMs, score }) => {
          timerEl.textContent = formatCountdown(remainingMs);
          scoreEl.textContent = `${score} / ${CHALLENGE_QUESTION_COUNT}`;
        },
        onEnd: showResult,
      });
      session.start();
      showQuestion();
    };

    const showResult = (result: ChallengeResult): void => {
      clearNextTimer();
      clearTargetMarkers();
      answersEl.classList.add('is-locked');

      gameEl.classList.add('hidden');
      resultEl.classList.remove('hidden');

      resultScoreEl.textContent = `${result.score} / ${result.total}`;
      resultPercentEl.textContent = `${result.percent} %`;
      resultTimeEl.textContent = result.elapsedLabel;
      resultReasonEl.textContent =
        result.reason === 'timeout'
          ? '⏱ Temps écoulé !'
          : '🏁 Les 10 questions sont terminées.';

      resultEl.focus({ preventScroll: true });
    };

    const backToMenu = (): void => {
      clearNextTimer();
      session?.cancel();
      session = null;
      currentTarget = null;
      answered = false;

      clearTargetMarkers();
      gameEl.classList.add('hidden');
      resultEl.classList.add('hidden');
      menuEl.classList.remove('hidden');

      levelButtons.forEach((button) => button.classList.remove('is-active'));
      setHubBackMode(backLink, 'hub');
    };

    backLink?.addEventListener('click', (event) => {
      const link = event.currentTarget;
      if (!(link instanceof HTMLAnchorElement) || !isHubBackInLevelMode(link)) return;
      event.preventDefault();
      backToMenu();
    });

    levelButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const levelNumber = Number(button.dataset.level);
        if (Number.isFinite(levelNumber)) startLevel(levelNumber);
      });
    });

    answersEl.addEventListener('click', (event) => {
      const clicked = event.target;
      if (!(clicked instanceof Element)) return;
      const button = clicked.closest('.cn-answer-btn');
      if (button instanceof HTMLButtonElement) handleAnswer(button);
    });

    restartBtn.addEventListener('click', () => startLevel(currentLevel));
    window.addEventListener('pagehide', () => session?.cancel());
  })();
</script>


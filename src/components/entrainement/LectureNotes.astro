<script>
import {
    ChallengeSession,
    CHALLENGE_QUESTION_COUNT,
    formatCountdown,
    type ChallengeResult,
} from '../../utils/challenge';
import { isHubBackInLevelMode, setHubBackMode } from '../../utils/navigation';

(function () {
    'use strict';

    /* ------------------------------------------------------------------
       Types — Astro compile le contenu des balises <script> en TypeScript.
    ------------------------------------------------------------------ */
    type Clef = 'treble' | 'bass';
    type NoteObj = { name: string; step: number; clef: Clef };
    type SvgAttrs = Record<string, string | number>;

    const NS = 'http://www.w3.org/2000/svg';

    /* ------------------------------------------------------------------
       Accès au DOM : vérifié une fois, avec un type précis ensuite.
    ------------------------------------------------------------------ */
    function mustElement(selector: string): HTMLElement {
        const el = document.querySelector(selector);
        if (!(el instanceof HTMLElement)) throw new Error(`Élément introuvable : ${selector}`);
        return el;
    }

    function mustSvg(selector: string): SVGSVGElement {
        const el = document.querySelector(selector);
        if (!(el instanceof SVGSVGElement)) throw new Error(`SVG introuvable : ${selector}`);
        return el;
    }

    function queryButtons(scope: ParentNode, selector: string): HTMLButtonElement[] {
        const found: HTMLButtonElement[] = [];
        scope.querySelectorAll(selector).forEach(el => {
            if (el instanceof HTMLButtonElement) found.push(el);
        });
        return found;
    }

    let currentLevel = 1;
    let currentNoteObj: NoteObj | null = null;
    let isWaiting = false;
    let feedbackTimer: number | null = null;
    let session: ChallengeSession | null = null;

    const hubBackLink = document.querySelector<HTMLAnchorElement>('#notes-hub-back');
    const levelIndicator = mustElement('#level-indicator');
    const progressIndicator = mustElement('#progress-indicator');
    const scoreIndicator = mustElement('#score-indicator');
    const timerIndicator = mustElement('#timer-indicator');
    const feedbackEl = mustElement('#feedback-msg');
    const resultSection = mustElement('#score-section');

    function clearFeedbackTimer(): void {
        if (feedbackTimer !== null) {
            window.clearTimeout(feedbackTimer);
            feedbackTimer = null;
        }
    }

    function getLevelPool(level: number): NoteObj[] {
        let pool: NoteObj[] = [];
        if (level === 1) { // Clé de Sol - Do3 au Do4
            pool = [
                {name: 'Do', step: -2, clef: 'treble'},
                {name: 'Ré', step: -1, clef: 'treble'},
                {name: 'Mi', step: 0, clef: 'treble'},
                {name: 'Fa', step: 1, clef: 'treble'},
                {name: 'Sol', step: 2, clef: 'treble'},
                {name: 'La', step: 3, clef: 'treble'},
                {name: 'Si', step: 4, clef: 'treble'},
                {name: 'Do', step: 5, clef: 'treble'}
            ];
        } else if (level === 2) { // Clé de Fa - Do2 au Do3
            pool = [
                {name: 'Do', step: 3, clef: 'bass'},
                {name: 'Ré', step: 4, clef: 'bass'},
                {name: 'Mi', step: 5, clef: 'bass'},
                {name: 'Fa', step: 6, clef: 'bass'},
                {name: 'Sol', step: 7, clef: 'bass'},
                {name: 'La', step: 8, clef: 'bass'},
                {name: 'Si', step: 9, clef: 'bass'},
                {name: 'Do', step: 10, clef: 'bass'}
            ];
        } else if (level === 3) { // Niveau 2 Clé de Sol (Lignes supp)
            pool = [
                {name: 'La', step: -4, clef: 'treble'},
                {name: 'Si', step: -3, clef: 'treble'},
                {name: 'Do', step: -2, clef: 'treble'},
                {name: 'Ré', step: -1, clef: 'treble'},
                {name: 'Mi', step: 0, clef: 'treble'},
                {name: 'Fa', step: 1, clef: 'treble'},
                {name: 'Sol', step: 2, clef: 'treble'},
                {name: 'La', step: 3, clef: 'treble'},
                {name: 'Si', step: 4, clef: 'treble'},
                {name: 'Do', step: 5, clef: 'treble'},
                {name: 'Ré', step: 6, clef: 'treble'},
                {name: 'Mi', step: 7, clef: 'treble'},
                {name: 'Fa', step: 8, clef: 'treble'},
                {name: 'Sol', step: 9, clef: 'treble'},
                {name: 'La', step: 10, clef: 'treble'},
                {name: 'Si', step: 11, clef: 'treble'},
                {name: 'Do', step: 12, clef: 'treble'}
            ];
        } else if (level === 4) { // Niveau 2 Clé de Fa (Lignes supp)
            pool = [
                {name: 'Do', step: -4, clef: 'bass'},
                {name: 'Ré', step: -3, clef: 'bass'},
                {name: 'Mi', step: -2, clef: 'bass'},
                {name: 'Fa', step: -1, clef: 'bass'},
                {name: 'Sol', step: 0, clef: 'bass'},
                {name: 'La', step: 1, clef: 'bass'},
                {name: 'Si', step: 2, clef: 'bass'},
                {name: 'Do', step: 3, clef: 'bass'},
                {name: 'Ré', step: 4, clef: 'bass'},
                {name: 'Mi', step: 5, clef: 'bass'},
                {name: 'Fa', step: 6, clef: 'bass'},
                {name: 'Sol', step: 7, clef: 'bass'},
                {name: 'La', step: 8, clef: 'bass'},
                {name: 'Si', step: 9, clef: 'bass'},
                {name: 'Do', step: 10, clef: 'bass'},
                {name: 'Ré', step: 11, clef: 'bass'},
                {name: 'Mi', step: 12, clef: 'bass'}
            ];
        } else if (level === 5) {
            pool = [...getLevelPool(1), ...getLevelPool(2)];
        } else if (level === 6) {
            // Double clé élargie : le Do central (sol: step -2 / fa: step 10) sert de frontière
            // entre les deux portées -> on retire les notes qui empiéteraient sur l'autre portée.
            pool = [
                ...getLevelPool(3).filter(n => n.step >= -2),   // sol : pas de Si/La graves
                ...getLevelPool(4).filter(n => n.step <= 10)    // fa : pas de Ré/Mi aigus
            ];
        }
        return pool;
    }

    function startLevel(lvl: number): void {
        clearFeedbackTimer();
        session?.cancel();
        session = null;

        currentLevel = lvl;
        currentNoteObj = null;
        isWaiting = false;
        setHubBackMode(hubBackLink, 'level');

        mustElement('#menu-section').classList.add('hidden');
        resultSection.classList.add('hidden');
        mustElement('#exercise-section').classList.remove('hidden');

        const titles: Record<number, string> = {
            1: "Niveau 1 — Clé de Sol",
            2: "Niveau 1 — Clé de Fa",
            3: "Niveau 2 — Clé de Sol (Lignes supp.)",
            4: "Niveau 2 — Clé de Fa (Lignes supp.)",
            5: "Niveau 3 — Évaluation (Double Clé)",
            6: "Niveau 4 — Évaluation (Double Clé élargie)"
        };
        levelIndicator.textContent = String(lvl);
        levelIndicator.title = titles[lvl] ?? `Niveau ${lvl}`;
        progressIndicator.textContent = `1 / ${CHALLENGE_QUESTION_COUNT}`;
        scoreIndicator.textContent = `0 / ${CHALLENGE_QUESTION_COUNT}`;
        timerIndicator.textContent = '1:00';
        feedbackEl.textContent = '';
        feedbackEl.className = 'feedback-msg';

        session = new ChallengeSession({
            onTick: ({ remainingMs, score }) => {
                timerIndicator.textContent = formatCountdown(remainingMs);
                scoreIndicator.textContent = `${score} / ${CHALLENGE_QUESTION_COUNT}`;
            },
            onEnd: showResult,
        });
        session.start();
        nextQuestion();
    }

    function nextQuestion(): void {
        if (!session?.isRunning) return;

        feedbackEl.textContent = '';
        feedbackEl.className = 'feedback-msg';
        isWaiting = false;
        progressIndicator.textContent = `${session.answered + 1} / ${CHALLENGE_QUESTION_COUNT}`;

        const pool = getLevelPool(currentLevel);
        let nextNoteObj: NoteObj;
        
        // Tire au sort tant que la note est identique à la précédente (si le pool a plus d'1 note)
        do {
            const randomIndex = Math.floor(Math.random() * pool.length);
            nextNoteObj = pool[randomIndex];
        } while (pool.length > 1 && currentNoteObj && nextNoteObj.name === currentNoteObj.name && nextNoteObj.step === currentNoteObj.step);

        currentNoteObj = nextNoteObj;
        drawStaff(nextNoteObj);
    }

    function drawStaff(noteObj: NoteObj): void {
        const svg = mustSvg('#staff-svg');
        svg.innerHTML = '';

        const STEP = 11;                                   // demi-écart entre deux lignes (écart = 22)
        const isDouble = (currentLevel === 5 || currentLevel === 6);
        const isBass = noteObj.clef === 'bass';
        const INK = '#334155';
        // En portrait, la double portée dispose d'une géométrie plus haute et plus aérée.
        const tallDouble = isDouble && window.matchMedia('(max-width: 640px) and (orientation: portrait)').matches;
        // En paysage bas, même la portée simple mérite un cadre panoramique : viewBox large,
        // marges franches et clé redimensionnée pour ne plus paraître écrasée.
        const landscapeSingle = !isDouble && window.matchMedia('(orientation: landscape) and (max-height: 550px)').matches;

        // === Réglage des clés ===
        // size = font-size ; dy = distance entre la ligne de repère et la ligne de base du texte
        const CLEF: Record<Clef, { char: string; size: number; dy: number }> = {
            treble: { char: '𝄞', size: 205, dy: 40 },
            bass:   { char: '𝄢', size: 116, dy: 51 }
        };
        const clefScale = tallDouble ? 26 / 22 : landscapeSingle ? 15 / 22 : 1;

        const el = (name: string, attrs: SvgAttrs): SVGElement => {
            const e = document.createElementNS(NS, name);
            if (!(e instanceof SVGElement)) throw new Error(`Élément SVG invalide : ${name}`);
            for (const k in attrs) e.setAttribute(k, String(attrs[k]));
            return e;
        };

        const drawLines = (lines: number[], x1: number, x2: number, strokeWidth = 2.5): void => lines.forEach(y =>
            svg.appendChild(el('line', { x1, y1: y, x2, y2: y, stroke: INK, 'stroke-width': strokeWidth })));

        const drawClef = (type: Clef, x: number, lines: number[]): void => {
            const c = CLEF[type];
            const refLine = (type === 'treble') ? lines[3] : lines[1];   // lignes classées de haut en bas
            const t = el('text', {
                x,
                y: refLine + c.dy * clefScale,
                'font-family': 'serif',
                'font-size': c.size * clefScale,
                fill: '#1e293b'
            });
            t.textContent = c.char;
            svg.appendChild(t);
        };

        // === Mise en page : portée simple ou double portée adaptative ===
        let activeLines: number[];
        let noteStep = STEP;
        let noteX = 350;
        let inkWidth = 2.5;
        let ledgerHalf = 22;
        let headRx = 12;
        let headRy = 9;
        let stemOffset = 11;
        let stemLength = 55;

        if (isDouble) {
            const LS = tallDouble ? 26 : 22;              // écart entre deux lignes
            noteStep = LS / 2;
            const gap = tallDouble ? 140 : 110;           // respiration entre les deux portées
            const topY = tallDouble ? 64 : 56;
            const trebleLines = [0, 1, 2, 3, 4].map(i => topY + i * LS);
            const bassTop = trebleLines[4] + gap;
            const bassLines = [0, 1, 2, 3, 4].map(i => bassTop + i * LS);
            const botY = bassLines[4];

            const staffX1 = tallDouble ? 44 : 56;
            const staffX2 = tallDouble ? 390 : 470;
            const clefX = tallDouble ? 56 : 68;
            const braceTipX = tallDouble ? 16 : 24;
            const braceBodyX = tallDouble ? 30 : 40;

            // Le viewBox portrait est plus étroit et plus haut : la portée occupe toute la largeur.
            svg.setAttribute('viewBox', tallDouble ? '0 0 400 482' : '0 0 480 400');
            drawLines(trebleLines, staffX1, staffX2, tallDouble ? 2.8 : 2.5);
            drawLines(bassLines, staffX1, staffX2, tallDouble ? 2.8 : 2.5);

            // Barre de système + grande accolade reliant les deux portées.
            const braceH = botY - topY;
            const midY = topY + braceH / 2;
            svg.appendChild(el('line', {
                x1: staffX1, y1: topY, x2: staffX1, y2: botY,
                stroke: INK, 'stroke-width': tallDouble ? 3 : 2.8
            }));
            svg.appendChild(el('path', {
                d: `M ${staffX1} ${topY}
                    C ${braceBodyX} ${topY + braceH * 0.03} ${braceBodyX} ${topY + braceH * 0.14} ${braceBodyX} ${topY + braceH * 0.26}
                    C ${braceBodyX} ${topY + braceH * 0.37} ${braceBodyX * 0.82} ${topY + braceH * 0.43} ${braceTipX} ${midY}
                    C ${braceBodyX * 0.82} ${topY + braceH * 0.57} ${braceBodyX} ${topY + braceH * 0.63} ${braceBodyX} ${topY + braceH * 0.74}
                    C ${braceBodyX} ${topY + braceH * 0.86} ${braceBodyX} ${topY + braceH * 0.97} ${staffX1} ${botY}`,
                fill: 'none', stroke: INK, 'stroke-width': tallDouble ? 3.2 : 3, 'stroke-linecap': 'round'
            }));

            drawClef('treble', clefX, trebleLines);
            drawClef('bass', clefX, bassLines);
            activeLines = isBass ? bassLines : trebleLines;

            noteX = tallDouble ? 280 : 350;
            inkWidth = tallDouble ? 2.8 : 2.5;
            ledgerHalf = tallDouble ? 26 : 24;
            headRx = tallDouble ? 14 : 12.5;
            headRy = tallDouble ? 10.5 : 9.5;
            stemOffset = tallDouble ? 13 : 12;
            stemLength = tallDouble ? 64 : 58;
        } else if (landscapeSingle) {
            // Portée simple panoramique : les cinq lignes restent centrées verticalement,
            // avec assez d'air pour les lignes supplémentaires des niveaux 2.
            svg.setAttribute('viewBox', '0 0 760 180');
            const lines = [60, 75, 90, 105, 120];
            drawLines(lines, 52, 740, 3);
            drawClef(isBass ? 'bass' : 'treble', 70, lines);
            activeLines = lines;

            noteStep = 7.5;
            noteX = 470;
            inkWidth = 3;
            ledgerHalf = 22;
            headRx = 10;
            headRy = 7.5;
            stemOffset = 9;
            stemLength = 42;
        } else {
            svg.setAttribute('viewBox', '120 20 360 210');
            const lines = [80, 102, 124, 146, 168];
            drawLines(lines, 130, 460);
            drawClef(isBass ? 'bass' : 'treble', 146, lines);
            activeLines = lines;
        }

        // === Note ===
        const baseLineY = activeLines[4];                  // ligne du bas de la portée concernée
        const noteY = baseLineY - (noteObj.step * noteStep);

        // Lignes supplémentaires
        const ledger = (y: number): void => { svg.appendChild(el('line', {
            x1: noteX - ledgerHalf, y1: y, x2: noteX + ledgerHalf, y2: y, stroke: INK, 'stroke-width': inkWidth
        })); };

        if (noteObj.step <= -2) {
            for (let s = -2; s >= noteObj.step; s -= 2) ledger(baseLineY - s * noteStep);
        } else if (noteObj.step >= 10) {
            for (let s = 10; s <= noteObj.step; s += 2) ledger(baseLineY - s * noteStep);
        }

        // Tête de note
        svg.appendChild(el('ellipse', { cx: noteX, cy: noteY, rx: headRx, ry: headRy, fill: '#0f172a' }));

        // Queue de note
        const stem = (noteObj.step <= 4)
            ? { x1: noteX + stemOffset, y1: noteY, x2: noteX + stemOffset, y2: noteY - stemLength }
            : { x1: noteX - stemOffset, y1: noteY, x2: noteX - stemOffset, y2: noteY + stemLength };
        svg.appendChild(el('line', { ...stem, stroke: '#0f172a', 'stroke-width': inkWidth }));
    }

    function checkAnswer(selectedNote: string | null): void {
        if (!session?.isRunning || isWaiting || !currentNoteObj) return;
        isWaiting = true;

        const isCorrect = selectedNote === currentNoteObj.name;

        if (isCorrect) {
            feedbackEl.textContent = '✅ Bravo !';
            feedbackEl.className = 'feedback-msg correct';
        } else {
            feedbackEl.textContent = `❌ C'était ${currentNoteObj.name}.`;
            feedbackEl.className = 'feedback-msg incorrect';
        }

        const continues = session.recordAnswer(isCorrect);
        if (!continues) return;

        feedbackTimer = window.setTimeout(() => {
            feedbackTimer = null;
            nextQuestion();
        }, 500);
    }

    function showResult(result: ChallengeResult): void {
        clearFeedbackTimer();
        isWaiting = true;
        currentNoteObj = null;

        mustElement('#exercise-section').classList.add('hidden');
        resultSection.classList.remove('hidden');

        mustElement('#final-score').textContent = `${result.score} / ${result.total}`;
        mustElement('#final-percent').textContent = `${result.percent} %`;
        mustElement('#final-time').textContent = result.elapsedLabel;
        mustElement('#score-reason').textContent =
            result.reason === 'timeout'
                ? '⏱ Temps écoulé !'
                : '🏁 Les 10 questions sont terminées.';

        setHubBackMode(hubBackLink, 'level');
        resultSection.focus({ preventScroll: true });
    }

    function returnToNotesMenu(): void {
        clearFeedbackTimer();
        session?.cancel();
        session = null;
        isWaiting = false;
        currentNoteObj = null;

        mustElement('#exercise-section').classList.add('hidden');
        resultSection.classList.add('hidden');
        mustElement('#menu-section').classList.remove('hidden');
        setHubBackMode(hubBackLink, 'hub');
    }

    document.addEventListener('DOMContentLoaded', () => {
        queryButtons(document, '.level-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const lvl = parseInt(btn.getAttribute('data-level') ?? '', 10);
                startLevel(lvl);
            });
        });

        queryButtons(document, '.note-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                checkAnswer(btn.getAttribute('data-note'));
            });
        });

        if (hubBackLink) {
            hubBackLink.addEventListener('click', (event: MouseEvent) => {
                const link = event.currentTarget;
                if (!(link instanceof HTMLAnchorElement) || !isHubBackInLevelMode(link)) return;
                event.preventDefault();
                returnToNotesMenu();
            });
        }

        const restartBtn = document.querySelector('#restart-btn');
        if (restartBtn) restartBtn.addEventListener('click', () => startLevel(currentLevel));

        window.addEventListener('pagehide', () => session?.cancel());

        // Le passage portrait/paysage change la géométrie de la portée (simple ou double) :
        // on redessine la note en cours pour éviter tout viewBox périmé.
        let staffResizeTimer: number | null = null;
        window.addEventListener('resize', () => {
            if (!currentNoteObj) return;
            if (staffResizeTimer !== null) window.clearTimeout(staffResizeTimer);
            staffResizeTimer = window.setTimeout(() => {
                staffResizeTimer = null;
                if (currentNoteObj) drawStaff(currentNoteObj);
            }, 180);
        });

        const rotateHint = document.querySelector('#notes-rotate-hint');
        if (rotateHint instanceof HTMLElement) {
            const dismissRotateHint = (): void => {
                rotateHint.classList.add('is-dismissed');
            };
            const rotateContinue = document.querySelector('#notes-rotate-continue');
            if (rotateContinue) rotateContinue.addEventListener('click', dismissRotateHint);
            rotateHint.addEventListener('click', (event: MouseEvent) => {
                if (event.target === rotateHint) dismissRotateHint();
            });
        }
    }); 
})();
</script>

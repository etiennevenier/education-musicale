  <div class="notes-card">
    <!-- HEADER -->
    <a id="notes-hub-back" class="hub-back tool-back" href="/education-musicale/entrainement" aria-label="Retour à l'entraînement">
      <span aria-hidden="true">←</span>
      <span class="hub-back-text">Retour à l'entraînement</span>
      <span class="hub-back-text-short" aria-hidden="true">Entraînement</span>
    </a>
    <header class="notes-header">
      <h1>Lecture de Notes</h1>
    </header>

    <!-- MENU DE SELECTION DES NIVEAUX -->
    <div id="menu-section" class="notes-menu">
      <div class="notes-levels">
        <button class="level-btn" data-level="1" aria-label="Niveau 1, clé de sol">
          <span class="level-heading">
            <svg class="level-clef level-clef--sol" viewBox="0 0 640.000000 1280.000000" aria-hidden="true" focusable="false">
              <use href="#notes-clef-sol"></use>
            </svg>
            <span class="level-title">Niveau 1</span>
          </span>
        </button>
        <button class="level-btn" data-level="2" aria-label="Niveau 1, clé de fa">
          <span class="level-heading">
            <svg class="level-clef level-clef--fa" viewBox="0 0 18 20" aria-hidden="true" focusable="false">
              <use href="#notes-clef-fa"></use>
            </svg>
            <span class="level-title">Niveau 1</span>
          </span>
        </button>
        <button class="level-btn" data-level="3" aria-label="Niveau 2, clé de sol, avec lignes supplémentaires">
          <span class="level-heading">
            <svg class="level-clef level-clef--sol" viewBox="0 0 640.000000 1280.000000" aria-hidden="true" focusable="false">
              <use href="#notes-clef-sol"></use>
            </svg>
            <span class="level-title">Niveau 2</span>
          </span>
          <span class="level-desc">Avec lignes supplémentaires</span>
        </button>
        <button class="level-btn" data-level="4" aria-label="Niveau 2, clé de fa, avec lignes supplémentaires">
          <span class="level-heading">
            <svg class="level-clef level-clef--fa" viewBox="0 0 18 20" aria-hidden="true" focusable="false">
              <use href="#notes-clef-fa"></use>
            </svg>
            <span class="level-title">Niveau 2</span>
          </span>
          <span class="level-desc">Avec lignes supplémentaires</span>
        </button>
        <button class="level-btn is-eval" data-level="5" aria-label="Niveau 3, double clé, mélange basé sur le niveau 1">
          <span class="level-heading">
            <span class="level-clefs">
              <svg class="level-clef level-clef--sol" viewBox="0 0 640.000000 1280.000000" aria-hidden="true" focusable="false">
                <use href="#notes-clef-sol"></use>
              </svg>
              <svg class="level-clef level-clef--fa" viewBox="0 0 18 20" aria-hidden="true" focusable="false">
                <use href="#notes-clef-fa"></use>
              </svg>
            </span>
            <span class="level-title">Niveau 3</span>
          </span>
          <span class="level-desc">Mélange basé sur niveau 1</span>
        </button>
        <button class="level-btn is-eval" data-level="6" aria-label="Niveau 4, double clé étendue, mélange basé sur le niveau 2">
          <span class="level-heading">
            <span class="level-clefs">
              <svg class="level-clef level-clef--sol" viewBox="0 0 640.000000 1280.000000" aria-hidden="true" focusable="false">
                <use href="#notes-clef-sol"></use>
              </svg>
              <svg class="level-clef level-clef--fa" viewBox="0 0 18 20" aria-hidden="true" focusable="false">
                <use href="#notes-clef-fa"></use>
              </svg>
            </span>
            <span class="level-title">Niveau 4</span>
          </span>
          <span class="level-desc">Mélange basé sur niveau 2</span>
        </button>
      </div>
    </div>

    <!-- SECTION EXERCICE -->
    <div id="exercise-section" class="hidden notes-exercise">
      <div class="notes-hud">
        <span class="notes-hud-item">Niveau <strong id="level-indicator">1</strong></span>
        <span class="notes-hud-item">Question <strong id="progress-indicator">1 / 10</strong></span>
        <span class="notes-hud-item">Score <strong id="score-indicator">0 / 10</strong></span>
        <span class="notes-hud-item notes-hud-time">⏱ <strong id="timer-indicator">1:00</strong></span>
      </div>

      <!-- Portée musicale SVG grand format -->
      <div class="notes-staff">
        <svg id="staff-svg" viewBox="120 20 360 210" preserveAspectRatio="xMidYMid meet"></svg>
      </div>

      <!-- Feedback message -->
      <div id="feedback-msg" class="feedback-msg" aria-live="polite"></div>

      <!-- Boutons de réponses géants -->
      <div class="notes-answers">
        <button class="note-btn" data-note="Do">Do</button>
        <button class="note-btn" data-note="Ré">Ré</button>
        <button class="note-btn" data-note="Mi">Mi</button>
        <button class="note-btn" data-note="Fa">Fa</button>
        <button class="note-btn" data-note="Sol">Sol</button>
        <button class="note-btn" data-note="La">La</button>
        <button class="note-btn" data-note="Si">Si</button>
      </div>
    </div>

    <!-- SECTION SCORE FINAL -->
    <div id="score-section" class="hidden notes-score" role="status" aria-live="polite" tabindex="-1">
      <h2>Challenge Over !</h2>
      <p id="score-reason" class="notes-result-reason"></p>

      <div class="notes-stats">
        <div class="notes-stat">
          <span id="final-score" class="notes-stat-value">0 / 10</span>
          <span class="notes-stat-label">Score</span>
        </div>
        <div class="notes-stat">
          <span id="final-percent" class="notes-stat-value">0 %</span>
          <span class="notes-stat-label">Réussite</span>
        </div>
        <div class="notes-stat">
          <span id="final-time" class="notes-stat-value">0:00</span>
          <span class="notes-stat-label">Temps</span>
        </div>
      </div>

      <div class="notes-score-actions">
        <button type="button" id="restart-btn">Recommencer le challenge</button>
      </div>
    </div>
  </div>

  <!-- CONSEIL PORTRAIT : affiché uniquement sur smartphone en paysage -->
  <div id="notes-rotate-hint" class="notes-rotate-hint" role="dialog" aria-labelledby="notes-rotate-text">
    <div class="notes-rotate-card">
      <p id="notes-rotate-text">
        📱 Pour un meilleur confort de lecture des notes, nous vous conseillons de repasser votre téléphone en mode portrait.
      </p>
      <button type="button" id="notes-rotate-continue" class="notes-rotate-continue">
        Continuer en paysage
      </button>
    </div>
  </div>
</section>

<style is:global>
#tool-notes {
  --accent: #7e22ce;
  --accent-strong: #a855f7;
  --accent-soft: #faf5ff;
  --accent-border: #e9d5ff;
  width: 100%;
  max-width: 1024px;
  margin: 0 auto;
  padding: 12px;
  background: #ffffff;
  border-radius: 24px;
  box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.35);
  color: #0f172a;
  position: relative;
  box-sizing: border-box;
  overflow-x: hidden;
  font-family: system-ui, -apple-system, sans-serif;
}

#tool-notes .notes-card { width: 100%; min-width: 0; padding: 8px; background: #ffffff; }

#tool-notes .notes-header {
  text-align: center;
  margin-bottom: 1.75rem;
}

#tool-notes .notes-header h1 {
  margin: 0;
  font-size: clamp(1.7rem, 5vw, 2.7rem);
  line-height: 1.1;
  font-weight: 900;
  color: var(--accent);
}

#tool-notes .notes-levels {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.25rem;
}

#tool-notes .clef-sprite {
  position: absolute;
  width: 0;
  height: 0;
  overflow: hidden;
  pointer-events: none;
}

#tool-notes .level-btn {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 0.25rem;
  text-align: left;
  padding: 1rem;
  border: 2px solid #e2e8f0;
  border-radius: 16px;
  background: #ffffff;
  font: inherit;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
  transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.1s ease;
}

#tool-notes .level-heading {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  line-height: 1;
  min-width: 0;
}

#tool-notes .level-clefs {
  display: inline-flex;
  align-items: center;
  gap: 0.15rem;
  flex: 0 0 auto;
}

#tool-notes .level-clef {
  display: block;
  align-self: center;
  flex: 0 0 auto;
  color: var(--accent);
  overflow: visible;
}

#tool-notes .level-clef--sol {
  width: 1.35rem !important;
  height: 2.7rem !important;
}

#tool-notes .level-clef--fa {
  width: 1.35rem !important;
  height: 1.5rem !important;
}

#tool-notes .level-btn:hover,
#tool-notes .level-btn:focus-visible {
  border-color: var(--accent-strong);
  background: var(--accent-soft);
  outline: none;
}

#tool-notes .level-btn:active { transform: scale(0.99); }

#tool-notes .level-btn.is-eval { background: #ffffff; }

#tool-notes .level-btn .level-title {
  color: var(--accent);
  font-size: 1.25rem;
  font-weight: 800;
}

#tool-notes .level-btn .level-desc {
  color: #64748b;
  font-size: 1rem;
  font-weight: 400;
}

#tool-notes .notes-exercise {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

#tool-notes .notes-hud {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.35rem 1rem;
  padding: 0.7rem 0.9rem;
  background: var(--accent-soft);
  border: 1px solid var(--accent-border);
  border-radius: 14px;
  color: #475569;
  font-size: 0.98rem;
  font-weight: 600;
}

#tool-notes .notes-hud strong { color: var(--accent); font-weight: 800; }

#tool-notes .notes-hud-time strong {
  display: inline-block;
  min-width: 3.1rem;
  font-variant-numeric: tabular-nums;
  text-align: right;
}

#tool-notes .notes-staff {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.25rem;
  max-width: 100%;
  background: #ffffff;
  border: 2px solid #e2e8f0;
  border-radius: 24px;
  overflow-x: auto;
  box-shadow: inset 0 1px 3px rgba(15, 23, 42, 0.04);
}

#tool-notes #staff-svg {
  display: block;
  width: 100%;
  height: auto;
  max-width: 100%;
}

#tool-notes .feedback-msg {
  height: 2.25rem;
  line-height: 2.25rem;
  text-align: center;
  font-weight: 700;
  font-size: 1.5rem;
}

#tool-notes .feedback-msg.correct { color: #059669; }
#tool-notes .feedback-msg.incorrect { color: #e11d48; }
#tool-notes .notes-answers {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.5rem;
}

#tool-notes .note-btn {
  padding: 1.25rem 0.25rem;
  min-height: 56px;
  background: #ffffff;
  border: 2px solid #e2e8f0;
  border-radius: 16px;
  color: #334155;
  font: inherit;
  font-size: 1.25rem;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
  transition: border-color 0.15s ease, background-color 0.15s ease, transform 0.1s ease;
  touch-action: manipulation;
  user-select: none;
}

#tool-notes .note-btn:hover,
#tool-notes .note-btn:focus-visible {
  border-color: var(--accent-strong);
  background: var(--accent-soft);
  outline: none;
}

#tool-notes .note-btn:active { transform: scale(0.95); }

#tool-notes .note-btn[data-note="Si"] { grid-column: span 2; }

#tool-notes .notes-score {
  padding: 1.25rem 0 1.5rem;
  text-align: center;
}

#tool-notes .notes-score h2 {
  margin: 0 0 0.4rem;
  font-size: clamp(1.9rem, 6vw, 2.6rem);
  font-weight: 900;
  color: var(--accent);
}

#tool-notes .notes-result-reason {
  margin: 0;
  color: #64748b;
  font-size: 1.05rem;
  font-weight: 600;
}

#tool-notes .notes-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.6rem;
  margin: 1.35rem 0;
}

#tool-notes .notes-stat {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  padding: 0.9rem 0.35rem;
  background: var(--accent-soft);
  border: 1px solid var(--accent-border);
  border-radius: 16px;
}

#tool-notes .notes-stat-value {
  color: var(--accent);
  font-size: clamp(1.35rem, 6vw, 2.1rem);
  font-weight: 900;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

#tool-notes .notes-stat-label {
  color: #64748b;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

#tool-notes .notes-score-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.4rem;
}

#tool-notes #restart-btn {
  width: 100%;
  max-width: 420px;
  min-height: 54px;
  padding: 0.9rem 1.25rem;
  border: 0;
  border-radius: 9999px;
  background: linear-gradient(135deg, var(--accent-strong), #7e22ce);
  color: #ffffff;
  font: inherit;
  font-size: 1.1rem;
  font-weight: 800;
  cursor: pointer;
  touch-action: manipulation;
  box-shadow: 0 10px 22px -10px rgba(168, 85, 247, 0.8);
  transition: transform 0.1s ease, box-shadow 0.2s ease;
}

#tool-notes #restart-btn:hover { box-shadow: 0 12px 26px -10px rgba(168, 85, 247, 0.95); }
#tool-notes #restart-btn:active { transform: scale(0.98); }

@media (min-width: 640px) {
  #tool-notes { padding: 32px; }
  #tool-notes .notes-card { padding: 16px; }
  #tool-notes .notes-levels { grid-template-columns: 1fr 1fr; }
  #tool-notes .level-btn { padding: 1.5rem; }
  #tool-notes .level-btn.is-eval { grid-column: span 2; }
  #tool-notes .notes-staff { padding: 0.5rem; }
  #tool-notes #staff-svg { max-height: none; }
  #tool-notes .notes-answers { grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 0.75rem; }
  #tool-notes .note-btn[data-note="Si"] { grid-column: span 1; }
}

/* Mode exercice compact sur smartphone et en paysage bas */
@media (max-width: 640px), (max-width: 768px) and (orientation: landscape), (max-height: 500px) {
  #tool-notes { padding: 8px; border-radius: 16px; }
  #tool-notes .notes-card { padding: 4px; }
  #tool-notes .notes-header { display: none; }
  #tool-notes .notes-levels { gap: 0.75rem; }
  #tool-notes .level-btn { padding: 10px 14px; }
  #tool-notes .level-title { font-size: 1.05rem; }
  #tool-notes .level-desc { font-size: 0.9rem; }
  #tool-notes .notes-hud { padding: 6px 12px; font-size: 0.95rem; border-radius: 12px; }
  #tool-notes .notes-staff { padding: 4px; border-radius: 16px; }
  #tool-notes .feedback-msg { height: 1.75rem; line-height: 1.75rem; font-size: 1.1rem; }
  #tool-notes .notes-answers { gap: 6px; }
  #tool-notes .note-btn { min-height: 48px; padding: 8px 4px; font-size: 1.05rem; border-radius: 14px; }
  #tool-notes .notes-score { padding: 1rem 0; }
  #tool-notes .notes-score-actions button { padding: 1rem; font-size: 1.1rem; }
}

/* ----- Paysage bas : portée simple panoramique et interface sans débordement ----- */
@media (orientation: landscape) and (max-height: 550px) {
  #tool-notes { padding: 6px; }
  #tool-notes .notes-card { padding: 3px; }

  #tool-notes .notes-exercise { gap: 6px; }

  /* Menu de niveaux : le titre a été retiré, les 6 cartes tiennent sur
     2 colonnes et occupent toute la hauteur, sans défilement vertical. */
  #tool-notes #menu-section {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    min-height: 0;
  }

  #tool-notes .notes-levels {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 6px !important;
  }

  #tool-notes .level-btn {
    min-height: 0;
    padding: 6px 8px;
    overflow: hidden;
  }

  #tool-notes .level-btn .level-title { font-size: 0.95rem; line-height: 1.1; }
  #tool-notes .level-btn .level-desc { font-size: 0.75rem; line-height: 1.15; }
  #tool-notes .level-clef--sol { height: 2rem !important; }

---
import CourseTabs from './CourseTabs.astro';
import MoyenAgeMusicTypes from './MoyenAgeMusicTypes.astro';
import MoyenAgeInstruments from './MoyenAgeInstruments.astro';
import {
  notationGlossary,
  notationTimeline,
  utQueantLaxis,
  utQueantLaxisMedia,
  type NotationGlossaryTerm,
} from '../data/moyenAgeData';
import { relativeUrl } from '../utils/navigation';

const mainTabs = [
  { id: 'notation', icon: '📜', label: 'La notation musicale' },
  { id: 'types', icon: '🏰', label: 'Les types de musique' },
  { id: 'instruments', icon: '🎺', label: 'Les instruments' },
];

type GlossarySegment =
  | { kind: 'text'; value: string }
  | { kind: 'term'; value: string; term: NotationGlossaryTerm };

/**
 * Découpe un texte pour rendre ses termes illustrés cliquables, y compris
 * dans la frise chronologique dont les contenus proviennent des données.
 */
function splitGlossaryTerms(text: string): GlossarySegment[] {
  const pattern = /\b(?:neumes|t[ée]tragramme)\b/giu;
  const segments: GlossarySegment[] = [];
  let lastIndex = 0;

  for (const match of text.matchAll(pattern)) {
    const value = match[0];
    const index = match.index ?? 0;

    if (index > lastIndex) {
      segments.push({ kind: 'text', value: text.slice(lastIndex, index) });
    }

    segments.push({
      kind: 'term',
      value,
      term: /neumes/i.test(value) ? 'neumes' : 'tetragramme',
    });

    lastIndex = index + value.length;
  }

  if (lastIndex < text.length) {
    segments.push({ kind: 'text', value: text.slice(lastIndex) });
  }

  return segments;
}
---

<div class="moyen-age-course" id="moyen-age-course">
  <CourseTabs tabs={mainTabs} ariaLabel="Thèmes de la séquence Musique et Moyen Âge" />

  <div
    class="main-panel is-active"
    role="tabpanel"
    id="main-panel-notation"
    aria-labelledby="main-tab-notation"
    tabindex="0"
    data-main-panel="notation"
  >
    <section class="tab-content" aria-labelledby="notation-title">
      <h3 id="notation-title">La notation musicale</h3>

      <p class="tab-intro">
        Au Moyen Âge, la musique se transmet d’abord de mémoire. Les moines inventent les{" "}
        <button
          type="button"
          class="term-link"
          data-term="neumes"
          aria-haspopup="dialog"
          aria-controls="term-dialog-neumes"
          title="Afficher l’illustration des neumes"
        >neumes</button>, puis <strong>Guido d’Arezzo</strong> organise les hauteurs sur
        quatre lignes : le{" "}
        <button
          type="button"
          class="term-link"
          data-term="tetragramme"
          aria-haspopup="dialog"
          aria-controls="term-dialog-tetragramme"
          title="Afficher l’illustration du tétragramme"
        >tétragramme</button>. Les noms des notes, eux, viennent d’un hymne latin.
      </p>

      <details class="history-details">
        <summary>
          <span class="summary-icon" aria-hidden="true">📖</span>
          <span>Lire l’histoire complète</span>
          <span class="summary-chevron" aria-hidden="true">▸</span>
        </summary>

        <div class="history-body">
          <div class="course-card prose">
            <p>
              Pour conserver et diffuser les chants religieux, les moines imaginent des signes
              placés au-dessus des paroles : les{" "}
              <button
                type="button"
                class="term-link"
                data-term="neumes"
                aria-haspopup="dialog"
                aria-controls="term-dialog-neumes"
                title="Afficher l’illustration des neumes"
              >neumes</button>. Ils indiquent approximativement la direction de la mélodie, mais
              pas encore la hauteur exacte des notes.
            </p>
            <p>
              Au XIᵉ siècle, le moine italien <strong>Guido d’Arezzo</strong> (vers 991–1033)
              bouleverse l’écriture musicale. Il dispose les{" "}
              <button
                type="button"
                class="term-link"
                data-term="neumes"
                aria-haspopup="dialog"
                aria-controls="term-dialog-neumes"
                title="Afficher l’illustration des neumes"
              >neumes</button> sur quatre lignes : c’est le{" "}
              <button
                type="button"
                class="term-link"
                data-term="tetragramme"
                aria-haspopup="dialog"
                aria-controls="term-dialog-tetragramme"
                title="Afficher l’illustration du tétragramme"
              >tétragramme</button>. Chaque ligne correspond désormais à une hauteur précise. Les
              chanteurs peuvent lire une mélodie qu’ils n’ont jamais entendue. Peu à peu, le{" "}
              <button
                type="button"
                class="term-link"
                data-term="tetragramme"
                aria-haspopup="dialog"
                aria-controls="term-dialog-tetragramme"
                title="Afficher l’illustration du tétragramme"
              >tétragramme</button> s’enrichit d’une cinquième ligne et devient la portée moderne.
            </p>
          </div>

          <ol class="timeline">
            {notationTimeline.map((step, index) => (
              <li class="timeline-step">
                <span class="timeline-index">{String(index + 1).padStart(2, '0')}</span>
                <div class="timeline-card">
                  <span class="timeline-period">{step.period}</span>
                  <h4>
                    {splitGlossaryTerms(step.title).map((segment) =>
                      segment.kind === 'term' ? (
                        <button
                          type="button"
                          class="term-link"
                          data-term={segment.term}
                          aria-haspopup="dialog"
                          aria-controls={`term-dialog-${segment.term}`}
                          title={
                            segment.term === 'neumes'
                              ? 'Afficher l’illustration des neumes'
                              : 'Afficher l’illustration du tétragramme'
                          }
                        >{segment.value}</button>
                      ) : (
                        segment.value
                      ),
                    )}
                  </h4>
                  <p>
                    {splitGlossaryTerms(step.text).map((segment) =>
                      segment.kind === 'term' ? (
                        <button
                          type="button"
                          class="term-link"
                          data-term={segment.term}
                          aria-haspopup="dialog"
                          aria-controls={`term-dialog-${segment.term}`}
                          title={
                            segment.term === 'neumes'
                              ? 'Afficher l’illustration des neumes'
                              : 'Afficher l’illustration du tétragramme'
                          }
                        >{segment.value}</button>
                      ) : (
                        segment.value
                      ),
                    )}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </details>

      <article class="hymn-card">
        <div class="hymn-copy">
          <span class="eyebrow">Hymne à saint Jean-Baptiste</span>
          <h4>D’où viennent les noms des notes ?</h4>
          <p>
            Guido d’Arezzo remarque que chaque vers de l’hymne <strong>Ut queant laxis</strong> connu également sous le nom de <strong>L'hymne à Saint Jean-Baptiste</strong> commence
            une note plus haut que le précédent. Il utilise la première syllabe de chaque vers pour
            nommer les notes.
          </p>
          <p>
            Les six premières syllabes donnent <strong>ut, ré, mi, fa, sol, la</strong>. Plus tard,
            les initiales de <em>Sancte Iohannes</em> formeront le <strong>si</strong>. Bien après le Moyen Âge, au XVIIᵉ
            siècle, « ut » devient « do » : plus facile à chanter et à prononcer.
          </p>
          <p class="hymn-translation">
            « Afin que tes serviteurs puissent chanter à pleine voix les merveilles de tes actions,
            enlève la faute de leurs lèvres souillées, saint Jean. »
          </p>
        </div>

        <ol class="hymn-lines" aria-label="Hymne Ut queant laxis">
          {utQueantLaxis.map((line) => (
            <li class="hymn-line">
              <span class="hymn-note">{line.note}</span>
              <span class="hymn-text">
                <strong>{line.syllable}</strong>{' '}{line.rest}
              </span>
            </li>
          ))}
        </ol>

        <div class="hymn-media">
          <div
            class="hymn-audio"
            data-hymn-audio
            data-audio-url={relativeUrl(utQueantLaxisMedia.audioUrl)}
            data-audio-title={utQueantLaxisMedia.audioTitle}
          >
            <button
              type="button"
              class="hymn-audio-toggle"
              data-hymn-audio-toggle
              aria-label={`Écouter : ${utQueantLaxisMedia.audioTitle}`}
              aria-pressed="false"
            >
              <span class="hymn-audio-icon" aria-hidden="true">▶</span>
            </button>

            <div class="hymn-audio-main">
              <span class="hymn-audio-line">
                <span class="hymn-audio-eyebrow">Écoute</span>
                <span class="hymn-audio-track">{utQueantLaxisMedia.audioTitle}</span>
              </span>
              <span
                class="hymn-audio-progress"
                data-hymn-audio-progress
                role="progressbar"
                aria-label={`Progression de l’écoute : ${utQueantLaxisMedia.audioTitle}`}
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
              >
                <span class="hymn-audio-progress-fill" data-hymn-audio-progress-fill></span>
              </span>
            </div>

            <span class="hymn-audio-tag">Chant grégorien</span>
          </div>

          <button
            type="button"
            class="score-open"
            data-score-open
            aria-haspopup="dialog"
            aria-controls="ut-queant-laxis-score"
          >
            <span class="score-open-icon" aria-hidden="true">🖼</span>
            Voir la partition d’origine
          </button>
        </div>

        <p class="hymn-footnote">
          * Le « si » n’apparaît pas dans la gamme de Guido : il est formé plus tard avec les
          initiales de <em>Sancte Iohannes</em>.
        </p>
      </article>

      <dialog
        class="score-dialog"
        id="ut-queant-laxis-score"
        aria-labelledby="score-dialog-title"
      >
        <div class="score-dialog-head">
          <h4 id="score-dialog-title">Ut queant laxis — la partition d’origine</h4>
          <button
            type="button"
            class="score-dialog-close"
            data-score-close
            aria-label="Fermer la partition"
          >
            ✕
          </button>
        </div>
        <figure class="score-figure">
          <img
            src={relativeUrl(utQueantLaxisMedia.scoreImage)}
            alt={utQueantLaxisMedia.scoreAlt}
            width="1600"
            height="981"
            loading="lazy"
            decoding="async"
          />
          <figcaption>{utQueantLaxisMedia.scoreCaption}</figcaption>
        </figure>
      </dialog>

      {Object.entries(notationGlossary).map(([term, entry]) => (
        <dialog
          class:list={[
            'score-dialog',
            'term-dialog',
            { 'term-dialog--compact': term === 'tetragramme' },
          ]}
          id={`term-dialog-${term}`}
          data-term-dialog={term}
          aria-labelledby={`term-dialog-${term}-title`}
        >
          <div class="score-dialog-head">
            <h4 id={`term-dialog-${term}-title`}>{entry.title}</h4>
            <button
              type="button"
              class="score-dialog-close"
              data-term-close
              aria-label="Fermer l’illustration"
            >
              ✕
            </button>
          </div>
          <figure class="score-figure">
            <img
              src={relativeUrl(entry.image)}
              alt={entry.alt}
              width={entry.width}
              height={entry.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{entry.caption}</figcaption>
          </figure>
        </dialog>
      ))}
    </section>
  </div>

  <div
    class="main-panel"
    role="tabpanel"
    id="main-panel-types"
    aria-labelledby="main-tab-types"
    tabindex="0"
    data-main-panel="types"
    hidden
  >
    <section class="tab-content" aria-labelledby="types-title">
      <h3 id="types-title">Les types de musique</h3>

      <p class="tab-intro">
        Au Moyen Âge, la musique ne se pratique pas partout de la même façon. À l’église, elle sert
        à prier ; au château, elle divertit la noblesse ; à la ferme et au village, elle accompagne
        le travail, les fêtes et les danses. Choisis un lieu pour découvrir qui chante, dans quelle
        langue et ce qu’il faut écouter.
      </p>

      <MoyenAgeMusicTypes />
    </section>
  </div>

  <div
    class="main-panel"
    role="tabpanel"
    id="main-panel-instruments"
    aria-labelledby="main-tab-instruments"
    tabindex="0"
    data-main-panel="instruments"
    hidden
  >
    <section class="tab-content" aria-labelledby="instruments-title">
      <h3 id="instruments-title">Les instruments du Moyen Âge</h3>

      <p class="tab-intro">
        Les instruments médiévaux se classent en trois grandes familles : les{" "}<strong>cordes</strong>, les{" "}<strong>vents</strong> et les{" "}<strong>percussions</strong>.
      </p>

      <MoyenAgeInstruments />
    </section>
  </div>
</div>

<script>
  // Onglets : même code que les autres séquences (src/utils/tabs.ts) ; l'onglet ouvert reste dans l'adresse (#id).
  import { setupMainTabs } from '../utils/tabs';

  const course = document.getElementById('moyen-age-course');
  if (course) {
    const historyDetails = course.querySelector<HTMLDetailsElement>('.history-details');
    setupMainTabs(course, {
      tabSelector: '.main-tabs .main-tab',
      panelSelector: '.main-panel[data-main-panel]',
      panelKey: 'mainPanel',
      syncHash: true,
      // En quittant l'onglet de la notation, on replie l'histoire complète :
      // le grand pavé de texte reste ainsi fermé par défaut au retour.
      before: (tab) => {
        if (tab.dataset.mainTab !== 'notation' && historyDetails?.open) historyDetails.open = false;
      },
    });
  }
</script>

<script>
  import {
    getAudioState,
    getCurrentAudioUrl,
    onAudioEvent,
    pauseAudio,
    playAudio,
    resumeAudio,
    stopAudio,
  } from '../utils/audioManager';

  const course = document.getElementById('moyen-age-course');

  if (course) {
    const bar = course.querySelector<HTMLElement>('[data-hymn-audio]');
    const toggle = bar?.querySelector<HTMLButtonElement>('[data-hymn-audio-toggle]');
    const icon = bar?.querySelector<HTMLElement>('.hymn-audio-icon');
    const progress = bar?.querySelector<HTMLElement>('[data-hymn-audio-progress]');
    const fill = bar?.querySelector<HTMLElement>('[data-hymn-audio-progress-fill]');
    const audioUrl = bar?.dataset.audioUrl;
    const title = bar?.dataset.audioTitle || '';

    if (bar && toggle && icon && progress && fill && audioUrl) {
      const player = { bar, toggle, icon, progress, fill, audioUrl, title };

      const sameTrack = (currentUrl: string | null): boolean =>
        !!currentUrl &&
        currentUrl.normalize('NFC') === player.audioUrl.normalize('NFC');

      // Le lecteur est partagé par tout le site : on reflète son état réel.
      function syncPlayer() {
        const state = getAudioState();
        const isCurrent = sameTrack(getCurrentAudioUrl());
        const isPlaying = isCurrent && (state === 'playing' || state === 'loading');

        player.toggle.classList.toggle('is-playing', isPlaying);
        player.toggle.setAttribute('aria-pressed', String(isPlaying));

        if (isCurrent && state === 'loading') {
          player.icon.textContent = '…';
          player.toggle.setAttribute('aria-label', `Chargement : ${player.title}`);
        } else if (isCurrent && state === 'playing') {
          player.icon.textContent = '❚❚';
          player.toggle.setAttribute('aria-label', `Mettre en pause : ${player.title}`);
        } else if (isCurrent && state === 'paused') {
          player.icon.textContent = '▶';
          player.toggle.setAttribute('aria-label', `Reprendre : ${player.title}`);
        } else {
          player.icon.textContent = '▶';
          player.toggle.setAttribute('aria-label', `Écouter : ${player.title}`);
        }

        if (!isCurrent || state === 'idle' || state === 'error') {
          player.fill.style.width = '0%';
          player.progress.setAttribute('aria-valuenow', '0');
        }
      }

      player.toggle.addEventListener('click', () => {
        const state = getAudioState();

        if (sameTrack(getCurrentAudioUrl())) {
          if (state === 'playing' || state === 'loading') {
            pauseAudio();
            return;
          }
          if (state === 'paused') {
            void resumeAudio();
            return;
          }
          if (state === 'ended' || state === 'idle') {
            void playAudio();
            return;
          }
        }

        void playAudio(player.audioUrl);
      });

      onAudioEvent('statechange', syncPlayer);

      onAudioEvent('ended', ({ url }) => {
        if (!url || !sameTrack(url)) return;
        player.fill.style.width = '100%';
        player.progress.setAttribute('aria-valuenow', '100');
      });

      onAudioEvent('timeupdate', ({ audio, url }) => {
        if (!audio || !url || !sameTrack(url)) return;

        const duration = audio.duration;
        if (!Number.isFinite(duration) || duration <= 0) return;

        const percent = Math.min(100, Math.max(0, (audio.currentTime / duration) * 100));
        player.fill.style.width = `${percent}%`;
        player.progress.setAttribute('aria-valuenow', String(Math.round(percent)));
      });

      // Le mini-lecteur n'est visible que dans l'onglet « La notation
      // musicale » : on coupe l'écoute dès que l'on quitte cet onglet.
      const notationPanel = player.bar.closest<HTMLElement>('.main-panel[data-main-panel]');

      if (notationPanel) {
        const visibilityObserver = new MutationObserver(() => {
          if (!notationPanel.hidden) return;

          const currentUrl = getCurrentAudioUrl();
          if (!currentUrl || !sameTrack(currentUrl)) return;

        stopAudio();
        });

        visibilityObserver.observe(notationPanel, {
          attributes: true,
          attributeFilter: ['hidden'],
        });
      }

      syncPlayer();
    }

    // Partition d'origine : ouverture dans une modale, sans quitter la page.
    const scoreDialog = document.getElementById('ut-queant-laxis-score');
    const scoreOpen = course.querySelector<HTMLButtonElement>('[data-score-open]');

    if (scoreDialog instanceof HTMLDialogElement && scoreOpen) {
      const scoreClose = scoreDialog.querySelector<HTMLButtonElement>('[data-score-close]');

      const openScore = () => {
        if (!scoreDialog.open) scoreDialog.showModal();
      };

      const closeScore = () => {
        if (scoreDialog.open) scoreDialog.close();
      };

      scoreOpen.addEventListener('click', openScore);
      scoreClose?.addEventListener('click', closeScore);

      // Clic sur le fond sombre : la cible de l'événement est le <dialog>.
      scoreDialog.addEventListener('click', (event) => {
        if (event.target === scoreDialog) closeScore();
      });
    }

    // Termes illustrés (neumes, tétragramme) : chaque occurrence du mot
    // ouvre la modale qui lui correspond, y compris dans la frise.
    course.querySelectorAll<HTMLDialogElement>('[data-term-dialog]').forEach((dialog) => {
      const term = dialog.dataset.termDialog;
      if (!term) return;

      const openers = Array.from(
        course.querySelectorAll<HTMLButtonElement>(`[data-term="${term}"]`),
      );

      openers.forEach((opener) => {
        opener.addEventListener('click', () => {
          if (!dialog.open) dialog.showModal();
        });
      });

      const closeTerm = () => {
        if (dialog.open) dialog.close();
      };

      dialog
        .querySelector<HTMLButtonElement>('[data-term-close]')
        ?.addEventListener('click', closeTerm);

      // Clic sur le fond sombre : la cible de l'événement est le <dialog>.
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) closeTerm();
      });
    });
  }
</script>

<style>
  .moyen-age-course {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .main-panel {
    animation: main-panel-in 0.25s ease;
  }

  .main-panel[hidden] {
    display: none;
  }

  @keyframes main-panel-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .tab-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .tab-content > h3 {
    margin: 0;
    font-size: 1.2rem;
    color: var(--text, #f1f5f9);
    border-bottom: 2px solid var(--border, #334155);
    padding-bottom: 0.4rem;
  }

  .tab-intro {
    margin: 0;
    color: #cbd5e1;
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .tab-intro strong {
    color: #f8fafc;
  }

  /* Bloc dépliable : histoire détaillée */
  .history-details {
    border: 1px solid #334155;
    border-radius: 12px;
    background: #1e293b;
  }

  .history-details summary {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85rem 1.1rem;
    color: #f8fafc;
    font-size: 0.92rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .history-details summary::-webkit-details-marker {
    display: none;
  }

  .history-details summary:focus-visible {
    outline: 2px solid #38bdf8;
    outline-offset: -2px;
    border-radius: 12px;
  }

  .summary-icon {
    font-size: 1.05rem;
    line-height: 1;
  }

  .summary-chevron {
    margin-left: auto;
    color: #38bdf8;
    transition: transform 0.2s ease;
  }

  .history-details[open] .summary-chevron {
    transform: rotate(90deg);
  }

  .history-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0 1.1rem 1.1rem;
  }

  .course-card {
    padding: 1.1rem 1.2rem;
    border: 1px solid #334155;
    border-radius: 12px;
    background: rgba(15, 23, 42, 0.55);
  }

  .prose p {
    margin: 0;
    color: #cbd5e1;
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .prose p + p {
    margin-top: 0.8rem;
  }

  .prose strong {
    color: #f8fafc;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline-step {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    align-items: start;
    gap: 0.8rem;
  }

  .timeline-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid #334155;
    border-radius: 50%;
    background: #0f172a;
    color: #38bdf8;
    font-size: 0.7rem;
    font-weight: 800;
  }

  .timeline-card {
    padding: 0.75rem 0.9rem;
    border: 1px solid #334155;
    border-left: 3px solid #38bdf8;
    border-radius: 0 10px 10px 0;
    background: rgba(30, 41, 59, 0.75);
  }

  .timeline-period {
    color: #38bdf8;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .timeline-card h4 {
    margin: 0.15rem 0 0.25rem;
    color: #f8fafc;
    font-size: 0.95rem;
  }

  .timeline-card p {
    margin: 0;
    color: var(--text-muted, #94a3b8);
    font-size: 0.83rem;
    line-height: 1.5;
  }

  .eyebrow {

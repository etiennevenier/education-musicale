---
import { medievalInstruments } from '../data/moyenAgeData';
import { relativeUrl } from '../utils/navigation.js';

// Les fichiers sont dans /public/moyen-age/.
// On préfixe avec le base du site (ex. /education-musicale) pour GitHub Pages.
const base = relativeUrl('/');
const instrumentSrc = (path: string) => `${base}${path}`;
---

<div class="instrument-gallery" id="medieval-instrument-gallery">
  <div class="gallery-topline">
    <p class="gallery-help">
      <span class="help-icon" aria-hidden="true">👆</span>
      Survole une carte ou clique dessus pour révéler le nom et la famille de l’instrument.
    </p>
    <div class="family-legend" aria-label="Familles d’instruments">
      <span class="legend-item"><span class="legend-dot legend-cordes"></span>Cordes</span>
      <span class="legend-item"><span class="legend-dot legend-vents"></span>Vents</span>
      <span class="legend-item"><span class="legend-dot legend-percussions"></span>Percussions</span>
    </div>
  </div>

  <div class="instrument-grid">
    {medievalInstruments.map((instrument) => (
      <button
        type="button"
        class="instrument-card"
        data-instrument={instrument.id}
        aria-label={`${instrument.name} — ${instrument.family}. ${instrument.description}`}
        aria-pressed="false"
        style={`--accent: ${instrument.accent}`}
      >
        <span class="instrument-media">
          <img
            class="instrument-image"
            src={instrumentSrc(instrument.image)}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </span>

        <span class="instrument-overlay">
          <span class="instrument-family">{instrument.family}</span>
          <span class="instrument-name">{instrument.name}</span>
          <span class="instrument-desc">{instrument.description}</span>
        </span>
      </button>
    ))}
  </div>

  <p class="gallery-note">
    Astuce : sur un écran tactile, touche une carte pour la dévoiler, puis touche-la à nouveau pour la refermer.
  </p>
</div>

<script>
  const gallery = document.getElementById('medieval-instrument-gallery');

  if (gallery) {
    const cards = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.instrument-card'));

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const isOpen = card.classList.toggle('is-open');
        card.setAttribute('aria-pressed', String(isOpen));
      });

      card.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && card.classList.contains('is-open')) {
          card.classList.remove('is-open');
          card.setAttribute('aria-pressed', 'false');
        }
      });
    });
  }
</script>

<style>
  .instrument-gallery {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .gallery-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .gallery-help {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    color: var(--text-muted, #94a3b8);
    font-size: 0.84rem;
    line-height: 1.4;
  }

  .help-icon {
    font-size: 1rem;
    line-height: 1;
  }

  .family-legend {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #cbd5e1;
  }

  .legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .legend-cordes {
    background: linear-gradient(90deg, #38bdf8 0 50%, #a78bfa 50% 100%);
  }

  .legend-vents {
    background: #fbbf24;
  }

  .legend-percussions {
    background: #f87171;
  }

  .instrument-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
  }

  .instrument-card {
    position: relative;
    aspect-ratio: 1 / 1.12;
    padding: 0;
    overflow: hidden;
    border: 1px solid #334155;
    border-radius: 14px;
    background:
      radial-gradient(circle at 50% 32%, rgba(56, 189, 248, 0.09), transparent 58%),
      linear-gradient(160deg, #1b2740 0%, #111b2e 100%);
    color: var(--text, #f8fafc);
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .instrument-card::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--accent);
    opacity: 0.65;
    transition: opacity 0.2s ease;
  }

  .instrument-card:hover,
  .instrument-card:focus-visible,
  .instrument-card.is-open {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(2, 6, 23, 0.4);
  }

  .instrument-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .instrument-card:hover::after,
  .instrument-card:focus-visible::after,
  .instrument-card.is-open::after {
    opacity: 1;
  }

  .instrument-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #0f172a;
  }

  .instrument-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease, opacity 0.3s ease;
  }

  .instrument-card:hover .instrument-image,
  .instrument-card:focus-visible .instrument-image,
  .instrument-card.is-open .instrument-image {
    transform: scale(1.07);
    opacity: 0.55;
  }

  .instrument-card:hover,
  .instrument-card:focus-visible,
  .instrument-card.is-open {
    opacity: 0;
  }

  .instrument-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.18rem;
    padding: 0.9rem;
    text-align: left;
    background: linear-gradient(
      to top,
      rgba(2, 6, 23, 0.98) 0%,
      rgba(2, 6, 23, 0.9) 54%,
      rgba(2, 6, 23, 0) 100%
    );
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .instrument-card:hover .instrument-overlay,
  .instrument-card:focus-visible .instrument-overlay,
  .instrument-card.is-open .instrument-overlay {
    opacity: 1;
    transform: translateY(0);
  }

  .instrument-family {
    color: var(--accent);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .instrument-name {
    color: #f8fafc;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.15;
  }

  .instrument-desc {
    color: #cbd5e1;
    font-size: 0.7rem;
    line-height: 1.35;
  }

  .gallery-note {
    margin: 0;
    color: #64748b;
    font-size: 0.75rem;
    line-height: 1.45;
  }

  @media (prefers-reduced-motion: reduce) {
    .instrument-card,
    .instrument-image,
    .instrument-overlay{
    transition: none;
  }
  }
</style>

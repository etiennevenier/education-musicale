---
import VideoCard from './VideoCard.astro';

interface RapVideo {
  badge: string;
  title: string;
  youtubeId: string;
}

interface RapTab {
  id: string;
  label: string;
  videos: RapVideo[];
}

const tabs: RapTab[] = [
  {
    id: 'cours',
    label: 'Cours',
    videos: [
      {
        badge: 'Doc',
        title: 'Doc — Musique et Rap',
        youtubeId: 'MKQJ4TK1SHU',
      },
      {
        badge: 'Projet musical',
        title: 'Projet musical — Musique et Rap',
        youtubeId: 'VEammZX_F8o',
      },
    ],
  },
  {
    id: 'rap',
    label: 'RAP',
    videos: [
      { badge: 'Rap', title: 'Rap — extrait 1', youtubeId: '5Tmr8gIIyO0' },
      { badge: 'Rap', title: 'Rap — extrait 2', youtubeId: 'vlzDePcK0wc' },
      { badge: 'Rap', title: 'Rap — extrait 3', youtubeId: 'rMrtJxca5j0' },
      { badge: 'Rap', title: 'Rap — extrait 4', youtubeId: '0wwFlfJojuI' },
    ],
  },
  {
    id: 'fun',
    label: 'FUN',
    videos: [
      { badge: 'Rap', title: 'Rap — fun 1', youtubeId: '3MZNxNd0vrY' },
      { badge: 'Rap', title: 'Rap — fun 2', youtubeId: 'dcP-_dAWx0A' },
      { badge: 'Rap', title: 'Rap — fun 3', youtubeId: 'azeSPHqqRaE' },
    ],
  },
];
---

<div class="rap-course">
  <div class="rap-tabs" role="tablist" aria-label="Musique et Rap">
    {tabs.map((tab, index) => (
      <button
        type="button"
        role="tab"
        id={`rap-tab-${tab.id}`}
        class="rap-tab"
        aria-controls={`rap-panel-${tab.id}`}
        aria-selected={index === 0 ? 'true' : 'false'}
        tabindex={index === 0 ? 0 : -1}
        data-tab={tab.id}
      >
        {tab.label}
      </button>
    ))}
  </div>

  {tabs.map((tab, index) => (
    <div
      role="tabpanel"
      id={`rap-panel-${tab.id}`}
      class="rap-panel"
      aria-labelledby={`rap-tab-${tab.id}`}
      hidden={index !== 0}
      data-panel={tab.id}
    >
      <div class="rap-videos">
        {tab.videos.map((video) => (
          <VideoCard
            badge={video.badge}
            title={video.title}
            url={`https://www.youtube.com/watch?v=${video.youtubeId}`}
          />
        ))}
      </div>
    </div>
  ))}
</div>

<script>
  const rapRoot = document.querySelector<HTMLElement>('.rap-course');

  if (rapRoot) {
    const tabs = rapRoot.querySelectorAll<HTMLButtonElement>('.rap-tab');

    const selectTab = (tab: HTMLButtonElement) => {
      rapRoot.querySelectorAll<HTMLButtonElement>('.rap-tab').forEach((item) => {
        const isActive = item === tab;
        item.setAttribute('aria-selected', isActive ? 'true' : 'false');
        item.tabIndex = isActive ? 0 : -1;
      });

      rapRoot.querySelectorAll<HTMLElement>('.rap-panel').forEach((panel) => {
        panel.hidden = panel.dataset.panel !== tab.dataset.tab;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        const nextIndex =
          event.key === 'ArrowRight'
            ? (index + 1) % tabs.length
            : (index - 1 + tabs.length) % tabs.length;
        tabs[nextIndex].focus();
        selectTab(tabs[nextIndex]);
      });
    });
  }
</script>

<style>
  .rap-course {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .rap-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .rap-tab {
    flex: 1 1 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 1.25rem;
    border-radius: 12px;
    border: 1px solid var(--border, #334155);
    background: #1e293b;
    color: var(--text-muted, #94a3b8);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
  }

  .rap-tab::before {
    font-size: 1.1rem;
    line-height: 1;
  }

  .rap-tab[data-tab='cours']::before {
    content: '🎓';
  }

  .rap-tab[data-tab='rap']::before {
    content: '🎤';
  }

  .rap-tab[data-tab='fun']::before {
    content: '😄';
  }

  .rap-tab:hover {
    border-color: var(--primary, #38bdf8);
    color: var(--text, #f1f5f9);
  }

  .rap-tab[aria-selected='true'] {
    border-color: var(--primary, #38bdf8);
    color: var(--text, #f1f5f9);
    box-shadow: 0 0 0 1px var(--primary, #38bdf8), 0 0 16px rgba(56, 189, 248, 0.25);
  }

  .rap-tab:focus-visible {
    outline: 2px solid var(--primary, #38bdf8);
    outline-offset: 2px;
  }

  .rap-panel[hidden] {
    display: none;
  }

  .rap-videos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
</style>


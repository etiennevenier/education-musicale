---
import DualAudioPlayer from './DualAudioPlayer.astro';
import RecyclingNuancier from './RecyclingNuancier.astro';

const tabs = [
  { id: 'parametres', label: 'Paramètres du son' },
  { id: 'emprunts', label: 'Emprunts multiples' },
  { id: 'citation', label: 'Citation, Emprunt & Remix' },
  { id: 'nuancier', label: 'Le Nuancier du Recyclage' },
];

const comparaison1 = [
  { label: 'James Bond (Dr. No) — Thème original', src: '/recyclage/Extrait1aJamesBondDrNo.mp3' },
  { label: 'Voca People — James Bond', src: '/recyclage/Extrait1bJamesBondVocaPeople.mp3' },
];

const comparaison2 = [
  { label: 'Charles Aznavour — La Bohème', src: '/recyclage/Extrait2bBohemeAznavour.mp3' },
  { label: 'La Bohème (Stelios Remix)', src: '/recyclage/Extrait2aBohemeElectro.mp3' },
];

const comparaison3 = [
  { label: 'Bedřich Smetana — La Moldau', src: '/recyclage/Extrait3bMoldauOriginal.mp3' },
  { label: 'Luc Arbogast — La Moldau', src: '/recyclage/Extrait3aLucArbogastLamoldau.mp3' },
];

const emprunts = [
  {
    label: 'Serge Gainsbourg — Le Poinçonneur des Lilas',
    src: '/recyclage/Extrait4bpoinconneur.mp3',
  },
  {
    label: "Les Doigts de l'Homme — Le Poinçonneur",
    src: '/recyclage/Extrait4aLesdoigtsdelhommepoinconneur.mp3',
  },
  {
    label: 'James Bond (Dr. No) — Thème',
    src: '/recyclage/Extrait1aJamesBondDrNo.mp3',
  },
];

const comparaison5 = [
  {
    label: 'Edward Elgar — Pomp and Circumstance',
    src: '/recyclage/Extrait5bElgarPompandcircumstanceno1D.mp3',
  },
  { label: 'KDD — Une princesse est morte', src: '/recyclage/Extrait5aKDDuneprincesseestmorte.mp3' },
];

const comparaison6 = [
  {
    label: 'Sergeï Prokofiev — Lieutenant Kijé (Romance)',
    src: '/recyclage/Extrait6bProkofievLieutenantKijéRomance.mp3',
  },
  { label: 'Sting — Russians', src: '/recyclage/Extrait6aStingRussians.mp3' },
];

const comparaison7 = [
  { label: 'J.S. Bach — Prélude n°1 en Do majeur', src: '/recyclage/Extrait7bBach.mp3' },
  { label: 'Maurane — Sur un prélude de Bach', src: '/recyclage/Extrait7aMauraneBach.mp3' },
];

const comparaison8 = [
  {
    label: 'Sergeï Prokofiev — Danse des Chevaliers',
    src: '/recyclage/Extrait8bProkofievdanceoftheknights.mp3',
  },
  {
    label: 'Robbie Williams — Party Like a Russian',
    src: '/recyclage/Extrait8aRobbieWilliamsPartylikearussian.mp3',
  },
];
---

<div class="recyclage-course">
  <div class="recyclage-tabs" role="tablist" aria-label="Musique et Recyclage">
    {tabs.map((tab, index) => (
      <button
        type="button"
        role="tab"
        id={`recyclage-tab-${tab.id}`}
        class="recyclage-tab"
        aria-controls={`recyclage-panel-${tab.id}`}
        aria-selected={index === 0 ? 'true' : 'false'}
        tabindex={index === 0 ? 0 : -1}
        data-tab={tab.id}
      >
        {tab.label}
      </button>
    ))}
  </div>

  <div
    role="tabpanel"
    id="recyclage-panel-parametres"
    class="recyclage-panel"
    aria-labelledby="recyclage-tab-parametres"
    data-panel="parametres"
  >
    <div class="recyclage-comparisons">
      <DualAudioPlayer label="Comparaison 1" tracks={comparaison1} tone={0} />
      <DualAudioPlayer
        label="Comparaison 2"
        tracks={comparaison2}
        showSimultaneousButton={true}
        tone={1}
      />
      <DualAudioPlayer label="Comparaison 3" tracks={comparaison3} tone={2} />
    </div>
  </div>

  <div
    role="tabpanel"
    id="recyclage-panel-emprunts"
    class="recyclage-panel"
    aria-labelledby="recyclage-tab-emprunts"
    data-panel="emprunts"
    hidden
  >
    <div class="recyclage-comparisons">
      <DualAudioPlayer label="Emprunts croisés" tracks={emprunts} tone={0} />
    </div>
  </div>

  <div
    role="tabpanel"
    id="recyclage-panel-citation"
    class="recyclage-panel"
    aria-labelledby="recyclage-tab-citation"
    data-panel="citation"
    hidden
  >
    <div class="recyclage-comparisons">
      <DualAudioPlayer label="Comparaison 5" tracks={comparaison5} tone={0} />
      <DualAudioPlayer label="Comparaison 6" tracks={comparaison6} tone={1} />
      <DualAudioPlayer label="Comparaison 7" tracks={comparaison7} tone={2} />
      <DualAudioPlayer label="Comparaison 8" tracks={comparaison8} tone={0} />
    </div>
  </div>

  <div
    role="tabpanel"
    id="recyclage-panel-nuancier"
    class="recyclage-panel"
    aria-labelledby="recyclage-tab-nuancier"
    data-panel="nuancier"
    hidden
  >
    <RecyclingNuancier />
  </div>
</div>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.recyclage-tab');

  const selectTab = (tab: HTMLButtonElement) => {
    const root = tab.closest('.recyclage-course');
    if (!root) return;

    root.querySelectorAll<HTMLButtonElement>('.recyclage-tab').forEach((item) => {
      const isActive = item === tab;
      item.setAttribute('aria-selected', isActive ? 'true' : 'false');
      item.tabIndex = isActive ? 0 : -1;
    });

    root.querySelectorAll<HTMLElement>('.recyclage-panel').forEach((panel) => {
      panel.hidden = panel.dataset.panel !== tab.dataset.tab;
    });
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectTab(tab));
    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      event.preventDefault();
      const nextIndex =
        event.key === 'ArrowRight'
          ? (index + 1) % tabs.length
          : (index - 1 + tabs.length) % tabs.length;
      tabs[nextIndex].focus();
      selectTab(tabs[nextIndex]);
    });
  });
</script>

<style>
  .recyclage-course {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .recyclage-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .recyclage-tab {
    flex: 1 1 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.25rem;
    border-radius: 12px;
    border: 1px solid var(--border, #334155);
    background: #1e293b;
    color: var(--text-muted, #94a3b8);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
  }

  .recyclage-tab::before {
    content: '🎵';
    margin-right: 0.5rem;
    font-size: 1.1rem;
    line-height: 1;
  }

  .recyclage-tab[data-tab='emprunts']::before {
    content: '🔀';
  }

  .recyclage-tab[data-tab='citation']::before {
    content: '♻️';
  }

  .recyclage-tab[data-tab='nuancier']::before {
    content: '⚖️';
  }

  .recyclage-tab:hover {
    border-color: var(--primary, #38bdf8);
    color: var(--text, #f1f5f9);
  }

  .recyclage-tab[aria-selected='true'] {
    border-color: var(--primary, #38bdf8);
    color: var(--text, #f1f5f9);
    box-shadow: 0 0 0 1px var(--primary, #38bdf8), 0 0 16px rgba(56, 189, 248, 0.25);
  }

  .recyclage-tab:focus-visible {
    outline: 2px solid var(--primary, #38bdf8);
    outline-offset: 2px;
  }

  .recyclage-panel[hidden] {
    display: none;
  }

  .recyclage-comparisons {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
</style>

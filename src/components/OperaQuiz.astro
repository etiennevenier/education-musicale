---
import { OPERA_QUIZ_LENGTH } from '../data/operaData';
import '../styles/quiz-card.css';
---

<section class="quiz-card opera-quiz" id="operaQuiz" aria-label="Quiz Opéra">
  <div class="fuzeau-header">
    <span class="badge">Quiz Opéra</span>
    <h3>Teste tes connaissances sur l'opéra</h3>
  </div>

  <p class="quiz-intro">
    {OPERA_QUIZ_LENGTH} questions tirées au hasard : théorie, air ou récitatif et blindtest des grands
    airs.
  </p>

  <!-- Progression -->
  <div id="qoProgressBox" class="progress-box">
    <div class="progress-text">
      <span id="qoProgressLabel">Question 1 / {OPERA_QUIZ_LENGTH}</span>
      <span id="qoScoreLabel" class="score-label">Score : 0 / {OPERA_QUIZ_LENGTH}</span>
    </div>
    <div
      id="qoProgressBar"
      class="progress-bar"
      role="progressbar"
      aria-label="Progression dans le quiz"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <div id="qoProgressFill" class="progress-fill"></div>
    </div>
  </div>

  <!-- Question (+ lecteur audio si la question en a un) -->
  <div id="qoQuestionContainer" class="question-container" tabindex="-1">
    <span id="qoKind" class="question-kind"></span>
    <p id="qoQuestionText" class="question-text"></p>
    <p id="qoHint" class="hint-msg hidden">
      ⚠️ Plusieurs réponses sont possibles : coche-les, puis valide.
    </p>
    <div id="qoAudio" class="audio-q-box hidden">
      <button type="button" id="qoBtnPlay" class="btn-play-sound"></button>
    </div>
  </div>

  <!-- Réponses -->
  <div id="qoOptions" class="options-grid"></div>

  <div id="qoFeedback" class="feedback-msg hidden" role="status" aria-live="polite"></div>

  <!-- Validation (réponses multiples) & Suivant -->
  <div id="qoActionFooter" class="action-footer">
    <button type="button" id="qoBtnValidate" class="btn-validate hidden">Valider ma réponse</button>
    <button type="button" id="qoBtnNext" class="btn-next" disabled>Question suivante ➔</button>
  </div>

  <!-- Bilan final -->
  <div id="qoResult" class="result-container hidden" aria-live="polite" tabindex="-1"></div>
</section>

<script>
  import { shuffle } from '../utils/random';
  import type { OperaQuestion } from '../data/operaData';
  const { drawOperaQuestions } = await import('../data/operaData');
  import { relativeUrl } from '../utils/navigation';
  import { isCorrectSelection, isMulti } from '../utils/operaQuizEngine';
  import { renderNextButton, renderProgress, showQuizResult } from '../utils/quizUi';
  import { QuizSession } from '../utils/quizSession';
  import { bindPlayButton } from '../utils/quizAudio';
  import { stopAudio } from '../utils/audioManager';

  const KIND_LABELS: Record<OperaQuestion['kind'], string> = {
    theory: '🧠 Théorie',
    ecoute: '🎭 Air ou récitatif',
    blindtest: '🎧 Blindtest',
  };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const root = $<HTMLElement>('operaQuiz');
  const progressBox = $<HTMLDivElement>('qoProgressBox');
  const progressLabel = $<HTMLSpanElement>('qoProgressLabel');
  const scoreLabel = $<HTMLSpanElement>('qoScoreLabel');
  const progressBar = $<HTMLDivElement>('qoProgressBar');
  const progressFill = $<HTMLDivElement>('qoProgressFill');
  const questionContainer = $<HTMLDivElement>('qoQuestionContainer');
  const kindLabel = $<HTMLSpanElement>('qoKind');
  const questionText = $<HTMLParagraphElement>('qoQuestionText');
  const hintText = $<HTMLParagraphElement>('qoHint');
  const audioBox = $<HTMLDivElement>('qoAudio');
  const optionsBox = $<HTMLDivElement>('qoOptions');
  const feedbackBox = $<HTMLDivElement>('qoFeedback');
  const actionFooter = $<HTMLDivElement>('qoActionFooter');
  const btnValidate = $<HTMLButtonElement>('qoBtnValidate');
  const btnNext = $<HTMLButtonElement>('qoBtnNext');
  const resultView = $<HTMLDivElement>('qoResult');

  const player = bindPlayButton($<HTMLButtonElement>('qoBtnPlay'));

  let questions: OperaQuestion[] = [];
  let currentQuestion: OperaQuestion | null = null;
  let currentOptions: string[] = [];
  let hasAudio = false;
  const selected = new Set<string>();

  // Lecture automatique : jamais au chargement de la page, dès la 1re interaction.
  let autoPlayEnabled = false;

  const setHidden = (el: HTMLElement, hidden: boolean) => el.classList.toggle('hidden', hidden);

  /** L'onglet du quiz est masqué au chargement : on ne lance pas un son non demandé. */
  function isQuizVisible(): boolean {
    return !document.hidden && root.offsetParent !== null;
  }

  function toggleOption(option: string, btn: HTMLButtonElement): void {
    if (session.isAnswered) return;
    if (selected.has(option)) {
      selected.delete(option);
      btn.classList.remove('selected');
      btn.setAttribute('aria-pressed', 'false');
    } else {
      selected.add(option);
      btn.classList.add('selected');
      btn.setAttribute('aria-pressed', 'true');
    }
    session.render();
  }

  function buildOptions(question: OperaQuestion): void {
    optionsBox.replaceChildren();
    currentOptions.forEach((option) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn-option';
      btn.textContent = option;

      if (isMulti(question)) {
        btn.setAttribute('aria-pressed', 'false');
        btn.addEventListener('click', () => toggleOption(option, btn));
      } else {
        btn.addEventListener('click', () => {
          if (session.isAnswered) return;
          selected.clear();
          selected.add(option);
          validateAnswer();
        });
      }
      optionsBox.appendChild(btn);
    });
  }

  function showFeedback(question: OperaQuestion, isCorrect: boolean): void {
    feedbackBox.replaceChildren();
    feedbackBox.className = isCorrect ? 'feedback-msg success' : 'feedback-msg error';

    // Pas de span (ni de barre colorée vide) quand il n'y a rien à expliquer.
    if (question.explanation) {
      const detail = document.createElement('span');
      detail.className = 'fb-detail';
      detail.textContent = question.explanation;
      feedbackBox.appendChild(detail);
    }

    if (question.clipTitle) {
      const clip = document.createElement('span');
      clip.className = 'fb-detail';
      clip.textContent = `🎵 ${question.clipTitle}`;
      feedbackBox.appendChild(clip);
    }
  }

  function validateAnswer(): void {
    const question = currentQuestion;
    if (!question || session.isAnswered) return;

    const correctSet = new Set(question.correctAnswers);
    const isCorrect = isCorrectSelection(selected, correctSet);

    optionsBox.querySelectorAll<HTMLButtonElement>('.btn-option').forEach((btn) => {
      const option = btn.textContent ?? '';
      btn.disabled = true;
      btn.removeAttribute('aria-pressed');
      btn.classList.remove('selected');
      if (correctSet.has(option)) btn.classList.add('correct');
      else if (selected.has(option)) btn.classList.add('incorrect');
    });

    showFeedback(question, isCorrect);
    session.answer(isCorrect, '');
  }

  const session = new QuizSession({
    unit: 'question',
    progress: { progressLabel, scoreLabel, progressFill },
    nextBtn: btnNext,
    feedback: feedbackBox,
    result: {
      hide: [progressBox, questionContainer, optionsBox, actionFooter],
      container: resultView,
      restartId: 'qoBtnRestart',
    },
    game: [progressBox, questionContainer, optionsBox, actionFooter],
    feedbackOnAnswer: false,
    render: ({ index, total, score, answered }) => {
      renderProgress(
        { progressLabel, scoreLabel, progressFill },
        { unit: 'question', index, total, score, answered },
      );
      const done = index + (answered ? 1 : 0);
      progressBar.setAttribute('aria-valuenow', String(total ? Math.round((done / total) * 100) : 0));

      const multi = currentQuestion ? isMulti(currentQuestion) : false;
      setHidden(btnValidate, !multi || answered);
      btnValidate.disabled = answered || selected.size === 0;
      renderNextButton(btnNext, {
        unit: 'question',
        isLast: index >= total - 1,
        answered,
      });
    },
    renderQuestion: (index, autoplay) => {
      stopAudio();
      selected.clear();

      const question = questions[index];
      if (!question) return;
      currentQuestion = question;
      currentOptions = shuffle(question.options);

      kindLabel.textContent = KIND_LABELS[question.kind];
      questionText.textContent = question.prompt;
      setHidden(hintText, !isMulti(question));

      hasAudio = Boolean(question.audioUrl);
      setHidden(audioBox, !hasAudio);
      player.setUrl(question.audioUrl ? relativeUrl(question.audioUrl) : null);

      feedbackBox.textContent = '';
      feedbackBox.className = 'feedback-msg hidden';

      buildOptions(question);
      session.render();

      // Le focus sur le panneau annonce la nouvelle question sans le perdre sur « suivant ».
      questionContainer.focus({ preventScroll: true });

      if (autoplay && hasAudio && isQuizVisible()) player.play();
    },
    showResult: (score, total) => {
      stopAudio();
      player.setUrl(null);
      showQuizResult({
        hide: [progressBox, questionContainer, optionsBox, actionFooter],
        feedback: feedbackBox,
        container: resultView,
        score,
        total,
        restartId: 'qoBtnRestart',
        onRestart: () => {
          autoPlayEnabled = true;
          startGame();
        },
      });
      resultView.focus({ preventScroll: true });
    },
    onRestart: () => {
      autoPlayEnabled = true;
      startGame();
    },
  });

  function startGame(): void {
    stopAudio();
    questions = drawOperaQuestions();
    currentQuestion = null;
    currentOptions = [];
    selected.clear();

    resultView.replaceChildren();
    setHidden(resultView, true);
    [progressBox, questionContainer, optionsBox, actionFooter].forEach((el) => setHidden(el, false));
    session.start(questions.length, autoPlayEnabled);
  }

  btnValidate.addEventListener('click', validateAnswer);
  btnNext.addEventListener('click', () => session.next());

  startGame();
</script>

---
// Gabarit commun d'une page de séquence : en-tête, outils propres à la séquence
// (passés dans le <slot />), puis « Ressources Vidéos » et « Liens & Écoutes ».
// Chaque niveau a sa propre page (src/pages/<niveau>/[sequence].astro) qui
// n'importe QUE ses composants : le CSS des autres niveaux n'est plus envoyé.
import Layout from '../layouts/Layout.astro';
import VideoCard from './VideoCard.astro';
import type { LevelData, Sequence } from '../data/sequences';

interface Props {
  level: LevelData;
  sequence: Sequence;
}

const { level, sequence } = Astro.props;
---

<Layout title={`${level.title} — ${sequence.title}`}>
  <div class="sequence-container">
    <header class="sequence-header">
      <span class="sequence-badge">{level.title}</span>
      <h2>{sequence.title}</h2>
      {sequence.description && <p class="sequence-desc">{sequence.description}</p>}
    </header>

    <slot />

    {/* Section Vidéos dynamiques — standard : titre unique et pas de description */}
    {sequence.videos && sequence.videos.length > 0 && (
      <section class="section-block">
        <h3>Ressources Vidéos</h3>
        <div class="video-grid">
          {sequence.videos.map((vid) => (
            <VideoCard badge={vid.badge} title={vid.title} url={vid.url} />
          ))}
        </div>
      </section>
    )}

    {/* Liens d'écoute externes (podcasts, radios…) */}
    {sequence.resourceLinks && sequence.resourceLinks.length > 0 && (
      <section class="section-block">
        <h3>Liens &amp; Écoutes</h3>
        <div class="resource-links">
          {sequence.resourceLinks.map((link) => (
            <a class="resource-link" href={link.url} target="_blank" rel="noopener noreferrer">
              <span class="resource-link-icon" aria-hidden="true">🎧</span>
              <span class="resource-link-body">
                <span class="resource-link-title">{link.title}</span>
                {link.description && <span class="resource-link-desc">{link.description}</span>}
              </span>
              <span class="resource-link-cta">Écouter ↗</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  .sequence-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sequence-header {
    text-align: center;
  }

  .sequence-badge {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--primary, #38bdf8);
    background: #1e293b;
    border: 1px solid var(--border, #334155);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
  }

  .sequence-header h2 {
    margin: 0.6rem 0 0.2rem 0;
    font-size: 1.8rem;
    color: var(--text, #f1f5f9);
  }

  .sequence-desc {
    margin: 0;
    color: var(--text-muted, #94a3b8);
    font-size: 0.95rem;
  }

  /* :global — ces blocs viennent aussi du <slot /> (pages de niveau). */
  .sequence-container :global(.section-block) {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sequence-container :global(.section-block > h3) {
    margin: 0;
    font-size: 1.2rem;
    color: var(--text, #f1f5f9);
    border-bottom: 2px solid var(--border, #334155);
    padding-bottom: 0.4rem;
  }

  .sequence-container :global(.tools-grid) {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sequence-container :global(.sequence-tools) {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .resource-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .resource-link {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 0.9rem 1rem;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }

  .resource-link:hover {
    border-color: #38bdf8;
    transform: translateY(-1px);
  }

  .resource-link-icon {
    font-size: 1.6rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .resource-link-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .resource-link-title {
    color: #f8fafc;
    font-weight: 700;
    line-height: 1.3;
  }

  .resource-link-desc {
    color: #94a3b8;
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .resource-link-cta {
    margin-left: auto;
    flex-shrink: 0;
    background: var(--accent-sky-strong);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.4rem 0.7rem;
    border-radius: 6px;
  }

  @media (max-width: 560px) {
    .resource-link {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .resource-link-cta {
      margin-left: 0;
    }
  }
</style>

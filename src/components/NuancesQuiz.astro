---
---

<div class="quiz-card">
  <div class="quiz-header">
    <span class="badge">Quiz Écoute</span>
    <h4>Devine la suite des 3 Nuances !</h4>
  </div>

  <p class="quiz-instruction">
    Écoute l'enchaînement des 3 extraits musicaux et indique la nuance correspondant à chaque extrait.
  </p>

  <!-- Lecteur global et individuel -->
  <div class="playback-box">
    <button id="btnPlayAll" class="btn-play-all">▶ Écouter les 3 extraits à la suite</button>
    <div class="sub-players">
      <button id="btnPlay1" class="btn-sub">🎵 Extrait 1</button>
      <button id="btnPlay2" class="btn-sub">🎵 Extrait 2</button>
      <button id="btnPlay3" class="btn-sub">🎵 Extrait 3</button>
    </div>
  </div>

  <!-- Formulaire de réponse pour l'élève -->
  <div class="answers-grid">
    <div class="answer-col">
      <label for="select1">Extrait 1 :</label>
      <select id="select1" class="quiz-select">
        <option value="">-- Choisis --</option>
        <option value="p">Piano</option>
        <option value="mf">Mezzo Forte</option>
        <option value="ff">Fortissimo</option>
      </select>
    </div>

    <div class="answer-col">
      <label for="select2">Extrait 2 :</label>
      <select id="select2" class="quiz-select">
        <option value="">-- Choisis --</option>
        <option value="p">Piano</option>
        <option value="mf">Mezzo Forte</option>
        <option value="ff">Fortissimo</option>
      </select>
    </div>

    <div class="answer-col">
      <label for="select3">Extrait 3 :</label>
      <select id="select3" class="quiz-select">
        <option value="">-- Choisis --</option>
        <option value="p">Piano</option>
        <option value="mf">Mezzo Forte</option>
        <option value="ff">Fortissimo</option>
      </select>
    </div>
  </div>

  <!-- Validation & Feedback -->
  <div class="action-box">
    <button id="btnVerify" class="btn-verify">Vérifier mes réponses</button>
    <button id="btnNewGame" class="btn-secondary">🔄 Nouveau tirage</button>
  </div>

  <div id="feedback" class="feedback-msg hidden"></div>
</div>

<script>
  // Nuances retenues avec des volumes (gains) bien tranchés pour éviter l'ambiguïté
  const NUANCE_OPTIONS = [
    { code: 'p', label: 'Piano (Doux)', gain: 0.08 },
    { code: 'mf', label: 'Mezzo Forte (Moyennement fort)', gain: 0.38 },
    { code: 'ff', label: 'Fortissimo (Très fort)', gain: 0.90 }
  ];

  const PENTATONIC = [261.63, 293.66, 329.63, 392.00, 440.00, 523.25];

  let currentSequence: typeof NUANCE_OPTIONS = [];
  let audioCtx: AudioContext | null = null;
  let masterGain: GainNode | null = null;

  const btnPlayAll = document.getElementById('btnPlayAll') as HTMLButtonElement;
  const btnPlay1 = document.getElementById('btnPlay1') as HTMLButtonElement;
  const btnPlay2 = document.getElementById('btnPlay2') as HTMLButtonElement;
  const btnPlay3 = document.getElementById('btnPlay3') as HTMLButtonElement;
  const btnVerify = document.getElementById('btnVerify') as HTMLButtonElement;
  const btnNewGame = document.getElementById('btnNewGame') as HTMLButtonElement;

  const select1 = document.getElementById('select1') as HTMLSelectElement;
  const select2 = document.getElementById('select2') as HTMLSelectElement;
  const select3 = document.getElementById('select3') as HTMLSelectElement;
  const feedback = document.getElementById('feedback')!;

  function initAudio() {
    if (!audioCtx) {
      audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      masterGain = audioCtx.createGain();
      masterGain.connect(audioCtx.destination);
    }
    if (audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
  }

  // Génère un tirage aléatoire des 3 nuances (mélangées)
  function generateNewSequence() {
    // On prend les 3 nuances distinctes et on les mélange
    currentSequence = [...NUANCE_OPTIONS].sort(() => Math.random() - 0.5);
    
    // Réinitialiser le formulaire
    select1.value = '';
    select2.value = '';
    select3.value = '';
    select1.className = 'quiz-select';
    select2.className = 'quiz-select';
    select3.className = 'quiz-select';
    
    feedback.className = 'feedback-msg hidden';
    feedback.textContent = '';
  }

  // Joue un extrait donné (index 0, 1 ou 2) avec un petit motif de 4 notes
  function playExcerpt(index: number, onComplete?: () => void) {
    initAudio();
    if (!audioCtx || !masterGain) return;

    const nuance = currentSequence[index];
    const now = audioCtx.currentTime;

    // Ajuster le volume global de cet extrait
    masterGain.gain.setValueAtTime(nuance.gain, now);

    // Jouer 4 notes rapprochées
    for (let i = 0; i < 4; i++) {
      const noteTime = now + (i * 0.22);
      const freq = PENTATONIC[(i * 2 + index) % PENTATONIC.length];

      const osc = audioCtx.createOscillator();
      const noteGain = audioCtx.createGain();

      osc.type = 'triangle';
      osc.frequency.setValueAtTime(freq, noteTime);

      noteGain.gain.setValueAtTime(0, noteTime);
      noteGain.gain.linearRampToValueAtTime(0.8, noteTime + 0.03);
      noteGain.gain.exponentialRampToValueAtTime(0.001, noteTime + 0.2);

      osc.connect(noteGain);
      noteGain.connect(masterGain);

      osc.start(noteTime);
      osc.stop(noteTime + 0.22);
    }

    if (onComplete) {
      setTimeout(onComplete, 1100); // Durée totale de l'extrait + pause
    }
  }

  // Joue la séquence complète des 3 extraits
  function playFullSequence() {
    btnPlayAll.disabled = true;
    btnPlayAll.textContent = '🔊 Écoute en cours...';

    playExcerpt(0, () => {
      playExcerpt(1, () => {
        playExcerpt(2, () => {
          btnPlayAll.disabled = false;
          btnPlayAll.textContent = '▶ Écouter les 3 extraits à la suite';
        });
      });
    });
  }

  // Vérification des réponses de l'élève
  function verifyAnswers() {
    const userAnswers = [select1.value, select2.value, select3.value];
    
    if (userAnswers.includes('')) {
      feedback.textContent = '⚠️ Merci de choisir une nuance pour les 3 extraits avant de vérifier !';
      feedback.className = 'feedback-msg warning';
      return;
    }

    let correctCount = 0;
    const selects = [select1, select2, select3];

    selects.forEach((sel, idx) => {
      if (sel.value === currentSequence[idx].code) {
        correctCount++;
        sel.className = 'quiz-select correct';
      } else {
        sel.className = 'quiz-select incorrect';
      }
    });

    if (correctCount === 3) {
      feedback.textContent = '🎉 Bravo ! Tu as identifié parfaitement la suite des 3 nuances !';
      feedback.className = 'feedback-msg success';
    } else {
      feedback.textContent = `💡 Tu as ${correctCount} bonne(s) réponse(s) sur 3. Réécoute les extraits en rouge et réessaie !`;
      feedback.className = 'feedback-msg error';
    }
  }

  // Événements
  btnPlayAll.addEventListener('click', playFullSequence);
  btnPlay1.addEventListener('click', () => playExcerpt(0));
  btnPlay2.addEventListener('click', () => playExcerpt(1));
  btnPlay3.addEventListener('click', () => playExcerpt(2));

  btnVerify.addEventListener('click', verifyAnswers);
  btnNewGame.addEventListener('click', generateNewSequence);

  // Initialisation du premier tirage
  generateNewSequence();
</script>

<style>
  .quiz-card {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .quiz-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .badge {
    background: #059669;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .quiz-header h4 {
    margin: 0;
    color: #f1f5f9;
    font-size: 1.1rem;
  }

  .quiz-instruction {
    margin: 0;
    color: #94a3b8;
    font-size: 0.95rem;
  }

  .playback-box {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: #1e293b;
    padding: 1rem;
    border-radius: 8px;
    border: 1px solid #334155;
  }

  .btn-play-all {
    background: #0284c7;
    color: #ffffff;
    border: none;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-play-all:hover:not(:disabled) {
    background: #0369a1;
  }

  .btn-play-all:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .sub-players {
    display: flex;
    gap: 0.5rem;
  }

  .btn-sub {
    flex: 1;
    background: #334155;
    color: #f1f5f9;
    border: none;
    padding: 0.5rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-sub:hover {
    background: #475569;
  }

  .answers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .answer-col {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .answer-col label {
    font-size: 0.9rem;
    font-weight: 600;
    color: #cbd5e1;
  }

  .quiz-select {
    background: #1e293b;
    color: #f8fafc;
    border: 1px solid #475569;
    padding: 0.6rem;
    border-radius: 6px;
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s;
  }

  .quiz-select.correct {
    border-color: #10b981;
    background: #064e3b;
  }

  .quiz-select.incorrect {
    border-color: #f43f5e;
    background: #881337;
  }

  .action-box {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn-verify {
    background: #10b981;
    color: #ffffff;
    border: none;
    padding: 0.65rem 1.25rem;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .btn-verify:hover {
    background: #059669;
  }

  .btn-secondary {
    background: #334155;
    color: #f1f5f9;
    border: none;
    padding: 0.65rem 1rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .btn-secondary:hover {
    background: #475569;
  }

  .feedback-msg {
    padding: 0.75rem 1rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .feedback-msg.hidden {
    display: none;
  }

  .feedback-msg.warning {
    background: #78350f;
    color: #fde68a;
  }

  .feedback-msg.success {
    background: #064e3b;
    color: #a7f3d0;
  }

  .feedback-msg.error {
    background: #881337;
    color: #fecdd3;
  }
</style>